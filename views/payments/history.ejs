<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', {
  icon: 'bi-receipt',
  heading: 'Payments and invoices',
  sub: 'Everything you have paid for, and the invoice for each.'
}) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <% if (!payments.length) { %>
    <div class="glass-card">
      <div class="card-body text-center py-5">
        <span class="icon-tile icon-navy mb-3"><i class="bi bi-receipt"></i></span>
        <h2 class="h5">Nothing here yet</h2>
        <p class="text-muted-2 mb-3">You have not paid for anything on the Hub.</p>
        <a class="btn btn-outline-primary" href="/payments">See what is for sale</a>
      </div>
    </div>
  <% } else { %>
    <div class="glass-card">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th scope="col">Date</th>
              <th scope="col">What for</th>
              <th scope="col" class="text-end">Amount</th>
              <th scope="col">Status</th>
              <th scope="col" class="text-end">Invoice</th>
            </tr>
          </thead>
          <tbody>
            <% payments.forEach(function (p) { %>
              <tr>
                <td class="small text-muted-2"><%= new Date(p.created_at).toLocaleDateString('en-GB') %></td>
                <td>
                  <div><%= p.description %></div>
                  <code class="small text-muted-2"><%= p.reference %></code>
                </td>
                <td class="text-end fw-semibold"><%= formatMinor(p.amount_minor, p.currency) %></td>
                <td>
                  <%
                    /* Colour is never the only signal: the status word is in the pill. */
                    const tone = p.status === 'paid' ? 'ok'
                      : p.status === 'pending' ? 'warn'
                      : p.status === 'refunded' ? 'cloud' : 'muted';
                  %>
                  <span class="badge-hub <%= tone %>"><%= p.status %></span>
                  <% if (p.needs_refund) { %>
                    <span class="badge-hub warn" title="We could not fulfil this and are refunding it.">refund due</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <% if (p.invoice_id) { %>
                    <a class="btn btn-sm btn-outline-primary" href="/payments/invoices/<%= p.invoice_id %>"><%= p.invoice_number %></a>
                  <% } else { %>
                    <span class="small text-muted-2">—</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <%- include('../partials/pagination') %>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
