<%- include('../partials/layout-start') %>

<section class="glass-section py-5">
<div class="container">
  <div class="invoice-sheet">
    <div class="glass-card">
      <div class="card-body text-center">
        <% if (paid) { %>
          <span class="icon-tile icon-success mb-3"><i class="bi bi-check-lg"></i></span>
          <h1 class="h3">Payment received</h1>
          <p class="text-muted-2"><%= payment.description %></p>
          <p class="invoice-total"><%= formatMinor(payment.amount_minor, payment.currency) %></p>
          <p class="small text-muted-2">Reference <code><%= payment.reference %></code></p>
          <a class="btn btn-primary" href="/payments/history">Payments and invoices</a>
        <% } else { %>
          <span class="icon-tile icon-info mb-3"><i class="bi bi-hourglass-split"></i></span>
          <h1 class="h3">Payment pending</h1>
          <p class="text-muted-2">
            Your bank has not confirmed this payment yet. Nothing further is needed from you —
            it will appear in your history as soon as it settles.
          </p>
          <p class="small text-muted-2">Reference <code><%= payment.reference %></code></p>
          <a class="btn btn-outline-primary" href="/payments/history">Payments and invoices</a>
        <% } %>
      </div>
    </div>
  </div>
</div>
</section>

<%- include('../partials/layout-end') %>
