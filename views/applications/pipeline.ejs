<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { icon: 'bi-people', heading: 'Applicants', sub: job.title }) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumb mb-0 small">
        <li class="breadcrumb-item"><a href="/applications">Candidate pipeline</a></li>
        <li class="breadcrumb-item active" aria-current="page"><%= job.title %></li>
      </ol>
    </nav>
    <a class="btn btn-outline-primary btn-sm" href="/jobs/<%= job.slug %>">View the job</a>
  </div>

  <%#
    The same controls as the cross-job pipeline, from the same partial, over the same
    filter builder. The stage strip here used to be eight status names typed into the
    template — a second copy of a vocabulary the schema owns, which is how a stage ends up
    in a filter the route behind it rejects.
  -%>
  <%- include('../partials/pipeline-filters', {
    action: '/applications/job/' + job.slug,
    filters,
    counts,
    statuses,
    total
  }) %>

  <% if (applications.length === 0) { %>
    <div class="empty-state glass-card"><i class="bi bi-people"></i>No applications<%= filters.status || filters.q || filters.reached ? ' match these filters' : ' yet' %>.</div>
  <% } else { %>
    <% applications.forEach(function (a) { %>
      <%- include('../partials/applicant-card', { a }) %>
    <% }); %>
    <%- include('../partials/pagination') %>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
