<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', {
  icon: 'bi-funnel',
  heading: 'Candidate pipeline',
  sub: 'Everybody who has applied to any of your roles'
}) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <%#
      One route, two layouts. The board is `?view=board` on this same URL rather than a
      route of its own, so both read the same rows through the same filter builder and the
      board can never show somebody the list is hiding.
    -%>
    <div class="btn-group" role="group" aria-label="Layout">
      <a class="btn btn-sm <%= board ? 'btn-outline-secondary' : 'btn-primary' %>"
         href="/applications?<%= new URLSearchParams(Object.assign({}, query, { view: '' })).toString() %>">
        <i class="bi bi-list-ul"></i> List
      </a>
      <a class="btn btn-sm <%= board ? 'btn-primary' : 'btn-outline-secondary' %>"
         href="/applications?<%= new URLSearchParams(Object.assign({}, query, { view: 'board' })).toString() %>">
        <i class="bi bi-kanban"></i> Board
      </a>
    </div>
    <div class="d-flex gap-2">
      <a class="btn btn-outline-primary btn-sm" href="/dashboard/jobs"><i class="bi bi-briefcase"></i> Your roles</a>
      <a class="btn btn-outline-primary btn-sm" href="/jobs/new"><i class="bi bi-plus-square"></i> Post a role</a>
    </div>
  </div>

  <%- include('../partials/pipeline-filters', {
    action: '/applications',
    filters,
    counts,
    statuses,
    total,
    boardHref: true,
    board
  }) %>

  <% if (!hasOpenRole && total === 0) { %>
    <%#
      Two different empty pages, because they need two different things done. No advert at
      all means there is nothing for anybody to apply to; an advert with no applicants yet
      is a waiting room. Telling the first person to "wait for applications" is telling them
      to wait for something that cannot arrive.
    -%>
    <div class="empty-state glass-card">
      <i class="bi bi-briefcase"></i>
      You have no open role, so there is nothing for anybody to apply to yet.
      <a class="btn btn-primary btn-sm mt-3 d-inline-block" href="/jobs/new">Post your first role</a>
    </div>
  <% } else if (applications.length === 0) { %>
    <div class="empty-state glass-card">
      <i class="bi bi-people"></i>
      No candidate matches these filters.
    </div>
  <% } else if (board) { %>
    <% if (total >= boardLimit) { %>
      <div class="alert alert-info">
        The board shows the first <%= boardLimit %> candidates. A column is only useful whole,
        so the rest are in the <a href="/applications">list</a>, which filters and pages.
      </div>
    <% } %>
    <div class="pipeline-board">
      <% columns.forEach(function (col) { %>
        <% const cards = applications.filter(function (a) { return a.status === col; }); %>
        <section class="pipeline-column" aria-labelledby="col-<%= col %>">
          <h2 class="h6 pipeline-column-head" id="col-<%= col %>">
            <%= col %> <span class="badge-hub"><%= cards.length %></span>
          </h2>
          <% if (cards.length === 0) { %>
            <p class="small text-muted-2">Nobody here.</p>
          <% } %>
          <% cards.forEach(function (a) { %>
            <article class="glass-card mb-2">
              <div class="card-body p-3">
                <h3 class="h6 mb-1">
                  <a href="/applications/<%= a.id %>"><%= a.consultant_name %></a>
                </h3>
                <p class="small text-muted-2 mb-2"><%= a.job_title %></p>
                <%#
                  The moves this actor may actually make, asked of the state machine rather
                  than guessed at. That is also why this board has no drag-and-drop: a drop
                  target offers every column, including the ones `Application.TRANSITIONS`
                  refuses, so the gesture would promise moves the server then rejects — and
                  a drag is a gesture the keyboard cannot make at all.
                -%>
                <div class="d-flex flex-wrap gap-1">
                  <% transitionsFor(a.status).forEach(function (to) { %>
                    <form method="post" action="/applications/<%= a.id %>/transition" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="to_status" value="<%= to %>">
                      <button class="btn btn-sm btn-outline-secondary" type="submit">
                        <%= to %>
                      </button>
                    </form>
                  <% }); %>
                </div>
              </div>
            </article>
          <% }); %>
        </section>
      <% }); %>
    </div>
  <% } else { %>
    <% applications.forEach(function (a) { %>
      <%- include('../partials/applicant-card', { a, showJob: true }) %>
    <% }); %>
    <%- include('../partials/pagination') %>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
