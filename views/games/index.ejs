<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', {
  icon: 'bi-controller',
  heading: 'SAP games',
  sub: 'A new set every day, the same for everybody. Answers are marked on the server.'
}) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="row g-3">
        <div class="col-md-6"><a class="glass-card h-100 d-block text-decoration-none game-tile" href="/challenges"><div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <i class="bi bi-trophy fs-3"></i>
            <% if (challengeToday) { %><span class="badge-hub">Played · <%= challengeToday.score %>/<%= challengeToday.total %></span><% } %>
          </div>
          <h2 class="h6 mb-1">Daily challenge</h2>
          <p class="small text-muted-2 mb-0">Five questions across SAP's product lines.</p>
        </div></a></div>

        <% gamesList.forEach(function (g) { const done = played[g.key]; %>
          <div class="col-md-6"><a class="glass-card h-100 d-block text-decoration-none game-tile" href="/games/<%= g.key %>"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <i class="bi <%= g.icon %> fs-3"></i>
              <% if (done) { %><span class="badge-hub">Played · <%= done.score %>/<%= done.total %></span>
              <% } else if (!g.scored) { %><span class="badge-hub muted">Practice</span><% } %>
            </div>
            <h2 class="h6 mb-1"><%= g.title %></h2>
            <p class="small text-muted-2 mb-0"><%= g.blurb %></p>
          </div></a></div>
        <% }); %>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="glass-card mb-3"><div class="card-body">
        <h2 class="h6 mb-3">Today, all games</h2>
        <% if (!board.length) { %>
          <p class="small text-muted-2 mb-0">Nobody has played a scored game yet today.</p>
        <% } else { %>
          <ol class="list-unstyled small mb-0">
            <% board.forEach(function (row, i) { %>
              <li class="d-flex justify-content-between">
                <span class="text-truncate me-2"><%= i + 1 %>. <%= row.name %></span>
                <span class="text-nowrap"><%= row.score %>/<%= row.total %> · <%= row.games %> game<%= row.games === 1 ? '' : 's' %></span>
              </li>
            <% }); %>
          </ol>
        <% } %>
      </div></div>

      <div class="glass-card"><div class="card-body">
        <h2 class="h6 mb-2">How it works</h2>
        <p class="small text-muted-2 mb-2">
          Each scored game is played once a day. A perfect set is worth 2 points and at least
          half right is worth 1 — enough to nudge your standing, never to build it.
        </p>
        <p class="small text-muted-2 mb-0">
          Flashcards and typing are practice: nothing is stored and nothing is ranked. A typing
          speed is timed by your own browser, so it can never be checked — which is why it is
          not on a board.
        </p>
      </div></div>
    </div>
  </div>
</div>
</section>

<%- include('../partials/layout-end') %>
