<%- include('../partials/layout-start') %>

<%#
  /games/challenges — every game on one page, as on dynamicshub.net's Daily Challenges
  (owner, 2026-10-22). The daily challenge leads, the streak follows, then the games in the
  reference's order, then Today's Rankings; Resources underneath.

  Each card has its own colour (`.arena-tone-N`) so nine cards read as nine things rather
  than one tile repeated. Everything that moves stops under prefers-reduced-motion.
%>
<header class="arena-hero">
  <div class="arena-codes" aria-hidden="true">
    <%# Positions are spread deterministically (golden-ratio steps), so a reload does not rearrange the sky. %>
    <% moduleCodes.forEach(function (code, i) { const x = Math.round(((i * 0.618) % 1) * 92 + 2); const y = Math.round(((i * 0.382 + 0.1) % 1) * 80 + 6); %><span class="arena-code" style="--i: <%= i %>; left: <%= x %>%; top: <%= y %>%"><%= code %></span><% }); %>
  </div>
  <div class="container position-relative">
    <div class="row align-items-center g-4">
      <div class="col-lg-8">
        <span class="arena-eyebrow"><i class="bi bi-calendar3 me-1" aria-hidden="true"></i>New challenges every day · <%= date %></span>
        <h1 class="arena-title"><i class="bi bi-controller me-2" aria-hidden="true"></i>Daily Challenges</h1>
        <p class="arena-lead mb-0">Test your SAP knowledge — transaction codes, ABAP, S/4HANA projects. The same set for everybody, marked on the server, a new one at midnight UTC.</p>
      </div>
      <div class="col-lg-4">
        <% if (currentUser) { %>
          <% const pct = Math.round((playedCount / scoredCount) * 100); %>
          <div class="arena-progress">
            <svg viewBox="0 0 120 120" class="arena-ring" role="img" aria-label="<%= playedCount %> of <%= scoredCount %> scored challenges played today">
              <circle cx="60" cy="60" r="52" class="arena-ring-track" pathLength="100"></circle>
              <% if (pct > 0) { %><circle cx="60" cy="60" r="52" class="arena-ring-fill" pathLength="100" style="--pct: <%= pct %>"></circle><% } %>
            </svg>
            <div class="arena-progress-text">
              <strong><%= playedCount %>/<%= scoredCount %></strong>
              <span>played today</span>
              <% if (streak && streak.days) { %><span class="arena-streak"><i class="bi bi-fire" aria-hidden="true"></i> <%= streak.days %>-day streak</span><% } %>
            </div>
          </div>
        <% } else { %>
          <div class="arena-progress arena-progress-guest">
            <p class="mb-2">Scored games pay points to your community standing.</p>
            <a class="btn btn-light btn-sm rounded-pill px-3" href="/auth/login?redirect=/games/challenges"><i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Sign in to play</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</header>

<section class="glass-section pb-5 pt-4">
<div class="container">
  <%- include('../partials/flash') %>

  <div class="row g-4 arena-grid">

    <%# --- The daily challenge, first, as the reference's quiz is. %>
    <div class="col-lg-4 col-md-6">
      <article class="arena-card arena-tone-1 <%= challengeToday ? 'is-played' : '' %>">
        <div class="arena-icon"><i class="bi bi-patch-question" aria-hidden="true"></i></div>
        <h2 class="arena-name">SAP Quiz</h2>
        <p class="arena-blurb">Today's <%= challengeQuestions %> questions across SAP's product lines.</p>
        <p class="arena-meta"><span><i class="bi bi-list-ol" aria-hidden="true"></i> <%= challengeQuestions %> questions</span><span><i class="bi bi-star" aria-hidden="true"></i> Scored</span></p>
        <% if (challengeToday) { %>
          <a class="arena-cta arena-cta-done" href="/challenges"><i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Played · <%= challengeToday.score %>/<%= challengeToday.total %></a>
        <% } else { %>
          <a class="arena-cta" href="/challenges"><i class="bi bi-play-fill me-1" aria-hidden="true"></i><%= currentUser ? 'Start quiz' : 'Sign in to play' %></a>
        <% } %>
      </article>
    </div>

    <%# --- The streak. Derived from the challenge attempts (models/Challenge.js), never a check-in button. %>
    <div class="col-lg-4 col-md-6">
      <article class="arena-card arena-tone-2">
        <div class="arena-icon arena-flame"><i class="bi bi-fire" aria-hidden="true"></i></div>
        <h2 class="arena-name">Daily Streak</h2>
        <% if (currentUser) { %>
          <p class="arena-streak-count"><%= streak ? streak.days : 0 %> <span>day<%= streak && streak.days === 1 ? '' : 's' %></span></p>
          <p class="arena-blurb">
            <% if (streak && streak.playedToday) { %>Today counts. Come back tomorrow to keep it going.
            <% } else if (streak && streak.days) { %>Play today's quiz to keep it alive.
            <% } else { %>Play the quiz on consecutive days to build one.<% } %>
          </p>
          <div class="arena-week" aria-hidden="true">
            <% for (let d = 0; d < 7; d++) { %><span class="<%= streak && d < Math.min(streak.days, 7) ? 'on' : '' %>"></span><% } %>
          </div>
        <% } else { %>
          <p class="arena-blurb">Play the daily quiz on consecutive days and the run is counted here.</p>
        <% } %>
      </article>
    </div>

    <%# --- Every game, in the reference's order. %>
    <% gamesList.forEach(function (g, i) { const done = played[g.key]; const needsAccount = g.scored && !currentUser; %>
    <div class="col-lg-4 col-md-6">
      <article class="arena-card arena-tone-<%= (i % 7) + 3 %> <%= done ? 'is-played' : '' %>">
        <div class="arena-icon"><i class="bi <%= g.icon %>" aria-hidden="true"></i></div>
        <h2 class="arena-name"><%= g.title %></h2>
        <p class="arena-blurb"><%= g.blurb %></p>
        <p class="arena-meta">
          <span><i class="bi bi-list-ol" aria-hidden="true"></i> <%= g.perDay %> a day</span>
          <% if (g.scored) { %><span><i class="bi bi-star" aria-hidden="true"></i> Scored</span><% } else { %><span><i class="bi bi-infinity" aria-hidden="true"></i> Practice</span><% } %>
        </p>
        <% if (done) { %>
          <a class="arena-cta arena-cta-done" href="/games/<%= g.key %>"><i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Played · <%= done.score %>/<%= done.total %></a>
        <% } else { %>
          <a class="arena-cta" href="/games/<%= g.key %>"><i class="bi bi-play-fill me-1" aria-hidden="true"></i><%= needsAccount ? 'Sign in to play' : 'Play' %></a>
        <% } %>
      </article>
    </div>
    <% }); %>

  </div>

  <div class="row g-4 mt-0 arena-grid">
    <%# --- Today's Rankings: the quiz and every scored game, summed per person. %>
    <div class="col-lg-4 col-md-6">
      <article class="arena-card arena-board">
        <div class="arena-icon arena-icon-gold"><i class="bi bi-trophy-fill" aria-hidden="true"></i></div>
        <h2 class="arena-name">Today's Rankings</h2>
        <p class="arena-blurb">The quiz and every scored game, summed per person. Resets at midnight UTC.</p>
        <% if (!rankings.length) { %>
          <p class="small text-muted-2 mb-0">Nobody has played yet today — the top spot is open.</p>
        <% } else { %>
          <ol class="arena-ranks">
            <% rankings.forEach(function (row, i) { %>
              <li class="<%= i < 3 ? 'medal-' + (i + 1) : '' %>">
                <span class="arena-rank"><%= i < 3 ? '' : i + 1 %><% if (i < 3) { %><i class="bi bi-award-fill" aria-hidden="true"></i><span class="visually-hidden"><%= i + 1 %></span><% } %></span>
                <span class="arena-who text-truncate"><%= row.name %></span>
                <span class="arena-score"><%= row.score %>/<%= row.total %></span>
              </li>
            <% }); %>
          </ol>
        <% } %>
        <a class="small d-inline-block mt-2" href="/challenges/leaderboard">Quiz leaderboard <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </article>
    </div>
    <div class="col-lg-8 col-md-6">
      <%# --- Resources, as on the reference's page. %>
      <div class="glass-card h-100"><div class="card-body p-4">
    <h2 class="h6 mb-3"><i class="bi bi-info-circle me-2" aria-hidden="true"></i>Resources</h2>
    <div class="row g-2 small arena-resources">
      <div class="col-sm-6"><a class="arena-tone-3" href="/community"><i class="bi bi-chat-square-text me-2" aria-hidden="true"></i>Ask the community</a></div>
      <div class="col-sm-6"><a class="arena-tone-7" href="/rates"><i class="bi bi-cash-stack me-2" aria-hidden="true"></i>Rate &amp; Salary Index</a></div>
      <div class="col-sm-6"><a class="arena-tone-4" href="/faq"><i class="bi bi-question-circle me-2" aria-hidden="true"></i>FAQ</a></div>
      <div class="col-sm-6"><a class="arena-tone-5" href="/contact"><i class="bi bi-envelope me-2" aria-hidden="true"></i>Contact support</a></div>
    </div>
    <h2 class="h6 mt-4 mb-2"><i class="bi bi-stars me-2" aria-hidden="true"></i>How points work</h2>
    <p class="small text-muted-2 mb-0">
      Each scored game is played once a day: a perfect set is worth 2 points and at least half right 1 — enough to nudge
      your standing, never to build it. Flashcards and typing are practice; a typing speed is timed by your own browser,
      so it is never ranked.
    </p>
  </div></div>
    </div>
  </div>
</div>
</section>

<%- include('../partials/layout-end') %>
