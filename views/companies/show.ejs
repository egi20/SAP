<%- include('../partials/layout-start') %>

<section class="glass-section pb-5">
<div class="container py-4">
  <%- include('../partials/flash') %>

  <div class="glass-card mb-4">
    <div class="card-body d-flex gap-3">
      <img class="logo-tile" style="width:72px;height:72px" src="<%= company.logo || '/images/logo-placeholder.svg' %>" alt="">
      <div>
        <h1 class="h3 mb-1"><%= company.company_name %></h1>
        <p class="text-muted-2 mb-2"><%= company.tagline || '' %></p>
        <div class="d-flex flex-wrap gap-1">
          <span class="badge-hub"><%= company.company_type.replace('_', ' ') %></span>
          <% if (company.industry) { %><span class="badge-hub"><%= company.industry %></span><% } %>
          <% if (company.company_size) { %><span class="badge-hub"><%= company.company_size %> people</span><% } %>
          <% if (company.country) { %><span class="badge-hub"><%= [company.city, company.country].filter(Boolean).join(', ') %></span><% } %>
        </div>
        <% if (company.website) { %>
          <p class="mt-2 mb-0"><a href="<%= company.website %>" rel="nofollow noopener noreferrer" target="_blank">Website</a></p>
        <% } %>
      </div>
    </div>
  </div>

  <% if (company.about) { %>
    <div class="glass-card mb-4"><div class="card-body">
      <h2 class="h6">About</h2>
      <div><%- sanitizeRichText(company.about) %></div>
    </div></div>
  <% } %>

  <h2 class="h5 mb-3">Open roles (<%= jobs.length %>)</h2>
  <% if (jobs.length === 0) { %>
    <div class="empty-state glass-card"><i class="bi bi-briefcase"></i>No open roles right now.</div>
  <% } else { %>
    <% jobs.forEach(function (job) { %><%- include('../partials/job-card', { job: job }) %><% }); %>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
