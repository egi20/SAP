<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { icon: 'bi-building', heading: 'Companies', sub: 'Partners, ISVs and end customers hiring on the Hub.' }) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <form class="glass-card p-3 mb-4" method="get" action="/companies">
    <div class="row g-2 align-items-end">
      <div class="col-md-5">
        <label class="form-label" for="co-q">Search</label>
        <input class="form-control" id="co-q" name="q" value="<%= filters.q %>" placeholder="Company name">
      </div>
      <div class="col-md-3">
        <label class="form-label" for="co-type">Type</label>
        <select class="form-select" id="co-type" name="company_type">
          <option value="">Any</option>
          <option value="consulting_partner" <%= filters.company_type === 'consulting_partner' ? 'selected' : '' %>>Consulting partner</option>
          <option value="end_customer" <%= filters.company_type === 'end_customer' ? 'selected' : '' %>>End customer</option>
          <option value="isv" <%= filters.company_type === 'isv' ? 'selected' : '' %>>ISV</option>
          <option value="staffing" <%= filters.company_type === 'staffing' ? 'selected' : '' %>>Staffing</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="co-country">Country</label>
        <select class="form-select" id="co-country" name="country">
          <option value="">Any</option>
          <% countries.forEach(function (c) { %>
            <option value="<%= c.code %>" <%= filters.country === c.code ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="col-md-1"><button class="btn btn-primary w-100" type="submit">Go</button></div>
    </div>
  </form>

  <% if (companies.length === 0) { %>
    <div class="empty-state glass-card"><i class="bi bi-building"></i>No companies match.</div>
  <% } else { %>
    <div class="row g-3">
      <% companies.forEach(function (co) { %>
        <div class="col-md-6 col-lg-4">
          <a class="glass-card d-block h-100 text-reset" href="/companies/<%= co.slug %>">
            <div class="card-body">
              <div class="d-flex gap-3 align-items-center mb-2">
                <img class="logo-tile" src="<%= co.logo || '/images/logo-placeholder.svg' %>" alt="" loading="lazy">
                <div class="min-w-0">
                  <h2 class="h6 mb-0 text-truncate"><%= co.company_name %></h2>
                  <p class="small text-muted-2 mb-0 text-truncate"><%= co.tagline || co.industry || '' %></p>
                </div>
              </div>
              <div class="d-flex flex-wrap gap-1">
                <span class="badge-hub"><%= co.company_type.replace('_', ' ') %></span>
                <% if (co.company_size) { %><span class="badge-hub"><%= co.company_size %></span><% } %>
                <% if (co.country) { %><span class="badge-hub"><%= countryName(co.country) %></span><% } %>
                <% if (co.open_jobs > 0) { %><span class="badge-hub ok"><%= co.open_jobs %> open</span><% } %>
              </div>
            </div>
          </a>
        </div>
      <% }); %>
    </div>
    <%- include('../partials/pagination') %>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
