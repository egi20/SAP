<% const wa = (typeof webAnalytics !== 'undefined' && webAnalytics) || {}; %>
<footer class="footer-hub">
  <div class="container">
    <%#
      The footer is where somebody looks once the page they are on has not answered them,
      so it is organised the same way the navigation is — by who you are and what you came
      for — rather than as one list of everything. Six columns, and every link in them
      points at a route that exists: a test walks this file and the navigation and opens
      each one. The reference's Budget Planner is the one item not here, because SAP Hub
      has no such page and a link to one that does not exist is worse than none.
    %>
    <div class="row g-4 mb-4">
      <div class="col-xl-3">
        <%# The SH tile and the two-colour wordmark, laid out as dynamicshub.net's footer lays out its own. -%>
        <a class="footer-brand mb-3" href="/" aria-label="<%= appName %> home">
          <img src="/images/favicon-192.png" width="48" height="48" alt="">
          <span class="footer-wordmark"><span class="brand-accent">SAP</span> Hub</span>
        </a>
        <p class="footer-blurb mb-3">
          Jobs, talent and contributed day-rate benchmarks for the SAP ecosystem.
        </p>
        <ul class="list-unstyled d-flex gap-3 mb-0 footer-social">
          <% socialLinks.forEach(function (link) { %>
            <li>
              <a href="<%= link.href %>" aria-label="<%= link.label %>"
                 <%= link.key === 'email' ? '' : 'rel="noopener" target="_blank"' %>>
                <i class="bi <%= link.icon %>" aria-hidden="true"></i>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>

      <%#
        The columns and their first items follow dynamicshub.net's footer, in its order and
        its Title Case, and the same labels as the navigation menus above — two names for one
        page, a menu saying "Find Jobs" and a footer saying "Find work", read as two pages.
        What SAP Hub has and the reference does not comes after the reference's own items.
      -%>
      <div class="col-6 col-md-4 col-xl">
        <h3>Consultant Hub</h3>
        <ul class="list-unstyled">
          <li><a href="/consultant-hub">Consultant Hub</a></li>
          <li><a href="/jobs">Find Jobs</a></li>
          <%# Same target as the menu's Build Profile: a visitor signs in and is brought back. -%>
          <li><a href="/profile/consultant">Build Profile</a></li>
          <li><a href="/cv-generator">CV Generator</a></li>
        </ul>
      </div>

      <div class="col-6 col-md-4 col-xl">
        <h3>Companies Hub</h3>
        <ul class="list-unstyled">
          <li><a href="/company-hub">Company Hub</a></li>
          <li><a href="/consultants">Browse Talent</a></li>
          <li><a href="/quotes/new">Get SOW Quote</a></li>
          <li><a href="/companies/staff-augmentation">Staff Augmentation</a></li>
          <li><a href="/companies/project-based">Project-Based</a></li>
          <li><a href="/companies/managed-services">Managed Services</a></li>
          <li><a href="/recruiters">Agencies</a></li>
        </ul>
      </div>

      <div class="col-6 col-md-4 col-xl">
        <h3>Services</h3>
        <ul class="list-unstyled">
          <li><a href="/tax">Tax Optimization</a></li>
          <li><a href="/rates">Rate &amp; Salary Index</a></li>
          <li><a href="/quotes/new">SOW Generator</a></li>
          <li><a href="/cv-generator">Document Generator</a></li>
          <li><a href="/dedupe">Dedupe</a></li>
          <%# Only once card payments are switched on: a link whose page says "not switched on yet" is a promise the site cannot keep. -%>
          <% if (typeof paymentsReady !== 'undefined' && paymentsReady) { %>
            <li><a href="/payments">Pricing</a></li>
          <% } %>
        </ul>
      </div>

      <div class="col-6 col-md-4 col-xl">
        <h3>Community</h3>
        <ul class="list-unstyled">
          <li><a href="/">Home Feed</a></li>
          <li><a href="/community">Forum</a></li>
          <li><a href="/community/articles">Articles</a></li>
          <li><a href="/community/new?kind=question">Ask a Question</a></li>
          <li><a href="/community/new?kind=article">Share an Article</a></li>
        </ul>
      </div>

      <div class="col-6 col-md-4 col-xl">
        <h3>Company</h3>
        <ul class="list-unstyled">
          <li><a href="/about">About Us</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/report-issue">Report Issue</a></li>
        </ul>
        <h3 class="mt-3">Legal</h3>
        <ul class="list-unstyled">
          <li><a href="/legal/privacy">Privacy Policy</a></li>
          <li><a href="/legal/terms">Terms of Service</a></li>
          <% if (wa.ga4Id) { %>
            <%#
              A button, not a link: it changes a setting in this browser and goes nowhere.
              public/js/analytics.js wires it; consent nobody can withdraw is not consent.
            %>
            <li><button type="button" class="btn btn-link p-0 footer-link-button" data-analytics-choices>Analytics choices</button></li>
          <% } %>
        </ul>
      </div>
    </div>

    <hr class="footer-rule">
    <div class="d-flex flex-wrap justify-content-between small gap-2">
      <span>&copy; <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.</span>
      <span>Not affiliated with SAP SE. SAP, S/4HANA, SuccessFactors, Ariba, Concur and Fieldglass are trademarks of SAP SE.</span>
    </div>
  </div>
</footer>

<%- include('social-rail') %>

<% if (assistantReady) { %><%- include('assistant') %><% } %>
<% if (typeof onboardingSteps !== 'undefined' && onboardingSteps && currentUser) { %><%- include('onboarding') %><% } %>

<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>"></script>
<% if (wa.ga4Id) { %><script src="/js/analytics.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>"></script><% } %>
<% if (wa.cloudflareToken && typeof measureVisit !== 'undefined' && measureVisit) { %>
<%# Cloudflare Web Analytics: no cookie, no identifier, so it needs no consent. Disclosed in the privacy policy. %>
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "<%= wa.cloudflareToken %>"}'></script>
<% } %>
<% if (typeof onboardingSteps !== 'undefined' && onboardingSteps && currentUser) { %><script src="/js/onboarding.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>"></script><% } %>
<% if (assistantReady) { %><script src="/js/assistant.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>"></script><% } %>
