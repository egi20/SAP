<%
  /*
   * A password input with a show/hide button.
   *
   * The button is rendered by the server but only WORKS with scripting, so it is created
   * by public/js/main.js and not written here: a control that does nothing when a script
   * fails to load is worse than no control, because the person has already decided to
   * trust what it shows them.
   *
   * `autocomplete` is passed in rather than guessed — a browser offering the current
   * password on a "new password" field is how somebody sets their old one again.
   */
  const fieldId = id;
  const fieldName = typeof name !== 'undefined' ? name : id;
  const fieldLabel = label;
  const auto = typeof autocomplete !== 'undefined' ? autocomplete : 'current-password';
  const hint = typeof help !== 'undefined' ? help : '';
  const isRequired = typeof required === 'undefined' ? true : required;
%>
<label class="form-label" for="<%= fieldId %>"><%= fieldLabel %></label>
<div class="password-field">
  <input class="form-control" id="<%= fieldId %>" name="<%= fieldName %>" type="password"
         autocomplete="<%= auto %>" <%= isRequired ? 'required' : '' %>>
</div>
<% if (hint) { %><p class="form-text"><%= hint %></p><% } %>
