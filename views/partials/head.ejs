<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' — ' + appName : appName %></title>
<meta name="description" content="<%= seo.description %>">

<%
/*
 * There was no favicon at all, so every tab showed the browser's blank page glyph.
 *
 * The icon is the SH tile the owner supplied (2026-10-13). It exists only as a raster, so
 * the tab gets PNGs rather than an SVG: a 32px one for tabs, a 192px one for high-density
 * screens, /favicon.ico for anything that asks for that path without reading this head,
 * and the 180px full-bleed PNG iOS uses for the home screen (iOS rounds the corners
 * itself and ignores SVG). Still nothing of SAP's: the footer says this site is not
 * affiliated with SAP SE, and SAP's mark in the tab would contradict it on every page.
 */
%>
<link rel="icon" href="/images/favicon-32.png" type="image/png" sizes="32x32">
<link rel="icon" href="/images/favicon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
<meta name="theme-color" content="#00265b">
<link rel="canonical" href="<%= seo.canonical %>">
<% if (!seo.indexable) { %><meta name="robots" content="noindex,follow"><% } %>
<meta property="og:title" content="<%= title || appName %>">
<meta property="og:description" content="<%= seo.description %>">
<meta property="og:url" content="<%= seo.canonical %>">
<meta property="og:type" content="website">
<meta property="og:image" content="<%= seo.ogImage %>">
<meta name="csrf-token" content="<%= csrfToken %>">
<% if (typeof webAnalytics !== 'undefined' && webAnalytics && webAnalytics.ga4Id) { %>
<%# Read by public/js/analytics.js, which loads gtag ONLY after the visitor allows it. %>
<meta name="ga4-id" content="<%= webAnalytics.ga4Id %>">
<% } %>
<link rel="stylesheet" href="/css/inter.css">
<link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
<link rel="stylesheet" href="/css/style.css">
<script>
  /* Before first paint: tells the stylesheet that scroll reveals are safe to hide.
     Without JavaScript this never runs and .animate-on-scroll content stays visible. */
  document.documentElement.classList.add('js-reveal');
</script>
