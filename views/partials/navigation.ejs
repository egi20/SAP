<a class="skip-link" href="#main">Skip to content</a>
<nav class="navbar navbar-expand-lg navbar-hub sticky-top" aria-label="Main">
  <div class="container">
    <a class="navbar-brand d-inline-flex align-items-center gap-2" href="/">
      <%# Decorative: the wordmark beside it already names the site, so a screen reader %>
      <%# announcing both would read it twice. %>
      <img src="/images/logo-mark.svg" alt="" width="28" height="28" class="brand-mark" aria-hidden="true">
      <span>SAP<span class="accent">Hub</span></span>
    </a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <%
        /*
         * Grouped into hubs rather than one flat row.
         *
         * A flat list grows until nothing in it is findable. Grouping by WHO the item is
         * for — someone looking for work, someone hiring — means a person only ever reads
         * the half that is theirs. The three hub menus carry the same items, in the same
         * order and with the same icons, as dynamicshub.net's: somebody who uses both sites
         * finds things where their hands already go. What only SAP Hub has (agencies, the
         * company directory, pricing, success stories) is in the footer, and what belongs
         * to an ACCOUNT rather than an audience (your roles, your estimates, your
         * applications) is in the user menu, under the role it belongs to.
         *
         * EVERY ITEM HERE POINTS AT A ROUTE THAT EXISTS, and a test walks both this file
         * and the footer to prove it. A menu that offers a 404 is worse than a menu that is
         * short: it is the first thing a visitor tries, and it teaches them that the
         * navigation is decoration. Where the reference has a page under its own path and
         * the Hub already has the same page under another, the item points at the Hub's —
         * a second URL for one page is two places for it to drift.
         */
        const path = currentPath;
        const startsWith = (p) => path === p || path.startsWith(p + '/');
        // An item is the current page when its path (without a query string) is.
        const here = (href) => path === href.split('?')[0];
        const itemClass = (href) => 'dropdown-item' + (here(href) ? ' active' : '');
        const itemCurrent = (href) => (here(href) ? 'aria-current="page"' : '');
        const isConsultantArea = startsWith('/jobs') || startsWith('/consultant-hub')
          || path === '/cv-generator' || path === '/dashboard/saved'
          || (currentUser && startsWith('/profile/consultant'));
        const isCompanyArea = path === '/consultants' || startsWith('/companies')
          || startsWith('/company-hub') || path === '/quotes/new';
        /*
         * Services is what the Hub DOES for you, as opposed to who it is for — the two
         * hubs above are audiences, this one is tools. The estimator is in both: it is how
         * a company prices a programme ("Get SOW Quote") and the tool that writes the
         * statement of work ("SOW Generator"), and the reference lists it twice for the
         * same reason.
         */
        const isServicesArea = startsWith('/rates') || path === '/tax' || path === '/dedupe'
          || path === '/quotes/new';
      %>

      <ul class="navbar-nav me-auto align-items-lg-center">
        <li class="nav-item">
          <a class="nav-link <%= path === '/' ? 'active' : '' %>" href="/"><i class="bi bi-house"></i> Home</a>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= startsWith('/community') ? 'active' : '' %>" href="#" role="button"
             data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
            <i class="bi bi-people"></i> Community
          </a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/community"><i class="bi bi-chat-square-text"></i> Questions and posts</a></li>
            <li><a class="dropdown-item" href="/community/articles"><i class="bi bi-file-earmark-text"></i> Articles</a></li>
            <li><a class="dropdown-item" href="/community?kind=question&amp;unanswered=1"><i class="bi bi-patch-question"></i> Unanswered questions</a></li>
            <li><a class="dropdown-item" href="/challenges"><i class="bi bi-lightning"></i> Daily challenge</a></li>
            <% if (currentUser) { %>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/community/new"><i class="bi bi-pencil"></i> Write a post</a></li>
              <li><a class="dropdown-item" href="/payments/history"><i class="bi bi-receipt"></i> Payments &amp; invoices</a></li>
            <% } %>
          </ul>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= isConsultantArea ? 'active' : '' %>" href="#" role="button"
             data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
            <i class="bi bi-person-badge"></i> Consultant Hub
          </a>
          <ul class="dropdown-menu">
            <li><a class="<%= itemClass('/consultant-hub') %>" <%- itemCurrent('/consultant-hub') %> href="/consultant-hub"><i class="bi bi-compass me-2"></i>Consultant Hub</a></li>
            <li><a class="<%= itemClass('/jobs') %>" <%- itemCurrent('/jobs') %> href="/jobs"><i class="bi bi-briefcase me-2"></i>Find Jobs</a></li>
            <li><a class="<%= itemClass('/dashboard/saved') %>" <%- itemCurrent('/dashboard/saved') %> href="/dashboard/saved"><i class="bi bi-bookmark-heart me-2"></i>Saved Jobs</a></li>
            <li><a class="<%= itemClass('/profile/consultant') %>" <%- itemCurrent('/profile/consultant') %> href="/profile/consultant"><i class="bi bi-person-badge me-2"></i>Build Profile</a></li>
            <li><a class="<%= itemClass('/cv-generator') %>" <%- itemCurrent('/cv-generator') %> href="/cv-generator"><i class="bi bi-file-earmark-richtext me-2"></i>CV Generator</a></li>
          </ul>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= isCompanyArea ? 'active' : '' %>" href="#" role="button"
             data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
            <i class="bi bi-building"></i> Companies Hub
          </a>
          <ul class="dropdown-menu">
            <li><a class="<%= itemClass('/company-hub') %>" <%- itemCurrent('/company-hub') %> href="/company-hub"><i class="bi bi-compass me-2"></i>Company Hub</a></li>
            <li><a class="<%= itemClass('/consultants') %>" <%- itemCurrent('/consultants') %> href="/consultants"><i class="bi bi-people me-2"></i>Browse Talent</a></li>
            <li><a class="<%= itemClass('/quotes/new') %>" <%- itemCurrent('/quotes/new') %> href="/quotes/new"><i class="bi bi-file-text me-2"></i>Get SOW Quote</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="<%= itemClass('/companies/staff-augmentation') %>" <%- itemCurrent('/companies/staff-augmentation') %> href="/companies/staff-augmentation"><i class="bi bi-people me-2"></i>Staff Augmentation</a></li>
            <li><a class="<%= itemClass('/companies/project-based') %>" <%- itemCurrent('/companies/project-based') %> href="/companies/project-based"><i class="bi bi-kanban me-2"></i>Project-Based</a></li>
            <li><a class="<%= itemClass('/companies/managed-services') %>" <%- itemCurrent('/companies/managed-services') %> href="/companies/managed-services"><i class="bi bi-gear me-2"></i>Managed Services</a></li>
          </ul>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= isServicesArea ? 'active' : '' %>" href="#" role="button"
             data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
            <i class="bi bi-tools"></i> Services
          </a>
          <ul class="dropdown-menu">
            <li><a class="<%= itemClass('/tax') %>" <%- itemCurrent('/tax') %> href="/tax"><i class="bi bi-calculator me-2"></i>Tax Optimization</a></li>
            <li><a class="<%= itemClass('/rates') %>" <%- itemCurrent('/rates') %> href="/rates"><i class="bi bi-cash-stack me-2"></i>Rate &amp; Salary Index</a></li>
            <%# Same page as "Get SOW Quote", so only one of the two is marked as current. %>
            <li><a class="dropdown-item" href="/quotes/new"><i class="bi bi-file-earmark-richtext me-2"></i>SOW Generator</a></li>
            <li><a class="dropdown-item" href="/cv-generator"><i class="bi bi-magic me-2"></i>Document Generator</a></li>
            <li><a class="<%= itemClass('/dedupe') %>" <%- itemCurrent('/dedupe') %> href="/dedupe"><i class="bi bi-layers me-2"></i>Dedupe</a></li>
          </ul>
        </li>

        <li class="nav-item">
          <a class="nav-link <%= startsWith('/about') ? 'active' : '' %>" href="/about">About</a>
        </li>
      </ul>

      <%#
        The search box, in the slot the stylesheet has had a `.nav-search` rule for since
        the design system landed and nothing to put in it. A plain GET form: it works with
        scripting off, the browser remembers what was typed, and the results page is the
        same URL somebody can bookmark or share.
      %>
      <form class="nav-search d-flex me-lg-3 my-2 my-lg-0" method="get" action="/search" role="search">
        <label class="visually-hidden" for="navSearch">Search the Hub</label>
        <input class="form-control form-control-sm" id="navSearch" name="q" type="search"
               maxlength="120" placeholder="Search" value="<%= currentPath === '/search' ? (query.q || '') : '' %>">
      </form>

      <ul class="navbar-nav align-items-lg-center">
        <% if (currentUser) { %>
          <%
            /*
             * The two icons and the user menu read the SAME counts: public/js/main.js makes
             * one request per count and fills every element carrying its data attribute, so
             * the bell and the menu cannot disagree about how many are unread.
             */
            const ROLE_BADGES = { consultant: 'Consultant', company: 'Company', recruiter: 'Agency',
              partner: 'Partner', admin: 'Admin' };
            const badges = (currentUser.roles || []).filter((r) => ROLE_BADGES[r]);
            if (currentUser.isSuperadmin && !badges.includes('admin')) badges.push('admin');
          %>
          <li class="nav-item">
            <a class="nav-link" href="/messages" aria-label="Messages">
              <i class="bi bi-chat-dots"></i>
              <%# Filled by public/js/main.js, which makes no request when the element %>
              <%# is absent — so the badge and the endpoint arrive together or not at all. %>
              <span class="notif-dot d-none" id="messageCount" data-count="messages" aria-live="polite"></span>
            </a>
          </li>
          <li class="nav-item">
            <%# A link first, so it works with scripting off; main.js turns it into the %>
            <%# opener for the Notifications section of the user menu. %>
            <a class="nav-link" href="/notifications" aria-label="Notifications" data-open-notifications>
              <i class="bi bi-bell"></i>
              <span class="notif-dot d-none" id="notifCount" data-count="notifications" aria-live="polite"></span>
            </a>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" id="userMenuToggle"
               data-bs-toggle="dropdown" data-bs-display="static" data-bs-auto-close="outside" aria-expanded="false">
              <img class="avatar" style="width:30px;height:30px"
                   src="<%= currentUser.profilePicture || '/images/avatar-placeholder.svg' %>" alt="">
              <span class="d-none d-lg-inline"><%= currentUser.name %></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end user-menu-dropdown" aria-labelledby="userMenuToggle">
              <li class="dropdown-header user-menu-profile">
                <a href="/profile" class="d-flex align-items-center gap-3 text-reset text-decoration-none">
                  <% if (currentUser.profilePicture) { %>
                    <img class="user-menu-avatar" src="<%= currentUser.profilePicture %>" alt="" width="48" height="48">
                  <% } else { %>
                    <span class="user-menu-avatar user-menu-avatar-empty" aria-hidden="true"><i class="bi bi-person-fill"></i></span>
                  <% } %>
                  <span class="min-w-0 flex-grow-1">
                    <span class="d-block fw-bold text-truncate user-menu-name"><%= currentUser.name %></span>
                    <span class="d-block small text-muted-2 text-truncate user-menu-email"><%= currentUser.email %></span>
                    <% if (badges.length) { %>
                      <span class="d-flex flex-wrap gap-1 mt-1">
                        <% badges.forEach(function (r) { %><span class="badge-hub user-menu-role"><%= ROLE_BADGES[r] %></span><% }) %>
                      </span>
                    <% } %>
                  </span>
                </a>
              </li>
              <li><hr class="dropdown-divider my-0"></li>

              <li class="user-menu-notifications" id="userMenuNotifications">
                <div class="d-flex justify-content-between align-items-center px-3 pt-2 pb-1">
                  <span class="user-menu-section-title"><i class="bi bi-bell me-1"></i>Notifications</span>
                  <span class="d-flex align-items-center">
                    <a class="btn btn-link btn-sm user-menu-action" href="/notifications">Show all</a>
                    <form method="post" action="/notifications/read-all" class="m-0" data-mark-all-read data-no-guard="true">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-link btn-sm user-menu-action" type="submit">Mark all read</button>
                    </form>
                  </span>
                </div>
                <%#
                  Filled from /notifications/recent the first time the menu opens, so a page
                  render costs no query for a list most page views never look at. Until then —
                  and with scripting off — it says where the list is rather than claiming
                  there is nothing new, which it cannot know.
                %>
                <div class="notification-list" data-notification-list>
                  <p class="text-center text-muted-2 small py-3 mb-0">
                    <a href="/notifications">Open your notifications</a>
                  </p>
                </div>
              </li>
              <li><hr class="dropdown-divider my-1"></li>

              <li class="px-2 py-2">
                <div class="dropdown-quick-links">
                  <a class="quick-link-item" href="/dashboard"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                  <a class="quick-link-item" href="/profile"><i class="bi bi-person"></i><span>Profile</span></a>
                  <a class="quick-link-item" href="/messages">
                    <span class="position-relative">
                      <i class="bi bi-chat-dots"></i>
                      <span class="notif-dot quick-link-badge d-none" data-count="messages"></span>
                    </span>
                    <span>Messages</span>
                  </a>
                  <a class="quick-link-item" href="/profile/settings"><i class="bi bi-gear"></i><span>Settings</span></a>
                </div>
              </li>
              <li><hr class="dropdown-divider my-0"></li>

              <% if (currentUser.isConsultant) { %>
                <li class="dropdown-header py-2 text-primary"><i class="bi bi-person-workspace me-2"></i>Consultant</li>
                <li><a class="<%= itemClass('/profile/consultant') %>" href="/profile/consultant"><i class="bi bi-person-badge me-2"></i>Build Profile</a></li>
                <li><a class="<%= itemClass('/dashboard/applications') %>" href="/dashboard/applications"><i class="bi bi-file-earmark-text me-2"></i>My Applications</a></li>
                <li><a class="<%= itemClass('/profile/documents') %>" href="/profile/documents"><i class="bi bi-folder me-2"></i>Documents</a></li>
                <li><a class="<%= itemClass('/dashboard/saved') %>" href="/dashboard/saved"><i class="bi bi-bookmark-heart me-2"></i>Saved Jobs</a></li>
                <li><a class="<%= itemClass('/challenges') %>" href="/challenges"><i class="bi bi-trophy me-2"></i>Challenges</a></li>
                <% if (!currentUser.isCompany) { %>
                  <li><a class="<%= itemClass('/community/new') %>" href="/community/new"><i class="bi bi-pencil me-2"></i>Write a post</a></li>
                <% } %>
              <% } %>

              <% if (currentUser.isCompany) { %>
                <li class="dropdown-header py-2 text-primary"><i class="bi bi-building me-2"></i>Company</li>
                <li><a class="<%= itemClass('/jobs/new') %>" href="/jobs/new"><i class="bi bi-plus-square me-2"></i>Post a role</a></li>
                <li><a class="<%= itemClass('/dashboard/jobs') %>" href="/dashboard/jobs"><i class="bi bi-briefcase me-2"></i>Your roles</a></li>
                <li><a class="<%= itemClass('/applications') %>" href="/applications"><i class="bi bi-funnel me-2"></i>Candidate pipeline</a></li>
                <li><a class="<%= itemClass('/dashboard/transfers') %>" href="/dashboard/transfers"><i class="bi bi-arrow-left-right me-2"></i>Role handovers</a></li>
                <li><a class="<%= itemClass('/profile/company') %>" href="/profile/company"><i class="bi bi-building-gear me-2"></i>Company profile</a></li>
                <li><a class="<%= itemClass('/quotes') %>" href="/quotes"><i class="bi bi-file-text me-2"></i>Your estimates</a></li>
                <li><a class="<%= itemClass('/payments/history') %>" href="/payments/history"><i class="bi bi-receipt me-2"></i>Payments &amp; invoices</a></li>
                <li><a class="<%= itemClass('/community/new') %>" href="/community/new"><i class="bi bi-pencil me-2"></i>Write a post</a></li>
              <% } %>

              <% if (currentUser.isRecruiter) { %>
                <li class="dropdown-header py-2 text-primary"><i class="bi bi-person-rolodex me-2"></i>Agency</li>
                <li><a class="<%= itemClass('/recruiters/dashboard') %>" href="/recruiters/dashboard"><i class="bi bi-speedometer2 me-2"></i>Agency dashboard</a></li>
                <li><a class="<%= itemClass('/recruiters/profile') %>" href="/recruiters/profile"><i class="bi bi-pencil-square me-2"></i>Agency profile</a></li>
              <% } %>

              <%#
                Every account can join the referral scheme — there is no agent role to check —
                and /referrals shows the join page to somebody who has not, so the section is
                offered to everybody rather than hidden behind a flag that does not exist.
                Their introductions are the "leads": the people who signed up through the link.
              %>
              <li class="dropdown-header py-2 text-success"><i class="bi bi-person-badge me-2"></i>Sales Agent</li>
              <li><a class="<%= itemClass('/referrals') %>" href="/referrals"><i class="bi bi-speedometer2 me-2"></i>Agent Dashboard</a></li>
              <li><a class="dropdown-item" href="/referrals#introductions"><i class="bi bi-person-lines-fill me-2"></i>My Leads</a></li>

              <% if (currentUser.isAdmin) { %>
                <li><hr class="dropdown-divider my-1"></li>
                <li><a class="dropdown-item dropdown-item-admin" href="/admin"><i class="bi bi-shield-lock me-2"></i>Admin Panel</a></li>
              <% } %>
              <li><hr class="dropdown-divider my-1"></li>
              <li>
                <form method="post" action="/auth/logout" class="m-0">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="dropdown-item dropdown-item-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                </form>
              </li>
            </ul>
          </li>
        <% } else { %>
          <%#
            Two buttons, outline then filled. A plain text link beside a filled button reads
            as the lesser of the two, and signing in is not a lesser action than signing up —
            it is what every returning member came here to do.
          %>
          <li class="nav-item"><a class="btn btn-outline-light btn-sm" href="/auth/login">Sign in</a></li>
          <li class="nav-item ms-lg-2 mt-2 mt-lg-0"><a class="btn btn-primary btn-sm" href="/auth/register">Sign up</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
