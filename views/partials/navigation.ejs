<a class="skip-link" href="#main">Skip to content</a>
<nav class="navbar navbar-expand-lg navbar-hub sticky-top" aria-label="Main">
  <div class="container">
    <a class="navbar-brand d-inline-flex align-items-center gap-2" href="/">
      <%# Decorative: the wordmark beside it already names the site, so a screen reader %>
      <%# announcing both would read it twice. %>
      <img src="/images/logo-mark.svg" alt="" width="28" height="28" class="brand-mark" aria-hidden="true">
      <span>SAP<span class="accent">Hub</span></span>
    </a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <%
        /*
         * Grouped into hubs rather than one flat row.
         *
         * A flat list grows until nothing in it is findable. Grouping by WHO the item is
         * for — someone looking for work, someone hiring — means a person only ever reads
         * the half that is theirs. Items behind a sign-in appear only when signed in;
         * showing them to a stranger and then bouncing them to a login is a worse
         * experience than not offering them.
         *
         * EVERY ITEM HERE POINTS AT A ROUTE THAT EXISTS. The reference's menu carries the
         * community, messages, quotes, agencies and the assistant; those are later areas,
         * and a menu that offers a 404 is worse than a menu that is short.
         */
        const path = currentPath;
        const startsWith = (p) => path === p || path.startsWith(p + '/');
        const isConsultantArea = startsWith('/jobs') || startsWith('/rates')
          || (currentUser && startsWith('/profile/consultant'));
        const isCompanyArea = startsWith('/consultants') || startsWith('/companies')
          || startsWith('/recruiters') || (currentUser && startsWith('/quotes'));
      %>

      <ul class="navbar-nav me-auto align-items-lg-center">
        <li class="nav-item">
          <a class="nav-link <%= path === '/' ? 'active' : '' %>" href="/"><i class="bi bi-house"></i> Home</a>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= startsWith('/community') ? 'active' : '' %>" href="#" role="button"
             data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
            <i class="bi bi-people"></i> Community
          </a>
          <ul class="dropdown-menu shadow-sm">
            <li><a class="dropdown-item" href="/community"><i class="bi bi-chat-square-text"></i> Questions and posts</a></li>
            <li><a class="dropdown-item" href="/community?kind=question&amp;unanswered=1"><i class="bi bi-patch-question"></i> Unanswered questions</a></li>
            <li><a class="dropdown-item" href="/challenges"><i class="bi bi-lightning"></i> Daily challenge</a></li>
            <% if (currentUser) { %>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/community/new"><i class="bi bi-pencil"></i> Write a post</a></li>
              <li><a class="dropdown-item" href="/payments/history"><i class="bi bi-receipt"></i> Payments &amp; invoices</a></li>
            <% } %>
          </ul>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= isConsultantArea ? 'active' : '' %>" href="#" role="button"
             data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
            <i class="bi bi-person-badge"></i> Consultant Hub
          </a>
          <ul class="dropdown-menu shadow-sm">
            <li><a class="dropdown-item" href="/jobs"><i class="bi bi-briefcase"></i> Find work</a></li>
            <li><a class="dropdown-item" href="/rates"><i class="bi bi-graph-up"></i> Rate index</a></li>
            <% if (currentUser && currentUser.isConsultant) { %>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/profile/consultant"><i class="bi bi-person-gear"></i> Build your profile</a></li>
              <li><a class="dropdown-item" href="/dashboard/applications"><i class="bi bi-send"></i> Your applications</a></li>
              <li><a class="dropdown-item" href="/dashboard/saved"><i class="bi bi-bookmark"></i> Saved jobs</a></li>
              <li><a class="dropdown-item" href="/rates/submit"><i class="bi bi-plus-circle"></i> Contribute your rate</a></li>
            <% } %>
          </ul>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= isCompanyArea ? 'active' : '' %>" href="#" role="button"
             data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
            <i class="bi bi-building"></i> Companies Hub
          </a>
          <ul class="dropdown-menu shadow-sm">
            <li><a class="dropdown-item" href="/consultants"><i class="bi bi-people"></i> Find consultants</a></li>
            <li><a class="dropdown-item" href="/companies"><i class="bi bi-buildings"></i> Companies</a></li>
            <li><a class="dropdown-item" href="/recruiters"><i class="bi bi-person-rolodex"></i> Agencies</a></li>
            <% if (currentUser) { %>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/quotes"><i class="bi bi-calculator"></i> Scope estimates</a></li>
            <% } %>
            <% if (currentUser && currentUser.isRecruiter) { %>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/recruiters/dashboard"><i class="bi bi-person-rolodex"></i> Agency dashboard</a></li>
              <li><a class="dropdown-item" href="/recruiters/profile"><i class="bi bi-pencil-square"></i> Agency profile</a></li>
            <% } %>
            <% if (currentUser && currentUser.isCompany) { %>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/jobs/new"><i class="bi bi-plus-square"></i> Post a role</a></li>
              <li><a class="dropdown-item" href="/dashboard/jobs"><i class="bi bi-briefcase"></i> Your roles</a></li>
              <li><a class="dropdown-item" href="/profile/company"><i class="bi bi-building-gear"></i> Company profile</a></li>
            <% } %>
          </ul>
        </li>
      </ul>

      <%#
        The search box, in the slot the stylesheet has had a `.nav-search` rule for since
        the design system landed and nothing to put in it. A plain GET form: it works with
        scripting off, the browser remembers what was typed, and the results page is the
        same URL somebody can bookmark or share.
      %>
      <form class="nav-search d-flex me-lg-3 my-2 my-lg-0" method="get" action="/search" role="search">
        <label class="visually-hidden" for="navSearch">Search the Hub</label>
        <input class="form-control form-control-sm" id="navSearch" name="q" type="search"
               maxlength="120" placeholder="Search" value="<%= currentPath === '/search' ? (query.q || '') : '' %>">
      </form>

      <ul class="navbar-nav align-items-lg-center">
        <% if (currentUser) { %>
          <li class="nav-item">
            <a class="nav-link" href="/messages" aria-label="Messages">
              <i class="bi bi-chat-dots"></i>
              <%# Filled by public/js/main.js, which makes no request when the element %>
              <%# is absent — so the badge and the endpoint arrive together or not at all. %>
              <span class="notif-dot d-none" id="messageCount" aria-live="polite"></span>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/notifications" aria-label="Notifications">
              <i class="bi bi-bell"></i>
              <span class="notif-dot d-none" id="notifCount" aria-live="polite"></span>
            </a>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button"
               data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
              <img class="avatar" style="width:30px;height:30px"
                   src="<%= currentUser.profilePicture || '/images/avatar-placeholder.svg' %>" alt="">
              <span class="d-none d-lg-inline"><%= currentUser.name %></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
              <li><a class="dropdown-item" href="/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
              <li><a class="dropdown-item" href="/messages"><i class="bi bi-chat-dots"></i> Messages</a></li>
              <li><a class="dropdown-item" href="/community/new"><i class="bi bi-pencil"></i> Write a post</a></li>
              <li><a class="dropdown-item" href="/payments/history"><i class="bi bi-receipt"></i> Payments &amp; invoices</a></li>
              <li><a class="dropdown-item" href="/referrals"><i class="bi bi-people"></i> Refer someone</a></li>
              <li><a class="dropdown-item" href="/profile/settings"><i class="bi bi-gear"></i> Settings</a></li>
              <% if (currentUser.isAdmin) { %>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/admin"><i class="bi bi-shield-lock"></i> Admin</a></li>
              <% } %>
              <li><hr class="dropdown-divider"></li>
              <li>
                <form method="post" action="/auth/logout" class="px-3 py-1">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-link p-0 text-decoration-none" type="submit">Sign out</button>
                </form>
              </li>
            </ul>
          </li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/auth/login">Sign in</a></li>
          <li class="nav-item ms-lg-2"><a class="btn btn-primary btn-sm" href="/auth/register">Join free</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
