<%
  /*
   * The assistant widget — a mascot, like dynamicshub.net's Dynamo (2026-10-22).
   *
   * Rendered only when the feature is actually configured — see `assistantReady`, set in
   * server.js. A launcher that opens a panel which answers 503 is worse than no launcher:
   * it advertises something the deployment does not have.
   *
   * The launcher is the robot, with a small "AI" tag on it so nobody mistakes it for
   * decoration; a one-time teaser says who it is. The name is `config.assistant.name`, the
   * same value the system prompt introduces itself with.
   *
   * Everything here is plain markup and a progressively-enhanced script. With JavaScript
   * off the widget is not shown at all, because a chat box that cannot send is furniture.
   */
%>
<div class="assistant" id="assistant" hidden>
  <div class="assistant-teaser" id="assistantTeaser" hidden>
    <button class="assistant-teaser-close" type="button" id="assistantTeaserClose" aria-label="Dismiss">
      <i class="bi bi-x" aria-hidden="true"></i>
    </button>
    <button class="assistant-teaser-body" type="button" id="assistantTeaserOpen">
      <strong>WhatSAP?</strong>
      <span>I'm <%= assistantName %>, SAP Hub's AI assistant — ask me anything about the site.</span>
    </button>
  </div>

  <section class="assistant-panel" id="assistantPanel" hidden aria-labelledby="assistantTitle">
    <header class="assistant-head">
      <img class="assistant-avatar" src="/images/hub-assistant-head.webp?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" alt="" width="40" height="40">
      <h2 class="assistant-title mb-0" id="assistantTitle">
        <%= assistantName %> <span class="assistant-sub">Hub Assistant</span> <span class="assistant-badge">AI</span>
      </h2>
      <button class="btn-close" type="button" id="assistantClose" aria-label="Close the assistant"></button>
    </header>

    <div class="assistant-log" id="assistantLog" role="log" aria-live="polite">
      <%# One line on purpose: messages keep their whitespace (pre-wrap), so indentation would show. %>
      <div class="assistant-msg assistant-msg-bot"><p class="mb-1">WhatSAP?</p><p class="mb-0">I'm <%= assistantName %>, SAP Hub's AI assistant. I can help you find your way around — jobs, consultants, the rate index, the scope estimator, quotes and the community. I cannot see your account, and I do not give SAP consulting advice.</p></div>
    </div>

    <div class="assistant-chips" id="assistantChips">
      <% ['How do I get started?', 'How does the rate index work?', 'How do I get an SOW quote?'].forEach(function (q) { %>
        <button class="assistant-chip" type="button" data-ask="<%= q %>"><%= q %></button>
      <% }); %>
    </div>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <%# Outside the chips, which go once a conversation starts: this is the only way back to the tour. %>
      <button class="assistant-tour btn btn-link btn-sm" type="button" id="assistantTour"><i class="bi bi-signpost-2 me-1" aria-hidden="true"></i>Show me the welcome tour</button>
    <% } %>

    <form class="assistant-form" id="assistantForm" data-no-guard="true">
      <label class="visually-hidden" for="assistantInput">Your question</label>
      <input class="form-control" type="text" id="assistantInput" name="message"
             maxlength="<%= assistantMaxChars %>" autocomplete="off"
             placeholder="Ask about SAP Hub…">
      <button class="btn btn-primary" type="submit" id="assistantSend">
        <i class="bi bi-send" aria-hidden="true"></i>
        <span class="visually-hidden">Send</span>
      </button>
    </form>

    <p class="assistant-foot">
      Answers come from a language model and can be wrong. Nothing you type here is stored
      on the server.
    </p>
  </section>

  <button class="assistant-launcher" type="button" id="assistantLauncher"
          aria-expanded="false" aria-controls="assistantPanel"
          aria-label="Open <%= assistantName %>, the AI Hub Assistant">
    <img class="assistant-launcher-img" src="/images/hub-assistant.webp?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" alt="" width="68" height="96" decoding="async">
    <span class="assistant-launcher-ai" aria-hidden="true">AI</span>
  </button>
</div>
