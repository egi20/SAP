<%- include('../partials/layout-start') %>

<%
  /*
   * A ticked box has to survive a refused submission and a "start from a previous
   * estimate": the body carries a lone value as a string and several as an array.
   */
  const picked = function (field, value) {
    const v = values[field];
    return Array.isArray(v) ? v.includes(value) : v === value;
  };
  const req = '<span class="text-danger" aria-hidden="true">*</span>';
%>
<%- include('../partials/page-header', {
      icon: 'bi-calculator',
      heading: 'SOW Generator',
      sub: 'Scope, effort, team shape and budget for an SAP programme.',
      label: 'DELIVERY'
    }) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <% if (errors.length) { %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% errors.forEach(function (e) { %><li><%= e.msg %></li><% }); %>
      </ul>
    </div>
  <% } %>

  <%#
    What the author walks away with, before they start: the steps and the three documents,
    named from DOCUMENT_KINDS so this box cannot promise a file the generator does not make.
  -%>
  <div class="glass-card mb-4"><div class="card-body">
    <div class="row g-4 align-items-start">
      <div class="col-lg-7">
        <h2 class="h5 card-heading">What you'll get</h2>
        <ol class="mb-0 sow-steps">
          <li><strong>Describe the client and the project</strong> — who it is for, where they are today and when they want to go live.</li>
          <li><strong>Choose the scope</strong> — the SAP modules, the transition approach, data migration and add-ons.</li>
          <li><strong>Calculate and save</strong> — effort per SAP Activate phase, a team plan, a timeline and a budget that reconcile line by line.</li>
          <li><strong>Download and send</strong> — every saved estimate has a reference starting <code>Q-</code> and is kept under <a href="/quotes">your estimates</a>.</li>
        </ol>
      </div>
      <div class="col-lg-5">
        <h3 class="h6 mb-2">Documents</h3>
        <ul class="list-unstyled mb-3">
          <% Object.values(sowDocuments).forEach(function (d) { %>
            <li class="mb-1"><i class="bi bi-file-earmark-text me-2" aria-hidden="true"></i><%= d.label %> <span class="text-muted-2">(.<%= d.extension %>)</span></li>
          <% }); %>
        </ul>
        <% if (recent && recent.length && !startedFrom) { %>
          <a class="btn btn-outline-primary btn-sm mb-2" href="/quotes/new?from=<%= recent[0].reference %>">
            <i class="bi bi-copy me-1" aria-hidden="true"></i>Use my last estimate (<%= recent[0].reference %>)
          </a>
        <% } %>
        <% if (recent && recent.length) { %>
          <%# A new quote can start from one of the author's own, copied into this form; nothing is changed on the old one. -%>
          <form method="get" action="/quotes/new" class="d-flex gap-2 align-items-end">
            <div class="flex-grow-1">
              <label class="form-label small mb-1" for="from">Start from a previous estimate</label>
              <select class="form-select form-select-sm" id="from" name="from">
                <% recent.forEach(function (q) { %>
                  <option value="<%= q.reference %>" <%= startedFrom === q.reference ? 'selected' : '' %>><%= q.reference %> — <%= q.project_name %></option>
                <% }); %>
              </select>
            </div>
            <button class="btn btn-outline-primary btn-sm" type="submit">Use</button>
          </form>
        <% } %>
        <% if (!recent || !recent.length) { %>
          <p class="small text-muted-2 mb-0">Once you have saved an estimate, the next one can start from a copy of it here.</p>
        <% } %>
        <% if (startedFrom) { %>
          <p class="small text-muted-2 mt-2 mb-0">
            Copied from <a href="/quotes/<%= startedFrom %>"><%= startedFrom %></a>; saving creates a new estimate.
            <a href="/quotes/new">Start blank</a>
          </p>
        <% } %>
      </div>
    </div>
  </div></div>

  <p class="small text-muted-2 mb-3"><span class="text-danger">*</span> Required</p>

  <form method="post" action="/quotes" id="quote-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="row g-4">
      <div class="col-lg-8">

        <div class="glass-card mb-4">
          <div class="card-body">
            <h2 class="h6 mb-3">Who it is for</h2>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" for="client_company">Client company <%- req %></label>
                <input class="form-control" id="client_company" name="client_company" maxlength="200" required
                       value="<%= values.client_company || '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label" for="client_name">Contact name <%- req %></label>
                <input class="form-control" id="client_name" name="client_name" maxlength="200" required
                       value="<%= values.client_name || '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label" for="client_email">Contact email</label>
                <input class="form-control" id="client_email" name="client_email" type="email" maxlength="255"
                       value="<%= values.client_email || '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label" for="client_industry">Industry</label>
                <select class="form-select" id="client_industry" name="client_industry">
                  <option value="">Not specified</option>
                  <% industries.forEach(function (i) { %>
                    <option value="<%= i %>" <%= values.client_industry === i ? 'selected' : '' %>><%= i %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="company_size">Company size</label>
                <select class="form-select" id="company_size" name="company_size">
                  <option value="">Not specified</option>
                  <% companySizes.forEach(function (s) { %>
                    <option value="<%= s %>" <%= values.company_size === s ? 'selected' : '' %>><%= s %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="project_name">Project name <%- req %></label>
                <input class="form-control" id="project_name" name="project_name" maxlength="200" required
                       value="<%= values.project_name || '' %>">
              </div>
              <div class="col-12">
                <label class="form-label" for="project_summary">Summary</label>
                <textarea class="form-control" id="project_summary" name="project_summary" rows="3"><%= values.project_summary || '' %></textarea>
              </div>
            </div>
          </div>
        </div>

        <%#
          Project context: what the SOW has to say about the client's situation. Only data
          migration moves the number — it is real effort — so it is an engine input; the rest
          is carried into the estimate as the author typed it.
        -%>
        <div class="glass-card mb-4">
          <div class="card-body">
            <h2 class="h6 mb-3">Project context</h2>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" for="current_system">Current system</label>
                <select class="form-select" id="current_system" name="current_system">
                  <option value="">Not specified</option>
                  <% Object.entries(currentSystems).forEach(function (entry) { %>
                    <option value="<%= entry[0] %>" <%= values.current_system === entry[0] ? 'selected' : '' %>><%= entry[1] %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="go_live_date">Target go-live</label>
                <input class="form-control" id="go_live_date" name="go_live_date" type="date"
                       value="<%= values.go_live_date || '' %>">
                <div class="form-text">The estimate says whether its timeline fits.</div>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="data_migration_scope">Data migration</label>
                <select class="form-select" id="data_migration_scope" name="data_migration_scope">
                  <% Object.entries(dataMigrationScopes).forEach(function (entry) { %>
                    <option value="<%= entry[0] %>" <%= (values.data_migration_scope || 'not-assessed') === entry[0] ? 'selected' : '' %>><%= entry[1].name %></option>
                  <% }); %>
                </select>
                <div class="form-text">Costed as a share of the module effort. "Not assessed" adds nothing and the estimate says so.</div>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="data_volume">Data volume</label>
                <select class="form-select" id="data_volume" name="data_volume">
                  <% Object.entries(dataVolumes).forEach(function (entry) { %>
                    <option value="<%= entry[0] %>" <%= (values.data_volume || 'medium') === entry[0] ? 'selected' : '' %>><%= entry[1].name %> (×<%= entry[1].multiplier %>)</option>
                  <% }); %>
                </select>
              </div>
              <div class="col-12">
                <label class="form-label" for="success_criteria">Success criteria</label>
                <textarea class="form-control" id="success_criteria" name="success_criteria" rows="2" maxlength="2000"
                          placeholder="What has to be true at go-live for the client to call it a success."><%= values.success_criteria || '' %></textarea>
              </div>
              <div class="col-12">
                <label class="form-label" for="constraints">Constraints</label>
                <textarea class="form-control" id="constraints" name="constraints" rows="2" maxlength="2000"
                          placeholder="Fixed dates, freeze periods, budget ceilings, people who are not available."><%= values.constraints || '' %></textarea>
              </div>
            </div>
          </div>
        </div>

        <%#
          The transition approach comes FIRST and on its own, because it is the first
          question asked on any real S/4HANA programme and it moves the number more than
          anything else on this form. Radios rather than a dropdown: each one needs its
          description read, and a collapsed select hides exactly the sentence that stops
          somebody choosing brownfield because it sounds cheaper.
        %>
        <div class="glass-card mb-4">
          <div class="card-body">
            <h2 class="h6 mb-3">How they get to S/4HANA</h2>
            <% Object.entries(transitionApproaches).forEach(function (entry) { %>
              <div class="form-check mb-3">
                <input class="form-check-input" type="radio" name="transition_approach" id="ta-<%= entry[0] %>"
                       value="<%= entry[0] %>"
                       <%= (values.transition_approach || 'greenfield') === entry[0] ? 'checked' : '' %>>
                <label class="form-check-label" for="ta-<%= entry[0] %>">
                  <strong><%= entry[1].name %></strong>
                  <span class="badge-hub">×<%= entry[1].multiplier %></span>
                  <div class="form-text mt-0"><%= entry[1].description %></div>
                </label>
              </div>
            <% }); %>
          </div>
        </div>

        <div class="glass-card mb-4">
          <div class="card-body">
            <h2 class="h6 mb-1">Scope</h2>
            <p class="form-text mt-0 mb-3">
              Tick the modules in scope. A module whose partner is <em>not</em> ticked still
              costs something — the boundary to it has to be built either way — and the
              estimate shows each of those separately rather than burying it.
            </p>

            <div class="mb-3 d-none" data-module-search-wrap>
              <label class="visually-hidden" for="module_search">Search modules</label>
              <input class="form-control" id="module_search" type="search" placeholder="Search modules, e.g. EWM or Ariba" data-module-search>
            </div>

            <% productLines.forEach(function (line) { %>
              <% const groupOpen = picked('lines', line.value) || line.modules.some(function (m) { return picked('modules', m.value); }); %>
              <details class="filter-group mb-2" data-module-group <%= groupOpen ? 'open' : '' %>>
                <summary class="form-label mb-2"><%= line.label %> <span class="badge-hub ms-1 d-none" data-selected-count></span></summary>
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" name="lines" value="<%= line.value %>"
                         id="line-<%= line.value %>" <%= picked('lines', line.value) ? 'checked' : '' %>>
                  <label class="form-check-label small" for="line-<%= line.value %>">
                    Platform foundation only (<%= line.foundationEffortDays %> days)
                  </label>
                </div>
                <div class="d-flex flex-wrap gap-3">
                  <% line.modules.forEach(function (m) { %>
                    <div class="form-check" data-module-item data-search="<%= (m.label + ' ' + m.value + ' ' + line.label).toLowerCase() %>">
                      <input class="form-check-input" type="checkbox" name="modules" value="<%= m.value %>"
                             id="qm-<%= m.value %>" <%= picked('modules', m.value) ? 'checked' : '' %>>
                      <label class="form-check-label small" for="qm-<%= m.value %>">
                        <%= m.label %> <span class="text-muted-2">(<%= m.baseEffortDays %>d)</span>
                      </label>
                    </div>
                  <% }); %>
                </div>
              </details>
            <% }); %>

            <div class="mt-3">
              <label class="form-label" for="other_modules">Anything else in scope</label>
              <textarea class="form-control" id="other_modules" name="other_modules" rows="2"
                        placeholder="Comma-separated. Each item is costed as unmapped scope rather than ignored."><%= values.other_modules || '' %></textarea>
            </div>
          </div>
        </div>

        <div class="glass-card mb-4">
          <div class="card-body">
            <h2 class="h6 mb-3">Add-ons</h2>
            <div class="d-flex flex-wrap gap-3">
              <% Object.entries(addons).forEach(function (entry) { %>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="addons" value="<%= entry[0] %>"
                         id="ad-<%= entry[0] %>" <%= picked('addons', entry[0]) ? 'checked' : '' %>>
                  <label class="form-check-label small" for="ad-<%= entry[0] %>">
                    <%= entry[1].name %> <span class="text-muted-2">(<%= entry[1].days %>d)</span>
                  </label>
                </div>
              <% }); %>
            </div>
            <div class="mt-3">
              <label class="form-label" for="other_addons">Other add-ons</label>
              <textarea class="form-control" id="other_addons" name="other_addons" rows="2"><%= values.other_addons || '' %></textarea>
            </div>
          </div>
        </div>

        <button class="btn btn-primary" type="submit">Calculate and save</button>
      </div>

      <div class="col-lg-4">
        <%#
          The live total is asked of the server (POST /quotes/preview), which runs the same
          engine the save runs: a copy of the arithmetic in the browser would be a second
          answer. Without scripting the box says the figure appears after saving.
        -%>
        <div class="glass-card mb-4 sow-summary">
          <div class="card-body" data-quote-preview>
            <h2 class="h6 mb-2">Estimate so far</h2>
            <div data-preview-body>
              <p class="small text-muted-2 mb-3" data-preview-empty>Tick a module to see the effort and the budget. The full breakdown appears once it is saved.</p>
              <div class="d-none" data-preview-figures>
                <dl class="row small mb-2">
                  <dt class="col-6 fw-normal text-muted-2">Modules</dt><dd class="col-6 text-end mb-1" data-preview="modules">—</dd>
                  <dt class="col-6 fw-normal text-muted-2">Effort</dt><dd class="col-6 text-end mb-1" data-preview="days">—</dd>
                  <dt class="col-6 fw-normal text-muted-2">Duration</dt><dd class="col-6 text-end mb-1" data-preview="months">—</dd>
                  <dt class="col-6 fw-normal text-muted-2">Hypercare</dt><dd class="col-6 text-end mb-1" data-preview="hypercare">—</dd>
                  <dt class="col-6 fw-normal text-muted-2">Data migration</dt>
                  <dd class="col-6 text-end mb-1">
                    <span data-preview="migration">—</span>
                    <a class="d-none" href="#data_migration_scope" data-preview-migration-link>Choose a migration scope&nbsp;&uarr;</a>
                  </dd>
                  <dt class="col-6 fw-semibold">Budget</dt><dd class="col-6 text-end mb-0 fw-semibold" data-preview="budget">—</dd>
                </dl>
                <%#
                  Where the days come from, step by step, as the engine built them. Without it,
                  three modules of 80 days reading as 110 looks like an error rather than the
                  boundaries and the contingency it is.
                -%>
                <details class="small mb-2 sow-steps-detail" open>
                  <summary class="text-muted-2">How the days add up</summary>
                  <ul class="list-unstyled mb-0 mt-1" data-preview-steps></ul>
                </details>
                <div class="alert alert-warning small py-2 px-3 mb-2 d-none" data-preview-golive role="status"></div>
                <p class="small text-muted-2 mb-2 d-none" data-preview-earliest></p>
              </div>
            </div>
            <button class="btn btn-primary w-100" type="submit">Calculate and save</button>
          </div>
        </div>

        <div class="glass-card mb-4">
          <div class="card-body">
            <h2 class="h6 mb-3">Shape of the programme</h2>

            <div class="mb-3">
              <label class="form-label" for="clean_core_level">Clean core</label>
              <select class="form-select" id="clean_core_level" name="clean_core_level">
                <% Object.entries(cleanCoreLevels).forEach(function (entry) { %>
                  <option value="<%= entry[0] %>" <%= (values.clean_core_level || 'moderate') === entry[0] ? 'selected' : '' %>>
                    <%= entry[1].name %> (×<%= entry[1].multiplier %>)
                  </option>
                <% }); %>
              </select>
              <div class="form-text">Where the customisation lives, not how much of it there is.</div>
            </div>

            <div class="mb-3">
              <label class="form-label" for="complexity">Complexity</label>
              <select class="form-select" id="complexity" name="complexity">
                <% Object.entries(complexityLevels).forEach(function (entry) { %>
                  <option value="<%= entry[0] %>" <%= (values.complexity || 'moderate') === entry[0] ? 'selected' : '' %>>
                    <%= entry[0] %> — <%= entry[1].description %>
                  </option>
                <% }); %>
              </select>
            </div>

            <div class="row g-2 mb-3">
              <div class="col-6">
                <label class="form-label" for="number_of_users">Users</label>
                <input class="form-control" id="number_of_users" name="number_of_users" type="number" min="1"
                       value="<%= values.number_of_users || 50 %>">
              </div>
              <div class="col-6">
                <label class="form-label" for="number_of_company_codes">Company codes</label>
                <input class="form-control" id="number_of_company_codes" name="number_of_company_codes" type="number"
                       min="1" value="<%= values.number_of_company_codes || 1 %>">
              </div>
              <div class="col-6">
                <label class="form-label" for="number_of_countries">Countries</label>
                <input class="form-control" id="number_of_countries" name="number_of_countries" type="number" min="1"
                       value="<%= values.number_of_countries || 1 %>">
              </div>
              <div class="col-6">
                <label class="form-label" for="number_of_integrations">Integrations</label>
                <input class="form-control" id="number_of_integrations" name="number_of_integrations" type="number"
                       min="0" value="<%= values.number_of_integrations || 0 %>">
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label" for="integration_complexity">Integration complexity</label>
              <select class="form-select" id="integration_complexity" name="integration_complexity">
                <% ['simple','medium','complex'].forEach(function (c) { %>
                  <option value="<%= c %>" <%= (values.integration_complexity || 'medium') === c ? 'selected' : '' %>><%= optionLabel(c) %></option>
                <% }); %>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label" for="contingency_percentage">Contingency %</label>
              <input class="form-control" id="contingency_percentage" name="contingency_percentage" type="number"
                     min="0" max="50" value="<%= values.contingency_percentage || 15 %>">
            </div>

            <div class="form-check mb-2">
              <input class="form-check-input" type="checkbox" name="include_training" id="include_training"
                     <%= values.include_training === 'on' ? 'checked' : '' %>>
              <label class="form-check-label" for="include_training">Include enablement</label>
              <div class="form-text">A role on the team, not a phase — excluding it shortens no timeline.</div>
            </div>

            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" name="include_run" id="include_run"
                     <%= values.include_run === 'on' ? 'checked' : '' %>>
              <label class="form-check-label" for="include_run">Include hypercare (Run)</label>
              <div class="form-text">Inside the total, never added on top of it.</div>
            </div>

            <div class="mb-3" data-hypercare-length>
              <label class="form-label" for="hypercare_duration">Hypercare length</label>
              <select class="form-select" id="hypercare_duration" name="hypercare_duration">
                <% Object.entries(hypercareDurations).forEach(function (entry) { %>
                  <option value="<%= entry[0] %>" <%= (values.hypercare_duration || 'standard') === entry[0] ? 'selected' : '' %>>
                    <%= entry[1].weeks ? entry[1].name : 'Standard — ' + runSharePercent + '% of the effort' %>
                  </option>
                <% }); %>
              </select>
              <div class="form-text">A length in weeks is staffed by <%= hypercareTeamSize %> people for that many weeks after go-live.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>
</section>

<script src="/js/quote-form.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" defer></script>
<%- include('../partials/layout-end') %>
