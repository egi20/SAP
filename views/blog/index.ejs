<%- include('../partials/layout-start') %>
<%- include('../partials/page-header', {
  icon: 'bi-journal-richtext',
  heading: 'The SAP Hub blog',
  sub: 'What we are building, what we are seeing in the market, and why things here work the way they do.'
}) %>
<section class="glass-section pb-5">
<div class="container">
  <div class="row justify-content-center"><div class="col-lg-9">

    <%#
      Each card links to the article's canonical URL under /community. There is no
      /blog/:slug: a second address for the same text is two pages competing in search, two
      reply counts to reconcile, and two places to land on a post that has since been
      hidden.
    %>
    <% if (posts.length === 0) { %>
      <div class="empty-state glass-card">
        <i class="bi bi-journal-richtext"></i>
        <p class="mb-1">Nothing published yet.</p>
        <p class="small mb-3">
          Members write here too — the community's own articles are worth more than
          anything we would have posted first.
        </p>
        <a class="btn btn-primary" href="/community/articles">Read community articles</a>
      </div>
    <% } else { %>
      <p class="text-muted-2 mb-4">
        <strong><%= total %></strong> post<%= total === 1 ? '' : 's' %>.
        Each one is a community article, so you can reply to any of them.
      </p>

      <% posts.forEach(function (post) { %>
        <article class="glass-card mb-3">
          <div class="card-body">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
              <span class="badge-hub accent"><i class="bi bi-journal-richtext"></i> Hub article</span>
              <a class="badge-hub text-decoration-none" href="/community/category/<%= post.category_slug %>">
                <i class="bi <%= post.category_icon %>"></i> <%= post.category_name %>
              </a>
              <span class="ms-auto small text-muted-2">
                <%= new Date(post.created_at).toISOString().slice(0, 10) %>
              </span>
            </div>

            <h2 class="h5 mb-2">
              <a class="text-reset" href="/community/<%= post.slug %>"><%= post.title %></a>
            </h2>

            <p class="text-muted-2 mb-3"><%= toPlainText(post.body, 280) %></p>

            <div class="d-flex flex-wrap align-items-center gap-3 small text-muted-2">
              <span>By <%= post.author_name %></span>
              <span title="Replies"><i class="bi bi-chat"></i> <%= post.reply_count %></span>
              <span title="Views"><i class="bi bi-eye"></i> <%= post.view_count %></span>
              <a class="ms-auto" href="/community/<%= post.slug %>">Read it <i class="bi bi-arrow-right"></i></a>
            </div>
          </div>
        </article>
      <% }) %>

      <%- include('../partials/pagination') %>
    <% } %>

    <%#
      Where a subscribe box would go. It is not here: a box that collects an address with
      nothing to send it, no record of consent and no unsubscribe link is a promise made to
      somebody who cannot withdraw it.
    %>
    <div class="glass-card mt-4"><div class="card-body">
      <h2 class="h6">Keeping up</h2>
      <p class="small text-muted-2 mb-0">
        There is no mailing list yet — we would rather have one with a working unsubscribe
        than an address box that collects names and sends nothing. In the meantime, the
        <a href="/community">community feed</a> carries these posts alongside everybody
        else's, and <a href="/community/articles">the articles page</a> has the rest.
      </p>
    </div></div>

  </div></div>
</div>
</section>
<%- include('../partials/layout-end') %>
