<%- include('../partials/layout-start') %>

<section class="glass-section pb-5">
<div class="container py-4">
  <%- include('../partials/flash') %>

  <% if (!profile.is_public) { %>
    <div class="alert alert-warning">This profile is hidden from the directory. Only you and admins can see it.</div>
  <% } %>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="glass-card mb-3">
        <div class="card-body">
          <div class="d-flex gap-3 mb-3">
            <%- include('../partials/avatar', {
              src: profile.profile_picture, name: profile.name, size: 72, extraClass: 'avatar-lg'
            }) %>
            <div>
              <%# Redacted in the route for a reader who is not signed in. %>
              <h1 class="h3 mb-1">
                <% if (profile.name) { %><%= profile.name %><% } else { %>
                  <span class="text-muted-2">Name hidden</span>
                <% } %>
              </h1>
              <p class="text-muted-2 mb-2"><%= profile.headline || roleLabel(profile.primary_role) %></p>
              <div class="d-flex flex-wrap gap-1">
                <% if (profile.primary_role) { %><span class="badge-hub accent"><%= roleLabel(profile.primary_role) %></span><% } %>
                <% if (profile.seniority) { %><span class="badge-hub"><%= profile.seniority %></span><% } %>
                <% if (profile.years_experience) { %><span class="badge-hub"><%= profile.years_experience %> yrs</span><% } %>
                <% if (profile.country) { %><span class="badge-hub"><%= locationLabel(profile.city, profile.country) %></span><% } %>
                <%
                  /*
                   * "LinkedIn confirmed", not "Verified".
                   *
                   * What was actually checked is that this person controls a LinkedIn
                   * account. LinkedIn's userinfo response carries no vanity URL, no
                   * headline and no positions, so nothing here verifies the profile link
                   * below, their job title or their employer — and a bare "Verified" badge
                   * would be read as verifying all three. The reference implementation's
                   * badge said exactly that while checking exactly this.
                   */
                %>
                <% if (profile.linkedin_verified) { %>
                  <span class="badge-hub ok" title="This member signed in to LinkedIn to confirm they control a LinkedIn account. It does not verify the profile link, their job title or their employer.">
                    <i class="bi bi-patch-check"></i> LinkedIn confirmed<%
                      /*
                       * The name that was actually confirmed, shown when it differs from
                       * the name on this profile. Both are legitimate — a middle name, a
                       * married name, a different spelling — and hiding the difference
                       * would let the badge imply it had checked something it had not.
                       */
                    %><% if (linkedInIdentity && linkedInIdentity.display_name && !linkedInIdentity.name_matched) { %>
                      as <%= linkedInIdentity.display_name %>
                    <% } %>
                  </span>
                <% } %>
              </div>
            </div>
          </div>

          <% if (profile.bio) { %>
            <hr>
            <h2 class="h6">About</h2>
            <div><%- sanitizeRichText(profile.bio) %></div>
          <% } %>
        </div>
      </div>

      <%#
        THE DELIVERY HISTORY, which is the thing this site knows that a CV does not.
        The directory's module filter and the match score both read it, and the public
        profile never rendered it — so a hirer who filtered for EWM and opened the result
        could not see the EWM engagement that put it there.
      %>
      <% if (projects.length) { %>
        <div class="glass-card mb-3">
          <div class="card-body">
            <h2 class="h6 mb-1">Delivery history</h2>
            <p class="small text-muted-2 mb-3">
              Engagements, with the modules each one actually touched. This is what the
              module filter searches — not a skills list.
            </p>
            <ul class="timeline">
              <% projects.forEach(function (pr) { %>
                <li>
                  <strong><%= pr.name %></strong>
                  <% if (pr.client) { %> · <%= pr.client %><% } %>
                  <% if (pr.clientRedacted) { %>
                    <span class="small text-muted-2">· client hidden</span>
                  <% } %>
                  <div class="small text-muted-2">
                    <% if (pr.role) { %><%= pr.role %> · <% } %>
                    <% if (pr.activate_phase) { %><%= pr.activate_phase %> · <% } %>
                    <%= pr.started_on ? new Date(pr.started_on).toISOString().slice(0, 7) : '' %> —
                    <%= pr.ended_on ? new Date(pr.ended_on).toISOString().slice(0, 7) : 'present' %>
                    <% if (pr.is_full_lifecycle) { %>
                      · <span class="badge-hub ok">full lifecycle</span>
                    <% } %>
                  </div>
                  <% if (pr.modules && pr.modules.length) { %>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                      <% pr.modules.forEach(function (m) { %>
                        <a class="badge-hub text-decoration-none" href="/consultants?modules=<%= m %>"><%= moduleLabel(m) %></a>
                      <% }) %>
                    </div>
                  <% } %>
                  <% if (pr.description) { %><div class="small mt-1"><%- sanitizeRichText(pr.description) %></div><% } %>
                </li>
              <% }) %>
            </ul>
          </div>
        </div>
      <% } %>

      <% if (experiences.length) { %>
        <div class="glass-card mb-3">
          <div class="card-body">
            <h2 class="h6 mb-3">Experience</h2>
            <ul class="timeline">
              <% experiences.forEach(function (e) { %>
                <li>
                  <strong><%= e.title %></strong> · <%= e.company %>
                  <div class="small text-muted-2">
                    <%= new Date(e.started_on).toISOString().slice(0, 7) %> —
                    <%= e.is_current ? 'present' : (e.ended_on ? new Date(e.ended_on).toISOString().slice(0, 7) : '') %>
                  </div>
                  <% if (e.description) { %><div class="small mt-1"><%- sanitizeRichText(e.description) %></div><% } %>
                </li>
              <% }); %>
            </ul>
          </div>
        </div>
      <% } %>
    </div>

    <aside class="col-lg-4">
      <div class="glass-card mb-3">
        <div class="card-body">
          <h2 class="h6">Availability and rate</h2>
          <p class="mb-1">
            <% if (profile.day_rate) { %>
              <span class="rate-figure"><%= Math.round(profile.day_rate) %></span>
              <span class="text-muted-2"><%= profile.currency %>/day</span>
            <% } else { %>
              <span class="text-muted-2">Rate on request</span>
            <% } %>
          </p>
          <p class="mb-1">
            <span class="badge-hub <%= profile.availability === 'immediate' ? 'ok' : '' %>">
              <%= { immediate: 'Available now', two_weeks: 'Available in 2 weeks', one_month: 'Available in a month', not_available: 'Not currently available' }[profile.availability] %>
            </span>
          </p>
          <p class="small text-muted-2 mb-0">
            <%= profile.work_mode %><%= profile.willing_to_travel ? ' · willing to travel' : '' %>
          </p>

          <% if (canSeeContact) { %>
            <hr>
            <h2 class="h6">Contact</h2>
            <p class="mb-1"><a href="mailto:<%= profile.email %>"><%= profile.email %></a></p>
            <% if (profile.linkedin_url) { %>
              <%
                /* Labelled as a link the member gave us, because that is all it is —
                   nothing available through LinkedIn's API can confirm it is theirs. */
              %>
              <p class="mb-1">
                <a href="<%= profile.linkedin_url %>" rel="nofollow noopener noreferrer" target="_blank">LinkedIn</a>
                <span class="small text-muted-2">(link provided by the member)</span>
              </p>
            <% } %>
            <% if (profile.sap_community_url) { %>
              <%# The same kind of claim as the LinkedIn link above, and labelled the same
                  way: the member typed it and nothing here can confirm it is theirs. %>
              <p class="mb-0">
                <a href="<%= profile.sap_community_url %>" rel="nofollow noopener noreferrer" target="_blank">SAP Community profile</a>
                <span class="small text-muted-2">(link provided by the member)</span>
              </p>
            <% } %>
          <% } else if (!isSelf) { %>
            <hr>
            <%#
              THREE outcomes, not two. "Signed out" and "signed in as the wrong kind of
              account" were sharing a branch, so a consultant reading another consultant's
              profile was offered a Sign in button leading to a page they were already past.
              Signing in would not have helped them, which is the worst thing a button can
              promise.
            %>
            <% if (!signedIn) { %>
              <p class="small text-muted-2 mb-2">Contact details are shown to signed-in hiring accounts.</p>
              <a class="btn btn-outline-primary w-100 btn-sm" href="/auth/login?redirect=<%= encodeURIComponent('/consultants/' + profile.user_id) %>">Sign in to contact</a>
            <% } else { %>
              <p class="small text-muted-2 mb-0">
                Contact details are shown to hiring accounts only — a company or an agency.
                An open directory of email addresses is a scraping target, and the people in
                it did not agree to that.
              </p>
            <% } %>
          <% } %>

          <% if (isSelf) { %>
            <hr>
            <a class="btn btn-primary w-100" href="/profile/consultant">Edit your profile</a>
          <% } %>
        </div>
      </div>

      <%#
        A thread is anchored to a role, always — there is no open inbox here, and that is
        the rule the schema, the model and the route each hold separately.

        So a company with no OPEN advert has nothing to anchor to, and this card used to
        render nothing at all in that case: the page simply had no way to get in touch and
        no explanation, which reads as a missing feature rather than a rule. It says which
        it is, and what to do about it.
      -%>
      <% if (signedIn && currentUser.isCompany && !isSelf && (!hiringJobs || !hiringJobs.length)) { %>
        <div class="glass-card mb-3">
          <div class="card-body">
            <h2 class="h6 mb-2">Approach about a role</h2>
            <p class="small text-muted-2 mb-3">
              Every conversation here is attached to a role, so the person you write to can
              see what it is about before they open it. You have no open role to attach one
              to yet.
            </p>
            <a class="btn btn-outline-primary w-100 btn-sm" href="/jobs/new">Post a role</a>
          </div>
        </div>
      <% } %>

      <% if (hiringJobs && hiringJobs.length && !isSelf) { %>
        <div class="glass-card mb-3">
          <div class="card-body">
            <h2 class="h6 mb-2">Approach about a role</h2>
            <form method="post" action="/messages/start">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="kind" value="enquiry">
              <input type="hidden" name="recipient_user_id" value="<%= profile.user_id %>">
              <div class="mb-2">
                <label class="form-label" for="enquiry-job">Role</label>
                <select class="form-select" id="enquiry-job" name="job_id" required>
                  <% hiringJobs.forEach(function (j) { %>
                    <option value="<%= j.id %>"><%= j.title %></option>
                  <% }); %>
                </select>
              </div>
              <textarea class="form-control mb-2" name="body" rows="3" required maxlength="5000"
                        placeholder="Say which role and why you are getting in touch"></textarea>
              <button class="btn btn-outline-primary w-100 btn-sm" type="submit">Send</button>
            </form>
            <p class="form-text mb-0">The thread is anchored to the role you pick.</p>
          </div>
        </div>
      <% } %>

      <%#
        Signed in only, and that is not decoration: the card links to their community page,
        which carries their NAME. Rendering it to a reader who may not see the name on the
        profile above would hand it over one click later. A total and a level, never the
        ledger — same rule as the author page.
      %>
      <% if (signedIn && standing && standing.points > 0) { %>
        <div class="glass-card mb-3">
          <div class="card-body">
            <h2 class="h6 mb-2">In the community</h2>
            <div class="d-flex align-items-center gap-3">
              <div class="match-ring" style="--pct: <%= standing.progressPercent %>">
                <span><%= standing.level %></span>
              </div>
              <div class="flex-grow-1">
                <strong><%= standing.title %></strong>
                <p class="small text-muted-2 mb-0 mt-1"><%= standing.points %> points</p>
              </div>
            </div>
            <a class="btn btn-sm btn-outline-secondary w-100 mt-3"
               href="/community/author/<%= profile.user_id %>">What they have written</a>
          </div>
        </div>
      <% } %>

      <% if (certifications.length) { %>
        <div class="glass-card mb-3">
          <div class="card-body">
            <h2 class="h6 mb-2">Certifications</h2>
            <ul class="list-unstyled mb-0 small">
              <% certifications.forEach(function (c) { %>
                <li class="mb-1">
                  <%# `label`, not `name`: there is no name column on the row. The model
                      derives the label from the catalogue so a renamed exam updates on
                      every profile holding it — asking for `name` rendered an empty
                      string beside a tick, which read as a certification with no title. %>
                  <i class="bi bi-patch-check text-success"></i> <%= c.label %>
                  <% if (c.earned_on) { %><span class="text-muted-2">· <%= new Date(c.earned_on).getFullYear() %></span><% } %>
                </li>
              <% }); %>
            </ul>
          </div>
        </div>
      <% } %>

      <% if (skills.length) { %>
        <div class="glass-card">
          <div class="card-body">
            <h2 class="h6 mb-2">Skills</h2>
            <div class="d-flex flex-wrap gap-1">
              <% skills.forEach(function (s) { %><span class="badge-hub"><%= s.name %></span><% }); %>
            </div>
          </div>
        </div>
      <% } %>
    </aside>
  </div>
</div>
</section>

<%- include('../partials/layout-end') %>
