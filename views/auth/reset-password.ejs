<%- include('../partials/layout-start') %>

<section class="glass-section glass-section-tall py-5">
  <div class="container">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <%- include('../partials/flash') %>
      <div class="glass-card">
        <div class="card-body p-4">
          <h1 class="h4 mb-3">Choose a new password</h1>

          <% if (errors.length) { %>
            <div class="alert alert-danger">
              <ul class="mb-0"><% errors.forEach(function (e) { %><li><%= e.msg %></li><% }); %></ul>
            </div>
          <% } %>

          <form method="post" action="/auth/reset-password/<%= encodeURIComponent(token) %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <%# The one place somebody is typing a password they have just invented, with
                nothing to check it against — so it is the page that most needs the toggle. %>
            <div class="mb-3">
              <%- include('../partials/password-field', {
                id: 'password', label: 'New password', autocomplete: 'new-password',
                help: 'At least 8 characters, with upper case, lower case and a number.'
              }) %>
            </div>
            <div class="mb-3">
              <%- include('../partials/password-field', {
                id: 'confirm_password', label: 'Confirm password', autocomplete: 'new-password'
              }) %>
            </div>
            <button class="btn btn-primary w-100" type="submit">Set new password</button>
          </form>
        </div>
      </div>
    </div>
  </div>
  </div>
</section>

<%- include('../partials/layout-end') %>
