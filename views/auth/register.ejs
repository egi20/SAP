<%- include('../partials/layout-start') %>

<section class="glass-section glass-section-tall py-5">
  <div class="container">
  <div class="row justify-content-center g-4">
    <div class="col-lg-6">
      <%- include('../partials/flash') %>

      <div class="glass-card">
        <div class="card-body p-4">
          <h1 class="h4 mb-1">Create your account</h1>
          <p class="text-muted-2">Free for consultants and hiring companies.</p>

          <% if (errors.length) { %>
            <div class="alert alert-danger">
              <ul class="mb-0"><% errors.forEach(function (e) { %><li><%= e.msg %></li><% }); %></ul>
            </div>
          <% } %>

          <form method="post" action="/auth/register" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="redirect" value="<%= redirect %>">
            <%
              /*
               * The referral code carried through a failed validation, so someone who
               * mistypes their password does not lose the attribution. The session copy is
               * checked first server-side, so this field is a convenience, not the source
               * of truth.
               */
            %>
            <input type="hidden" name="ref" value="<%= values.ref || '' %>">

            <fieldset class="mb-3">
              <legend class="form-label">I am</legend>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="user_types" value="consultant" id="t-consultant" checked>
                <label class="form-check-label" for="t-consultant">A SAP consultant looking for work</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="user_types" value="company" id="t-company">
                <label class="form-check-label" for="t-company">A company hiring SAP talent</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="user_types" value="recruiter" id="t-recruiter">
                <label class="form-check-label" for="t-recruiter">A recruitment agency or headhunter</label>
              </div>
              <p class="form-text">You can hold more than one role on one account.</p>
            </fieldset>

            <div class="mb-3">
              <label class="form-label" for="name">Full name</label>
              <input class="form-control" id="name" name="name" required value="<%= values.name || '' %>"
                     autocomplete="name" placeholder="First and last name">
            </div>

            <div class="mb-3">
              <label class="form-label" for="company_name">Company name <span class="text-muted-2">(if hiring)</span></label>
              <input class="form-control" id="company_name" name="company_name" value="<%= values.company_name || '' %>"
                     autocomplete="organization">
            </div>

            <div class="mb-3">
              <label class="form-label" for="email">Email</label>
              <input class="form-control" id="email" name="email" type="email" required
                     value="<%= values.email || '' %>" autocomplete="email">
            </div>

            <div class="row g-2 mb-3">
              <div class="col-md-6">
                <%- include('../partials/password-field', {
                  id: 'password', label: 'Password', autocomplete: 'new-password',
                  help: 'At least 8 characters, with upper case, lower case and a number.'
                }) %>
              </div>
              <div class="col-md-6">
                <%- include('../partials/password-field', {
                  id: 'confirm_password', label: 'Confirm password', autocomplete: 'new-password'
                }) %>
              </div>
            </div>

            <details class="mb-3">
              <summary class="small text-muted-2">Optional demographic questions</summary>
              <div class="row g-2 mt-1">
                <div class="col-md-6">
                  <label class="form-label" for="gender">Gender</label>
                  <select class="form-select" id="gender" name="gender">
                    <option value="">Prefer not to say</option>
                    <option value="female">Female</option>
                    <option value="male">Male</option>
                    <option value="non_binary">Non-binary</option>
                    <option value="other">Other</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="date_of_birth">Date of birth</label>
                  <input class="form-control" id="date_of_birth" name="date_of_birth" type="date">
                </div>
              </div>
              <p class="form-text mt-1">
                Voluntary, and used only for aggregate diversity reporting. Never shown on your profile
                and never shared with employers.
              </p>
            </details>

            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" id="terms" name="terms" required>
              <label class="form-check-label" for="terms">
                I accept the <a href="/legal/terms" target="_blank">terms</a> and
                <a href="/legal/privacy" target="_blank">privacy policy</a>.
              </label>
            </div>

            <%#
              Optional, and a closed list. Eight options are answered honestly and can be
              counted; a text box produces "google", "Google" and "googled it". It is also
              not the referral system — that records a link somebody actually followed and
              pays a commission on it, and an unverifiable answer must not go near the
              table that decides who gets paid.
            %>
            <div class="mb-3">
              <label class="form-label" for="heard_about">How did you hear about us? <span class="text-muted-2">(optional)</span></label>
              <select class="form-select" id="heard_about" name="heard_about">
                <option value="">Rather not say</option>
                <% signupSources.forEach(function (src) { %>
                  <option value="<%= src.value %>" <%= values.heard_about === src.value ? 'selected' : '' %>><%= src.label %></option>
                <% }) %>
              </select>
            </div>

            <button class="btn btn-primary w-100" type="submit">Create account</button>
          </form>

          <p class="text-center mt-3 mb-0 small">Already have an account? <a href="/auth/login">Sign in</a></p>
        </div>
      </div>
    </div>

    <%#
      Four reasons, each one a thing the account actually does. Not a count of members and
      not a testimonial: a figure nobody owns is a figure nobody updates, and a quotation
      on a sign-up page is the one piece of evidence a reader discounts automatically.
    %>
    <div class="col-lg-4">
      <div class="glass-card">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-muted-2 mb-3" style="letter-spacing:.06em">Why join</h2>
          <ul class="list-unstyled mb-0">
            <li class="d-flex gap-2 mb-3">
              <i class="bi bi-briefcase text-primary mt-1" aria-hidden="true"></i>
              <div>
                <strong class="d-block">Apply, and be found</strong>
                <span class="small text-muted-2">
                  Companies filter the directory by the modules you have actually delivered,
                  not the ones you ticked.
                </span>
              </div>
            </li>
            <li class="d-flex gap-2 mb-3">
              <i class="bi bi-incognito text-primary mt-1" aria-hidden="true"></i>
              <div>
                <strong class="d-block">Visible without being exposed</strong>
                <span class="small text-muted-2">
                  Names and photographs are shown to account holders only, and nobody can
                  message you except about a specific role.
                </span>
              </div>
            </li>
            <li class="d-flex gap-2 mb-3">
              <i class="bi bi-graph-up text-primary mt-1" aria-hidden="true"></i>
              <div>
                <strong class="d-block">Know what the work pays</strong>
                <span class="small text-muted-2">
                  Contribute a day rate and read the buckets it helps publish. Yours is never
                  shown beside your name.
                </span>
              </div>
            </li>
            <li class="d-flex gap-2">
              <i class="bi bi-people text-primary mt-1" aria-hidden="true"></i>
              <div>
                <strong class="d-block">Ask the people who have done it</strong>
                <span class="small text-muted-2">
                  Questions, write-ups and a daily challenge, organised by the same SAP
                  vocabulary as everything else here.
                </span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  </div>
</section>

<%- include('../partials/layout-end') %>
