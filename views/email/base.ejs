<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= subject %></title>
</head>
<body style="margin:0;padding:0;background:#f6f8fa;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#16191d">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f8fa;padding:24px 12px">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:12px;border:1px solid #eef1f4">
        <tr><td style="padding:20px 24px;border-bottom:1px solid #eef1f4">
          <span style="font-weight:700;font-size:18px;color:#00265b">SAP<span style="color:#0064d9">Hub</span></span>
        </td></tr>
        <tr><td style="padding:24px;font-size:15px;line-height:1.55"><%- body %></td></tr>
        <tr><td style="padding:16px 24px;border-top:1px solid #eef1f4;font-size:12px;color:#6b7280">
          You received this because you have an account at <a href="<%= baseUrl %>" style="color:#0b5cab"><%= appName %></a>.
          Questions? <a href="mailto:<%= supportEmail %>" style="color:#0b5cab"><%= supportEmail %></a>
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
