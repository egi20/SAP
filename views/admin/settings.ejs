<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', {
  icon: 'bi-sliders',
  heading: 'Settings',
  sub: 'Operational switches. Not catalogue values.'
}) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('./_tabs', { current: 'settings' }) %>
  <%- include('../partials/flash') %>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="glass-card">
        <div class="card-body">
          <form method="post" action="/admin/settings">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <%
              const fieldError = function (key) {
                const e = errors.find(function (x) { return x.key === key; });
                return e ? e.msg : null;
              };
              const general = Object.entries(definitions).filter(function ([, def]) { return !def.group; });
              const social = Object.entries(definitions).filter(function ([, def]) { return def.group === 'social'; });
            %>
            <% if (errors.length) { %>
              <div class="alert alert-danger" role="alert">
                <ul class="mb-0"><% errors.forEach(function (e) { %><li><%= e.msg %></li><% }) %></ul>
              </div>
            <% } %>

            <% general.forEach(function ([key, def]) { %>
              <div class="mb-4">
                <% if (def.type === 'boolean') { %>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="<%= key %>" name="<%= key %>" <%= values[key] ? 'checked' : '' %>>
                    <label class="form-check-label" for="<%= key %>"><%= def.label %></label>
                  </div>
                <% } else { %>
                  <label class="form-label" for="<%= key %>"><%= def.label %></label>
                  <input class="form-control" type="text" id="<%= key %>" name="<%= key %>"
                         value="<%= values[key] %>" maxlength="<%= def.maxLength || 255 %>">
                <% } %>
                <p class="form-text mb-0"><%= def.help %></p>
              </div>
            <% }) %>

            <% if (social.length) { %>
              <hr class="my-4">
              <h2 class="h5 card-heading"><i class="bi bi-share me-2" aria-hidden="true"></i>Social links</h2>
              <p class="small text-muted-2">
                The Hub's own accounts, shown in the social rail, the footer and on the Contact
                page. Leave a field empty to hide that icon — unless the same account is set in
                the environment, which is used when the field here is empty. The email icon
                always uses the support address.
              </p>
              <% social.forEach(function ([key, def]) { const err = fieldError(key); %>
                <div class="mb-3">
                  <label class="form-label" for="<%= key %>"><i class="bi <%= def.icon %> me-1" aria-hidden="true"></i><%= def.label %></label>
                  <input class="form-control<%= err ? ' is-invalid' : '' %>" type="url" inputmode="url" id="<%= key %>" name="<%= key %>"
                         value="<%= values[key] %>" maxlength="<%= def.maxLength %>" placeholder="https://…"
                         <% if (err) { %>aria-invalid="true" aria-describedby="<%= key %>-error"<% } %>>
                  <% if (err) { %><div class="invalid-feedback" id="<%= key %>-error"><%= err %></div><% } %>
                </div>
              <% }) %>
            <% } %>

            <button class="btn btn-primary" type="submit">Save settings</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="glass-card h-100">
        <div class="card-body">
          <h2 class="h5">What is not here</h2>
          <p class="small text-muted-2">
            Roles, modules, effort baselines and day rates are not settings. They live in
            <span class="font-monospace">config/*.js</span> under version control, where a
            change has an author, a diff and a review — and where the boot assertions can
            refuse an inconsistent one before anybody sees a wrong number.
          </p>
          <p class="small text-muted-2 mb-0">
            The minimum sample for the rate index is an environment variable for the same
            reason: lowering it makes a sparse index look fuller, so it should take a
            deployment with a diff behind it, not a checkbox.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
</section>

<%- include('../partials/layout-end') %>
