<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', {
  icon: 'bi-bug',
  heading: 'Error log',
  sub: 'What the error handler recorded, newest first.'
}) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('./_tabs', { current: 'errors' }) %>
  <%- include('../partials/flash') %>

  <div class="glass-card mb-4">
    <div class="card-body">
      <form class="row g-2 align-items-end" method="get" action="/admin/errors">
        <div class="col-md-4">
          <label class="form-label" for="q">Search the message or the path</label>
          <input class="form-control" type="search" id="q" name="q" maxlength="200" value="<%= filters.q %>">
        </div>
        <div class="col-md-2">
          <label class="form-label" for="status_code">Status</label>
          <%#
            Only the codes this table actually holds. A dropdown of every HTTP status would
            be mostly options that match nothing, and there is no "error type" column here
            to offer instead — inventing a category would mean guessing at one.
          -%>
          <select class="form-select" id="status_code" name="status_code">
            <option value="">Any</option>
            <% statusCodes.forEach(function (c) { %>
              <option value="<%= c %>" <%= String(filters.statusCode) === String(c) ? 'selected' : '' %>><%= c %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="from">From</label>
          <input class="form-control" type="date" id="from" name="from" value="<%= filters.from %>">
        </div>
        <div class="col-md-2">
          <label class="form-label" for="to">To</label>
          <%# Inclusive of the day typed — see the note in ErrorLog.buildFilter. -%>
          <input class="form-control" type="date" id="to" name="to" value="<%= filters.to %>">
        </div>
        <div class="col-md-2 d-grid gap-2">
          <button class="btn btn-primary" type="submit">Filter</button>
          <a class="btn btn-outline-secondary btn-sm" href="/admin/errors">Clear</a>
        </div>
      </form>
      <div class="d-flex flex-wrap gap-2 mt-3">
        <a class="btn btn-outline-secondary btn-sm"
           href="/admin/errors/export.csv?<%= new URLSearchParams(query).toString() %>">Export these</a>
        <span class="form-text">
          <strong><%= pagination.total %></strong> match. The export leaves out the stack
          trace — it is the one field that can carry a value from the request behind it.
        </span>
      </div>
    </div>
  </div>

  <% if (topPaths.length) { %>
    <%#
      One repeated path is the difference between "the site is broken" and "one route is
      broken", and a page of fifty rows that are all the same path reads as the former.
      These are the top paths of WHAT IS FILTERED, through the same builder as the table.
    -%>
    <div class="glass-card mb-4">
      <div class="card-body">
        <h2 class="h6 mb-3">Where they are</h2>
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead><tr><th>Path</th><th class="text-end">Errors</th><th>Last</th></tr></thead>
            <tbody>
              <% topPaths.forEach(function (t) { %>
                <tr>
                  <td class="small font-monospace"><%= t.path %></td>
                  <td class="text-end"><%= t.total %></td>
                  <td class="small text-muted-2"><%= new Date(t.last_seen).toLocaleString('en-GB') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>

  <% if (currentUser && currentUser.isSuperadmin) { %>
    <div class="glass-card mb-4">
      <div class="card-body">
        <form class="row g-2 align-items-end" method="post" action="/admin/errors/purge">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-md-4">
            <label class="form-label" for="days">Remove entries older than</label>
            <select class="form-select" id="days" name="days">
              <option value="30">30 days</option>
              <option value="90" selected>90 days</option>
              <option value="180">180 days</option>
              <option value="365">a year</option>
            </select>
          </div>
          <div class="col-md-4">
            <button class="btn btn-outline-danger" type="submit">Purge</button>
          </div>
          <div class="col-12">
            <p class="small text-muted-2 mb-0">
              The only action on this screen that cannot be undone. The window is checked
              against these four values rather than taken as a number, because a zero would
              delete everything.
            </p>
          </div>
        </form>
      </div>
    </div>
  <% } %>

  <% if (!errors.length) { %>
    <div class="glass-card"><div class="card-body text-center py-5">
      <span class="icon-tile icon-navy mb-3"><i class="bi bi-check2-circle"></i></span>
      <p class="text-muted-2 mb-0">Nothing logged.</p>
    </div></div>
  <% } else { %>
    <div class="glass-card">
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr>
              <th scope="col">When</th>
              <th scope="col">Status</th>
              <th scope="col">Where</th>
              <th scope="col">Message</th>
            </tr>
          </thead>
          <tbody>
            <% errors.forEach(function (e) { %>
              <tr>
                <td class="small text-muted-2 text-nowrap"><%= new Date(e.created_at).toLocaleString('en-GB') %></td>
                <td><span class="badge text-bg-<%= e.status_code >= 500 ? 'danger' : 'secondary' %>"><%= e.status_code %></span></td>
                <td class="small"><%= e.method %> <%= e.path %></td>
                <td class="small"><%= e.message %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <%- include('../partials/pagination') %>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
