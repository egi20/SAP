<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', {
  icon: 'bi-people',
  heading: 'Users',
  sub: 'Roles, access and verification.'
}) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('./_tabs', { current: 'users' }) %>
  <%- include('../partials/flash') %>

  <div class="glass-card mb-4">
    <div class="card-body">
      <form class="row g-2 align-items-end" method="get" action="/admin/users">
        <div class="col-md-6">
          <label class="form-label" for="q">Search name or email</label>
          <input class="form-control" type="search" id="q" name="q" value="<%= query.q || '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label" for="role">Role</label>
          <select class="form-select" id="role" name="role">
            <option value="">Any</option>
            <% roles.forEach(function (r) { %>
              <option value="<%= r %>" <%= query.role === r ? 'selected' : '' %>><%= r %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-2 d-grid">
          <button class="btn btn-primary" type="submit">Filter</button>
        </div>
      </form>
    </div>
  </div>

  <% if (!users.length) { %>
    <div class="glass-card"><div class="card-body text-center py-5">
      <p class="text-muted-2 mb-0">No account matches that.</p>
    </div></div>
  <% } else { %>
    <div class="glass-card">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th scope="col">Account</th>
              <th scope="col">Roles</th>
              <th scope="col">State</th>
              <th scope="col" class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function (u) { %>
              <%
                 // Derived in the route by User.rolesOf — see the note there.
                 const theirRoles = u.roles || [];
                 const isSelf = currentUser && currentUser.id === u.id;
              %>
              <tr>
                <td>
                  <div><%= u.name %><% if (isSelf) { %> <span class="badge text-bg-secondary">you</span><% } %></div>
                  <div class="small text-muted-2"><%= u.email %></div>
                  <div class="small text-muted-2">joined <%= new Date(u.created_at).toLocaleDateString('en-GB') %></div>
                </td>
                <td>
                  <% theirRoles.forEach(function (r) { %>
                    <span class="badge text-bg-light border me-1"><%= r %></span>
                  <% }) %>
                  <% if (u.is_superadmin) { %><span class="badge text-bg-dark">superadmin</span><% } %>
                </td>
                <td>
                  <% if (u.is_active) { %>
                    <span class="badge text-bg-success">active</span>
                  <% } else { %>
                    <span class="badge text-bg-danger">deactivated</span>
                  <% } %>
                  <% if (u.email_verified) { %>
                    <span class="badge text-bg-light border">verified</span>
                  <% } else { %>
                    <span class="badge text-bg-warning">unverified</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <% if (!u.email_verified) { %>
                    <form class="d-inline" method="post" action="/admin/users/<%= u.id %>/verify">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-outline-secondary" type="submit">Mark verified</button>
                    </form>
                  <% } %>

                  <% if (currentUser && currentUser.isSuperadmin && !isSelf) { %>
                    <form class="d-inline" method="post" action="/admin/users/<%= u.id %>/active">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <% if (u.is_active) { %>
                        <button class="btn btn-sm btn-outline-danger" type="submit">Deactivate</button>
                      <% } else { %>
                        <input type="hidden" name="is_active" value="on">
                        <button class="btn btn-sm btn-outline-success" type="submit">Reactivate</button>
                      <% } %>
                    </form>

                    <button class="btn btn-sm btn-outline-primary" type="button"
                            data-bs-toggle="collapse" data-bs-target="#roles-<%= u.id %>"
                            aria-expanded="false" aria-controls="roles-<%= u.id %>">Roles</button>
                  <% } %>
                </td>
              </tr>

              <% if (currentUser && currentUser.isSuperadmin && !isSelf) { %>
                <tr class="collapse" id="roles-<%= u.id %>">
                  <td colspan="4" class="bg-body-tertiary">
                    <form class="row g-2 align-items-end" method="post" action="/admin/users/<%= u.id %>/roles">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <div class="col-md-7">
                        <span class="form-label d-block">Roles</span>
                        <% roles.forEach(function (r) { %>
                          <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="roles" value="<%= r %>"
                                   id="role-<%= u.id %>-<%= r %>" <%= theirRoles.includes(r) ? 'checked' : '' %>>
                            <label class="form-check-label" for="role-<%= u.id %>-<%= r %>"><%= r %></label>
                          </div>
                        <% }) %>
                      </div>
                      <div class="col-md-3">
                        <label class="form-label" for="primary-<%= u.id %>">Primary</label>
                        <select class="form-select form-select-sm" id="primary-<%= u.id %>" name="primary">
                          <% roles.forEach(function (r) { %>
                            <option value="<%= r %>" <%= u.user_type === r ? 'selected' : '' %>><%= r %></option>
                          <% }) %>
                        </select>
                      </div>
                      <div class="col-md-2 d-grid">
                        <button class="btn btn-sm btn-primary" type="submit">Save roles</button>
                      </div>
                      <div class="col-12">
                        <p class="small text-muted-2 mb-0">
                          This is the only place a role can be removed or a privileged one granted.
                          It takes effect on that account’s next request.
                        </p>
                      </div>
                    </form>
                  </td>
                </tr>
              <% } %>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <%- include('../partials/pagination') %>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
