<%#
  The Sales agents tab of /admin/referrals, as on dynamicshub.net: the Hub's own people, each
  with a personal sign-up link that is MEASURED and pays nothing. Locals: agents, direct,
  agentPeople, linkFor, agentCountries, directCountries, overallCountries, countryLabel, geoNote.
  The per-agent country modals are rendered by _sales-agent-modals.ejs, outside the section.
%>
<%
  // Never rounds a part up to the whole or down to nothing: 266 of 267 is not "100%".
  const pct = function (n, d) {
    if (!(d > 0)) return '—';
    const r = Math.round((n / d) * 100);
    if (r === 100 && n < d) return '>99%';
    if (r === 0 && n > 0) return '<1%';
    return r + '%';
  };
  const day = function (d) { return d ? new Date(d).toISOString().slice(0, 10) : '—'; };
  const roleOf = function (p) { return [p.is_consultant ? 'consultant' : null, p.is_company ? 'company' : null].filter(Boolean).join(' + ') || '—'; };
  const agentSignups = agents.reduce(function (sum, a) { return sum + a.signups; }, 0);
%>

<div class="glass-card mb-4"><div class="card-body">
  <h2 class="h6 mb-1"><i class="bi bi-person-plus me-1"></i>Add a sales agent</h2>
  <p class="small text-muted-2 mb-3">
    Promote an existing account. They get a personal link, <code>/s/&lt;code&gt;</code>, that lands on
    sign-up; everybody who registers after opening it is credited to them. <strong>Agents earn no
    commission</strong> — the link is measured, not paid. A person who should be paid per
    introduction belongs on the Referrers tab. Promoting changes nothing about the account's roles.
  </p>
  <form method="post" action="/admin/referrals/agents/add" class="row g-2 align-items-end">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="col-md-9">
      <label class="form-label small" for="agent-email">Account email</label>
      <input class="form-control" id="agent-email" name="email" type="email" required autocomplete="off" placeholder="colleague@saphub.net">
    </div>
    <div class="col-md-3"><button class="btn btn-primary w-100" type="submit">Add sales agent</button></div>
  </form>
</div></div>

<div class="glass-card mb-3">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead>
        <tr>
          <th>Agent</th>
          <th>Link</th>
          <th class="text-end" title="People, once per browser session; link previews and robots are not counted">Opens</th>
          <th class="text-end" title="Opens in the last 24 hours. Counted from 28 October 2026; earlier opens carry no time">Opened (24h)</th>
          <th class="text-end">Signed up</th>
          <th class="text-end" title="Accounts registered through this link in the last 24 hours">Signed up (24h)</th>
          <th title="The country most of these sign-ups are from. Click it for the full split and the people">Top country</th>
          <th class="text-end" title="Sign-ups as a share of opens">Rate</th>
          <th class="text-end">Verified</th>
          <th>Last sign-up</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!agents.length) { %>
          <tr><td colspan="11" class="text-muted-2">No sales agents yet. Add one above.</td></tr>
        <% } %>
        <% agents.forEach(function (a) { %>
          <tr class="<%= a.is_active ? '' : 'text-muted-2' %>">
            <td>
              <%= a.name || a.email %>
              <% if (!a.is_active) { %><span class="badge-hub muted">paused</span><% } %>
              <% if (!a.account_active) { %><span class="badge-hub muted">account inactive</span><% } %>
              <span class="small text-muted-2 d-block"><%= a.email %></span>
            </td>
            <td>
              <code class="small"><%= linkFor(a.code) %></code>
              <button type="button" class="btn btn-sm btn-link p-0 ms-1" data-copy="<%= linkFor(a.code) %>" aria-label="Copy the link"><i class="bi bi-clipboard"></i></button>
            </td>
            <td class="text-end"><%= a.link_opens %></td>
            <td class="text-end"><%= a.opens_24h %></td>
            <td class="text-end">
              <strong><%= a.signups %></strong>
              <% if (a.signups) { %><span class="small text-muted-2 d-block"><%= a.consultants %> consultant · <%= a.companies %> company</span><% } %>
            </td>
            <td class="text-end"><%= a.signups_24h %></td>
            <td><%- include('./_top-country', { geo: agentCountries[a.user_id], modalId: 'agent-countries-' + a.user_id }) %></td>
            <td class="text-end"><%= pct(a.signups, a.link_opens) %></td>
            <td class="text-end"><%= a.verified %></td>
            <td class="small text-nowrap"><%= day(a.last_signup) %></td>
            <td class="text-end">
              <form method="post" action="/admin/referrals/agents/<%= a.user_id %>/active" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="is_active" value="<%= a.is_active ? 'false' : 'true' %>">
                <button class="btn btn-sm <%= a.is_active ? 'btn-outline-secondary' : 'btn-outline-success' %>" type="submit"><%= a.is_active ? 'Pause' : 'Resume' %></button>
              </form>
            </td>
          </tr>
        <% }); %>
        <%# Everybody who registered WITHOUT an agent's link, so the agents' figures have a
            denominator: the agents' sign-ups plus this row is every account. Opens and Rate
            are a dash, not 0 — with no link there was nothing to open. %>
        <tr class="table-light">
          <td>
            <strong>No agent link</strong>
            <span class="small text-muted-2 d-block"
                  title="Includes every account made any other way: organic, admin-created, QA and closed accounts">
              registered any other way<% if (direct.via_referrer) { %> — <%= direct.via_referrer %> of them through a referrer's link<% } %>
            </span>
          </td>
          <td class="text-muted-2">—</td>
          <td class="text-end text-muted-2">—</td>
          <td class="text-end text-muted-2">—</td>
          <td class="text-end">
            <strong><%= direct.signups %></strong>
            <span class="small text-muted-2 d-block"><%= pct(direct.signups, direct.all_accounts) %> of all <%= direct.all_accounts %> accounts</span>
          </td>
          <td class="text-end"><%= direct.signups_24h %></td>
          <td><%- include('./_top-country', { geo: directCountries, modalId: 'agent-countries-direct' }) %></td>
          <td class="text-end text-muted-2">—</td>
          <td class="text-end"><%= direct.verified %></td>
          <td></td>
          <td></td>
        </tr>
      </tbody>
    </table>
  </div>
  <div class="card-footer small text-muted-2">
    Agents brought in <strong><%= agentSignups %></strong> of <%= direct.all_accounts %> accounts (<%= pct(agentSignups, direct.all_accounts) %>).
    A sign-up is credited to the FIRST agent link the person opened, once; a later link never takes it.
    Opens are counted from the day an agent is added and only for something that looks like a person.
    "Last 24h" columns are a rolling 24 hours to now; opens are timed only from 28 October 2026, so
    the 24-hour opens figure has no history before that day.
    Until 28 October 2026 opens made inside the LinkedIn app were not counted (the filter took
    LinkedIn's in-app browser for its link-preview robot) while the sign-ups behind them were, so an
    older row can show more sign-ups than opens; new opens from LinkedIn are counted.
  </div>
</div>

<%# Where agent-link sign-ups come from, all agents together. The no-link population is
    NOT folded in: it has its own modal on its row, and adding it here would make this
    heading false. %>
<div class="glass-card mb-3"><div class="card-body">
  <%- include('./_country-donut', { chart: overallCountries.chart, title: 'Where agent-link sign-ups come from', subject: 'sign-ups', note: geoNote, empty: 'No agent has brought anybody in yet.' }) %>
</div></div>
