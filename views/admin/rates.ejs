<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', {
  icon: 'bi-cash-coin',
  heading: 'Rate submissions',
  sub: 'The one screen where a contributed figure is seen on its own.'
}) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('./_tabs', { current: 'rates' }) %>
  <%- include('../partials/flash') %>

  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle"></i>
    Everywhere else on the Hub a rate is only ever shown inside an aggregate over at least
    three people. This page deliberately sets that aside, which is why it is superadmin-only.
    Void a figure to take it out of every average; the row stays, so the contribution stays
    auditable. There is no way to correct a value — an aggregate whose inputs can be retyped
    is an aggregate nobody should trust.
  </div>

  <div class="glass-card mb-4">
    <div class="card-body d-flex flex-wrap gap-2">
      <a class="btn btn-sm <%= includeVoided ? 'btn-outline-secondary' : 'btn-primary' %>" href="/admin/rates">Counted</a>
      <a class="btn btn-sm <%= includeVoided ? 'btn-primary' : 'btn-outline-secondary' %>" href="/admin/rates?voided=1">Everything, voided included</a>
    </div>
  </div>

  <% if (!submissions.length) { %>
    <div class="glass-card"><div class="card-body text-center py-5">
      <p class="text-muted-2 mb-0">No submissions.</p>
    </div></div>
  <% } else { %>
    <div class="glass-card">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th scope="col">Contributor</th>
              <th scope="col">Role</th>
              <th scope="col" class="text-end">Figure</th>
              <th scope="col" class="text-end">Bucket mean</th>
              <th scope="col">Period</th>
              <th scope="col" class="text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% submissions.forEach(function (s) { %>
              <%
                /*
                 * A hint about where to look, never an automatic void. An unusually high
                 * day rate is far more often a real senior contractor than a mistake; what
                 * is worth a second look is a figure that is an order of magnitude out,
                 * which is what an annual salary typed into a day-rate field looks like.
                 */
                const mean = Number(s.bucket_mean_eur || 0);
                const outlier = mean > 0 && (s.amount_eur > mean * 5 || s.amount_eur < mean / 5);
              %>
              <tr class="<%= s.voided_at ? 'opacity-50' : '' %>">
                <td>
                  <div><%= s.contributor_name %></div>
                  <div class="small text-muted-2"><%= s.email %></div>
                </td>
                <td class="small"><%= roleLabel(s.role) %> · <%= s.seniority %></td>
                <td class="text-end">
                  <%= s.amount %> <%= s.currency %>
                  <% if (outlier) { %><span class="badge text-bg-warning ms-1" title="Far from its bucket">check</span><% } %>
                </td>
                <td class="text-end small text-muted-2"><%= mean ? Math.round(mean) + ' EUR' : '—' %></td>
                <td class="small text-muted-2"><%= s.period %></td>
                <td class="text-end">
                  <form class="d-flex gap-1 justify-content-end" method="post" action="/admin/moderation/rates/<%= s.id %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="redirectTo" value="/admin/rates">
                    <% if (s.voided_at) { %>
                      <input type="hidden" name="hidden" value="false">
                      <button class="btn btn-sm btn-outline-success" type="submit">Reinstate</button>
                    <% } else { %>
                      <input type="hidden" name="hidden" value="true">
                      <%# One of these per row, so the name goes on aria-label rather than a
                          <label for>: a hidden label would need a unique id per row to be
                          associated at all, and an unassociated label is decoration. %>
                      <input class="form-control form-control-sm" type="text" name="reason"
                             aria-label="Reason for voiding this submission"
                             placeholder="Reason" maxlength="200" style="max-width: 10rem;">
                      <button class="btn btn-sm btn-outline-danger" type="submit">Void</button>
                    <% } %>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <%- include('../partials/pagination') %>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
