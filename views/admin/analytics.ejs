<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', {
  icon: 'bi-graph-up',
  heading: 'Analytics',
  sub: 'Twelve months, counted per calendar month.'
}) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('./_tabs', { current: 'analytics' }) %>
  <%- include('../partials/flash') %>

  <%- include('./analytics-partials/nav', { current: 'site' }) %>
  <%- include('./analytics-partials/range') %>

  <%#
    The server-side panels dynamicshub.net shows under its GA charts. Counted by this
    application, so they include the visitors who decline analytics or block trackers —
    which is why they run higher than GA4. Aggregates only: a country, a day, a count.
  %>
  <% const n = function (v) { return Number(v || 0).toLocaleString('en-GB'); }; %>
  <div class="row g-3 mb-4">
    <div class="col-lg-6"><div class="glass-card h-100"><div class="card-body">
      <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
        <h2 class="h6 mb-0"><i class="bi bi-globe-americas"></i> Visitors by country <span class="badge-hub">Server-side</span></h2>
        <% if (currentUser.isSuperadmin) { %>
          <form method="post" action="/admin/analytics/reset-geo" class="m-0"
                data-confirm="Clear all collected visitor geography? It rebuilds from the next real page view, and the old figures cannot be brought back.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-arrow-counterclockwise"></i> Reset</button>
          </form>
        <% } %>
      </div>
      <p class="small text-muted-2 mb-3">
        <%= n(visitors.total) %> page views in this range, by the country of the request. Counts
        everybody who opened a page in a browser — including those who decline analytics — so it
        runs higher than GA4. Crawlers and failed requests are left out from 21 October 2026.
      </p>
      <%- include('./analytics-partials/bars', {
        rows: visitors.rows.map(function (r) { return { label: countryName(r.country) || r.country, value: r.visits, extra: visitors.total ? Math.round(100 * r.visits / visitors.total) + '%' : '—' }; }),
        valueLabel: 'Page views', extraLabel: 'Share'
      }) %>
    </div></div></div>

    <div class="col-lg-6"><div class="glass-card h-100"><div class="card-body">
      <h2 class="h6 mb-1"><i class="bi bi-person-plus"></i> Sign-ups by country</h2>
      <p class="small text-muted-2 mb-3">Accounts created in this range, by the country their sign-up came from (IP-derived, so a VPN or a trip abroad moves it). Independent of GA4 and cookie consent.</p>
      <%- include('./analytics-partials/bars', {
        rows: signups.map(function (r) { return { label: r.country ? (countryName(r.country) || r.country) : 'Unknown', value: r.signups }; }),
        valueLabel: 'Sign-ups'
      }) %>
    </div></div></div>
  </div>

  <div class="glass-card mb-4"><div class="card-body">
    <h2 class="h6 mb-1"><i class="bi bi-trophy"></i> Daily challenge <span class="badge-hub">Server-side</span></h2>
    <p class="small text-muted-2 mb-3">Distinct people who completed the daily challenge each day in this range.</p>
    <div class="row g-3 mb-3">
      <div class="col-4"><p class="stat-value mb-0"><%= n(challenges.players) %></p><p class="small mb-0">Unique players</p></div>
      <div class="col-4"><p class="stat-value mb-0"><%= n(challenges.plays) %></p><p class="small mb-0">Total plays</p></div>
      <div class="col-4"><p class="stat-value mb-0"><%= n(challenges.activeDays) %></p><p class="small mb-0">Active days</p></div>
    </div>
    <%- include('./analytics-partials/bars', {
      rows: challenges.perDay.map(function (r) { return { label: r.day, value: r.players, extra: n(r.plays) }; }),
      valueLabel: 'Players', extraLabel: 'Plays'
    }) %>
  </div></div>

  <%#
    Tax optimisation — who opens it. Counted by this application, signed-in people by name
    (superadmin only), everybody signed out as one count. An empty panel says WHICH kind of
    nothing it is showing, because a failing recorder and a quiet week look identical.
  %>
  <% const ti = taxInterest; const fmtWhen = function (d) { return d ? new Date(d).toISOString().slice(0, 16).replace('T', ' ') + ' UTC' : '—'; }; %>
  <div class="glass-card mb-4"><div class="card-body">
    <h2 class="h6 mb-1"><i class="bi bi-piggy-bank"></i> Tax optimisation — who opens it <span class="badge-hub">Server-side</span></h2>
    <p class="small text-muted-2 mb-3">
      Three steps of <a href="/tax">/tax</a>, in this range. <strong>People</strong> are signed-in
      members, each counted once however often they came back; signed-out visits are counted but
      never identified. Crawlers are left out.
    </p>

    <% if (ti.funnel) { const anon = ti.funnel[0].anonymousViews; %>
      <div class="row g-3 mb-3">
        <% ti.funnel.forEach(function (f) { %>
          <div class="col-6 col-md-3"><div class="border rounded-3 p-3 h-100">
            <p class="stat-value mb-0"><%= n(f.people) %></p>
            <p class="small mb-0"><%= f.label %></p>
            <p class="small text-muted-2 mb-0"><%= n(f.views) %> views · <%= n(f.anonymousViews) %> signed out</p>
          </div></div>
        <% }); %>
        <div class="col-6 col-md-3"><div class="border rounded-3 p-3 h-100">
          <% if (ti.applied) { %>
            <p class="stat-value mb-0"><%= n(ti.applied.applications) %></p>
            <p class="small mb-0">Applications sent</p>
            <p class="small text-muted-2 mb-0"><%= n(ti.applied.people) %> from signed-in members</p>
          <% } else { %>
            <p class="stat-value mb-0">—</p><p class="small mb-0">Applications sent</p>
          <% } %>
        </div></div>
      </div>
      <p class="small text-muted-2 mb-3" id="taxAnonNote">
        <i class="bi bi-incognito"></i> <%= n(anon) %> views of the page came from people who were not signed in —
        the names below are only the part of the audience that had an account open.
      </p>
    <% } %>

    <% if (!ti.ok) { %>
      <p class="small text-danger mb-2"><i class="bi bi-exclamation-triangle"></i>
        Part of this panel could not be read, so a missing figure is a gap, not a zero:
        <span class="font-monospace"><%= ti.errors.join(' · ') %></span></p>
    <% } %>

    <% if (ti.health) { const h = ti.health; %>
      <p class="small text-muted-2 mb-2" id="taxRecorderNote"><i class="bi bi-info-circle"></i>
        <% if (h.readError) { %>
          The recorder's table could not be read (<span class="font-monospace"><%= h.readError %></span>) — run <code>npm run migrate</code>.
        <% } else if (h.lastWrite.ok === false) { %>
          The last attempt to record a visit failed: <span class="font-monospace"><%= h.lastWrite.error %></span>.
        <% } else if (!h.rows) { %>
          Nothing has been recorded yet, in any range. Recording started with this release; open <a href="/tax">/tax</a> in a browser to see the first row.
        <% } else { %>
          Nothing in this range, but the recorder is working: <%= n(h.rows) %> rows in all, the latest <%= fmtWhen(h.lastAt) %>. Widen the range.
        <% } %>
      </p>
    <% } %>

    <% if (ti.people) { %>
      <h3 class="h6 mt-3 mb-2">Who opened it <span class="small text-muted-2">(signed-in, most recent first)</span></h3>
      <% if (!ti.people.length) { %>
        <p class="small text-muted-2 mb-0">No signed-in member opened it in this range.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead><tr><th scope="col">Person</th><th scope="col">How far they got</th><th scope="col" class="text-end">Views</th><th scope="col">Last opened</th></tr></thead>
            <tbody>
              <% ti.people.forEach(function (p) { %>
                <tr>
                  <td>
                    <a href="/admin/users?q=<%= encodeURIComponent(p.email) %>" target="_blank" rel="noopener"><%= p.name %></a>
                    <span class="small text-muted-2 d-block"><%= p.email %><%= p.active ? '' : ' · inactive' %></span>
                  </td>
                  <td>
                    <%= taxSteps[p.furthest] %>
                    <% if (p.applied) { %><a href="/admin/tax-applications" class="badge-hub ms-1">Applied</a><% } %>
                  </td>
                  <td class="text-end"><%= n(p.views) %></td>
                  <td class="small"><%= fmtWhen(p.lastAt) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    <% } else { %>
      <p class="small text-muted-2 mb-0"><i class="bi bi-shield-lock"></i> The names behind these counts are visible to superadmins only, like the tax application queue.</p>
    <% } %>
  </div></div>

  <h2 class="h6 mb-2">Growth by month</h2>

  <% if (!periods.length) { %>
    <div class="glass-card"><div class="card-body text-center py-5">
      <p class="text-muted-2 mb-0">Nothing to count yet.</p>
    </div></div>
  <% } else { %>
    <div class="glass-card">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th scope="col">Month</th>
              <% series.forEach(function (s) { %>
                <th scope="col" class="text-end"><%= s.label %></th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <%
              // Newest month first: the question this page answers is "how is it going",
              // and the answer is at the bottom of a chronological table.
              periods.slice().reverse().forEach(function (period) {
            %>
              <tr>
                <th scope="row" class="fw-normal"><%= period %></th>
                <% series.forEach(function (s) { %>
                  <td class="text-end"><%= s.byPeriod[period] || 0 %></td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <p class="small text-muted-2 mt-3 mb-0">
      Community posts exclude hidden ones and rate contributions exclude voided ones, so
      these columns agree with what the site itself shows rather than with the raw tables.
    </p>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
