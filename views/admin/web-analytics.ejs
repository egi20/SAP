<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', {
  icon: 'bi-bar-chart-line',
  heading: provider.name,
  sub: 'On trial beside the other provider. Same layout on both screens, so they can be read side by side.'
}) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('./_tabs', { current: 'analytics' }) %>
  <%- include('../partials/flash') %>

  <nav class="d-flex flex-wrap gap-2 mb-4" aria-label="Analytics screens">
    <a class="btn btn-sm btn-outline-primary" href="/admin/analytics">Site counts</a>
    <a class="btn btn-sm <%= providerKey === 'ga4' ? 'btn-primary' : 'btn-outline-primary' %>" href="/admin/analytics/ga4"<% if (providerKey === 'ga4') { %> aria-current="page"<% } %>>Google Analytics 4</a>
    <a class="btn btn-sm <%= providerKey === 'cloudflare' ? 'btn-primary' : 'btn-outline-primary' %>" href="/admin/analytics/cloudflare"<% if (providerKey === 'cloudflare') { %> aria-current="page"<% } %>>Cloudflare Web Analytics</a>
  </nav>

  <div class="glass-card mb-4"><div class="card-body">
    <h2 class="h6 mb-3">Status</h2>
    <ul class="list-unstyled mb-0">
      <li class="mb-1">
        <i class="bi <%= tagEnabled ? 'bi-check-circle text-success' : 'bi-x-circle text-danger' %>"></i>
        Tracking on the site:
        <strong><%= tagEnabled ? 'on' : 'off' %></strong>
        <% if (!tagEnabled) { %>
          <span class="text-muted-2">— set <span class="font-monospace"><%= providerKey === 'ga4' ? 'GA4_MEASUREMENT_ID' : 'CF_WEB_ANALYTICS_TOKEN' %></span> on the web service.</span>
        <% } else if (providerKey === 'ga4') { %>
          <span class="text-muted-2">— only for visitors who press "Allow analytics".</span>
        <% } else { %>
          <span class="text-muted-2">— for every visitor; it sets no cookie.</span>
        <% } %>
      </li>
      <li>
        <i class="bi <%= reportingEnabled ? 'bi-check-circle text-success' : 'bi-x-circle text-danger' %>"></i>
        Reports on this screen:
        <strong><%= reportingEnabled ? 'on' : 'off' %></strong>
        <% if (!reportingEnabled) { %>
          <span class="text-muted-2">— set
            <% if (providerKey === 'ga4') { %>
              <span class="font-monospace">GA4_PROPERTY_ID</span> and <span class="font-monospace">GA4_SERVICE_ACCOUNT_JSON</span>.
            <% } else { %>
              <span class="font-monospace">CF_ACCOUNT_ID</span> and <span class="font-monospace">CF_API_TOKEN</span>.
            <% } %>
          </span>
        <% } %>
      </li>
    </ul>
    <p class="small text-muted-2 mt-3 mb-0">
      The full reports are in the provider's own dashboard:
      <a href="<%= provider.dashboardUrl %>" rel="noopener" target="_blank"><%= provider.name %></a>.
    </p>
  </div></div>

  <% if (reportingEnabled) { %>
    <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Date range">
      <% ranges.forEach(function (r) { %>
        <a class="btn btn-sm <%= r === days ? 'btn-primary' : 'btn-outline-secondary' %>" href="?days=<%= r %>"<% if (r === days) { %> aria-current="true"<% } %>>Last <%= r %> days</a>
      <% }) %>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle"></i>
        The provider refused the request, so there are no figures to show:
        <span class="font-monospace"><%= error %></span>
      </div>
    <% } else if (report) { %>
      <% if (report.totals[0].value === 0) { %>
        <div class="alert alert-warning">
          <p class="mb-2">
            <i class="bi bi-info-circle"></i>
            The request worked and there are no page views for this range<% if (report.filteredBy) { %>, filtered by <span class="font-monospace"><%= report.filteredBy %></span><% } %>.
          </p>
          <% if (providerKey === 'cloudflare') { %>
            <% if (report.seenError) { %>
              <p class="mb-0">Could not ask Cloudflare what else it has: <span class="font-monospace"><%= report.seenError %></span></p>
            <% } else if (report.seen && report.seen.length) { %>
              <p class="mb-1"><strong>Cloudflare does have page loads in this account, for:</strong></p>
              <ul class="mb-2">
                <% report.seen.forEach(function (row) { %>
                  <li><span class="font-monospace"><%= row.host %></span> — <%= row.value.toLocaleString('en-GB') %> page views<% if (row.siteTag) { %> (site tag <span class="font-monospace"><%= row.siteTag %></span>)<% } %></li>
                <% }); %>
              </ul>
              <p class="mb-0">So the beacon works and this screen is asking for a different site. If one of these is SAP Hub, set
                <span class="font-monospace">CF_WEB_ANALYTICS_SITE_TAG</span> to its site tag on the web service, or make
                <span class="font-monospace">APP_BASE_URL</span> use that host.</p>
            <% } else { %>
              <p class="mb-0"><strong>Cloudflare has no page loads at all in this account for this range</strong>, so the
                beacon is not reaching it. Check that <span class="font-monospace">CF_ACCOUNT_ID</span> is the account
                where saphub.net was added to Web Analytics, that <span class="font-monospace">CF_WEB_ANALYTICS_TOKEN</span>
                is that site's token, and test in a browser without a tracker blocker — Opera, Brave and uBlock Origin never send it.</p>
            <% } %>
          <% } else { %>
            <p class="mb-0">GA4 counts nobody until they press "Allow analytics", ignores visitors with a tracker blocker,
              and its reports lag by up to a day.</p>
          <% } %>
        </div>
      <% } %>
      <% if (report.sampleInterval) { %>
        <div class="alert alert-info">
          <i class="bi bi-info-circle"></i>
          Cloudflare <strong>samples</strong> page loads: each one it recorded here stands for about
          <strong><%= report.sampleInterval %></strong>, so every figure moves in steps of
          <%= report.sampleInterval %>. On a site this quiet the numbers are estimates, not counts —
          <%= report.totals[0].value %> page views means roughly <%= Math.round(report.totals[0].value / report.sampleInterval) %> were actually recorded.
        </div>
      <% } %>
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
          <div class="glass-card h-100"><div class="card-body">
            <p class="stat-value mb-0"><%= serverViews.toLocaleString('en-GB') %></p>
            <p class="mb-0">SAP Hub's own count</p>
            <p class="small text-muted-2 mb-0">page views the server itself counted in the same days — the yardstick</p>
          </div></div>
        </div>
        <% report.totals.forEach(function (t) { %>
          <div class="col-6 col-md-4">
            <div class="glass-card h-100"><div class="card-body">
              <p class="stat-value mb-0"><%= t.value.toLocaleString('en-GB') %></p>
              <p class="mb-0"><%= t.label %></p>
            </div></div>
          </div>
        <% }) %>
      </div>

      <div class="row g-3">
        <% [
          { key: 'pages', heading: 'Top pages' },
          { key: 'countries', heading: 'Countries' },
          { key: 'sources', heading: 'Where visitors came from' },
          { key: 'devices', heading: 'Devices' }
        ].forEach(function (block) { %>
          <div class="col-lg-6">
            <div class="glass-card h-100"><div class="card-body">
              <h2 class="h6 mb-3"><%= block.heading %></h2>
              <% if (!report[block.key].length) { %>
                <p class="text-muted-2 mb-0">Nothing recorded in this range.</p>
              <% } else { %>
                <table class="table table-sm align-middle mb-0">
                  <tbody>
                    <% report[block.key].forEach(function (row) { %>
                      <tr>
                        <td class="text-break"><%= block.key === 'countries' && providerKey === 'cloudflare' ? (countryName(row.label) || row.label) : row.label %></td>
                        <td class="text-end"><%= row.value.toLocaleString('en-GB') %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              <% } %>
            </div></div>
          </div>
        <% }) %>
      </div>

      <p class="small text-muted-2 mt-3 mb-0">
        <% if (providerKey === 'ga4') { %>
          GA4 counts only visitors who allowed analytics, so its totals sit below
          Cloudflare's by however many declined. Lists are ranked by page views (pages),
          users (countries, devices) and sessions (sources).
        <% } else { %>
          Cloudflare counts every visitor with scripting on, sets no cookie and has no
          notion of a returning user, so "visits" is not the same figure as GA4's "users".
          Page views are the one number both define the same way.
        <% } %>
        Figures are cached for ten minutes.
      </p>
    <% } %>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
