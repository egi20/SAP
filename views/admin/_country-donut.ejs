<%#
  "By country" ring beside a ranked legend, as on dynamicshub.net's sales-agent tab.
  Locals: chart (utils/donutSlices), title, subject, note, empty.
  Every label is escaped by EJS; colours come from the util, never from the request.
%>
<%
  const _c = chart || { slices: [], total: 0, distinct: 0, hasData: false };
  const _title = typeof title !== 'undefined' && title ? title : 'By country';
  const _subject = typeof subject !== 'undefined' && subject ? subject : 'sign-ups';
  const _note = typeof note !== 'undefined' ? note : '';
  const _empty = typeof empty !== 'undefined' && empty ? empty : 'Nothing to show yet.';
%>
<div class="country-donut">
  <div class="d-flex align-items-baseline flex-wrap gap-2 mb-2">
    <span class="fw-semibold"><i class="bi bi-globe2 me-1 text-muted-2"></i><%= _title %></span>
    <% if (_c.hasData) { %>
      <span class="small text-muted-2"><%= _c.total %> <%= _c.total === 1 ? _subject.replace(/s$/, '') : _subject %> · <%= _c.distinct %> <%= _c.distinct === 1 ? 'country' : 'countries' %></span>
    <% } %>
  </div>
  <% if (_note) { %><p class="small text-muted-2 mb-2"><%= _note %></p><% } %>
  <% if (!_c.hasData) { %>
    <div class="small text-muted-2 py-2"><%= _empty %></div>
  <% } else { %>
    <div class="d-flex align-items-center gap-3 flex-wrap">
      <svg viewBox="0 0 42 42" class="cd-ring" width="132" height="132" role="img"
           aria-label="<%= _title %>: <%= _c.slices.map(function (s) { return s.label + ' ' + s.display + '%'; }).join(', ') %>">
        <circle class="cd-track" cx="21" cy="21" r="15.9155" fill="none" stroke-width="5"></circle>
        <% _c.slices.forEach(function (s) { %>
          <circle cx="21" cy="21" r="15.9155" fill="none" stroke="<%= s.color %>" stroke-width="5" pathLength="100"
                  stroke-dasharray="<%= s.dash %> <%= s.gap %>" stroke-dashoffset="<%= s.offset %>" transform="rotate(-90 21 21)">
            <title><%= s.label %>: <%= s.count %> (<%= s.display %>%)</title>
          </circle>
        <% }); %>
        <text x="21" y="20.2" text-anchor="middle" class="cd-total"><%= _c.total %></text>
        <text x="21" y="24.6" text-anchor="middle" class="cd-total-label"><%= _subject %></text>
      </svg>
      <ul class="list-unstyled mb-0 cd-legend">
        <% _c.slices.forEach(function (s) { %>
          <li class="cd-row">
            <span class="cd-dot" style="background:<%= s.color %>"></span>
            <span class="cd-name text-truncate" title="<%= s.isOther && s.members ? s.members.map(function (m) { return m.label + ' ' + m.count; }).join(', ') : s.label %>"><%= s.label %></span>
            <span class="cd-count"><%= s.count %></span>
            <span class="cd-pct text-muted-2"><%= s.display %>%</span>
          </li>
        <% }); %>
      </ul>
    </div>
  <% } %>
</div>
