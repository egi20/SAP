<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', {
  icon: 'bi-search',
  heading: 'Search',
  sub: 'Jobs, consultants, companies, agencies and the community.'
}) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <form class="glass-card mb-4" method="get" action="/search">
    <div class="card-body">
      <label class="visually-hidden" for="q">What are you looking for?</label>
      <div class="input-group input-group-lg">
        <input class="form-control" id="q" name="q" type="search" maxlength="120"
               value="<%= results.query %>" placeholder="EWM, S/4HANA finance, Munich, a company name…"
               autofocus>
        <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Search</button>
      </div>
    </div>
  </form>

  <% if (!results.usable) { %>
    <div class="glass-card">
      <div class="card-body text-center py-5">
        <span class="icon-tile icon-navy mb-3"><i class="bi bi-search"></i></span>
        <% if (results.query.length) { %>
          <h2 class="h6">Type a little more</h2>
          <p class="text-muted-2 mb-0">
            At least <%= minLength %> characters. Anything shorter matches most of the site and
            tells you nothing.
          </p>
        <% } else { %>
          <h2 class="h6">One box, five places</h2>
          <p class="text-muted-2 mb-0">
            Open roles, public consultant profiles, companies, recruitment agencies and community posts.
          </p>
        <% } %>
      </div>
    </div>
  <% } else { %>

    <p class="text-muted-2 mb-4">
      <%
        /*
         * The total is a SUM of what each source reported, not a relevance figure and not
         * deduplicated across types: a job and the company that posted it are two results,
         * because they are two things somebody might have been looking for.
         */
      %>
      <strong><%= results.total %></strong> result<%= results.total === 1 ? '' : 's' %>
      for “<%= results.query %>”.
    </p>

    <%
      const catalogueHits = catalogue.modules.length + catalogue.roles.length + catalogue.lines.length;
    %>
    <% if (catalogueHits) { %>
      <%#
        What the query NAMES in the SAP catalogue, and where it lives on the site. Shown even
        when every listing is empty, which is exactly when it matters: "0 results for EWM"
        from a site whose filters all know EWM reads as a site that does not.
      %>
      <div class="glass-card glass-card-tinted mb-4">
        <div class="card-body">
          <h2 class="h6 mb-1"><i class="bi bi-diagram-3"></i> In the SAP catalogue</h2>
          <% if (results.total === 0) { %>
            <p class="small text-muted-2 mb-3">
              Nothing listed mentions “<%= results.query %>” yet — these are the places it will
              appear when something does.
            </p>
          <% } else { %>
            <p class="small text-muted-2 mb-3">The modules and roles this names, and where to find them.</p>
          <% } %>
          <ul class="list-unstyled mb-0">
            <% catalogue.lines.forEach(function (line) { %>
              <li class="py-1">
                <strong><%= line.label %></strong>
                <span class="small text-muted-2">· product line ·</span>
                <a class="small" href="/community/category/<%= line.value %>">community</a>
              </li>
            <% }); %>
            <% catalogue.modules.forEach(function (m) { %>
              <li class="py-1">
                <strong><%= m.label %></strong>
                <span class="small text-muted-2">· <%= m.lineLabel %> ·</span>
                <a class="small" href="<%= m.jobsHref %>">jobs</a>,
                <a class="small" href="<%= m.consultantsHref %>">consultants who have delivered it</a>
              </li>
            <% }); %>
            <% catalogue.roles.forEach(function (r) { %>
              <li class="py-1">
                <strong><%= r.label %></strong>
                <span class="small text-muted-2">· role ·</span>
                <a class="small" href="<%= r.jobsHref %>">jobs</a>,
                <a class="small" href="<%= r.consultantsHref %>">consultants</a><% if (r.ratesHref) { %>,
                <a class="small" href="<%= r.ratesHref %>">day rates</a><% } %>
              </li>
            <% }); %>
          </ul>
        </div>
      </div>
    <% } %>

    <% if (results.total === 0 && !catalogueHits) { %>
      <div class="glass-card mb-4">
        <div class="card-body">
          <h2 class="h6">Nothing matched</h2>
          <p class="text-muted-2 mb-0">
            Try fewer words, or browse directly:
            <a href="/jobs">jobs</a>, <a href="/consultants">consultants</a>,
            <a href="/companies">companies</a>, <a href="/recruiters">agencies</a>,
            <a href="/community">the community</a>.
          </p>
        </div>
      </div>
    <% } %>

    <% results.groups.forEach(function (group) { %>
      <% if (group.failed || group.total > 0) { %>
        <div class="glass-card mb-4">
          <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="h6 mb-0">
              <i class="bi <%= group.icon %>"></i> <%= group.label %>
              <% if (!group.failed) { %>
                <span class="badge-hub"><%= group.total %></span>
              <% } %>
            </h2>
            <% if (!group.failed && group.total > group.rows.length) { %>
              <a class="btn btn-sm btn-outline-primary" href="<%= group.href %>">
                See all <%= group.total %>
              </a>
            <% } %>
          </div>

          <div class="card-body">
            <% if (group.failed) { %>
              <%
                /*
                 * One source failing is a missing section with a note, never a failed page.
                 * Saying so is better than quietly showing nothing, which reads as "no
                 * results" and is a different claim.
                 */
              %>
              <p class="text-muted-2 mb-0">
                <i class="bi bi-exclamation-triangle"></i>
                This section could not be searched just now. The rest of the results are complete.
              </p>

            <% } else if (group.key === 'jobs') { %>
              <% group.rows.forEach(function (job) { %>
                <%- include('../partials/job-card', { job }) %>
              <% }); %>

            <% } else if (group.key === 'consultants') { %>
              <div class="row g-3">
                <% group.rows.forEach(function (c) { %>
                  <div class="col-md-6"><%- include('../partials/consultant-card', { c }) %></div>
                <% }); %>
              </div>

            <% } else if (group.key === 'recruiters') { %>
              <ul class="list-unstyled mb-0">
                <% group.rows.forEach(function (agency) { %>
                  <li class="d-flex align-items-center gap-3 border-top py-2">
                    <img class="logo-tile flex-shrink-0" src="<%= agency.logo || '/images/logo-placeholder.svg' %>" alt="" loading="lazy">
                    <div class="min-w-0">
                      <a href="/recruiters/<%= agency.slug %>"><strong><%= agency.agency_name %></strong></a>
                      <% if (agency.tagline) { %>
                        <div class="small text-muted-2"><%= agency.tagline %></div>
                      <% } %>
                    </div>
                  </li>
                <% }); %>
              </ul>

            <% } else if (group.key === 'companies') { %>
              <ul class="list-unstyled mb-0">
                <% group.rows.forEach(function (company) { %>
                  <li class="d-flex align-items-center gap-3 border-top py-2">
                    <img class="logo-tile flex-shrink-0" src="<%= company.logo || '/images/logo-placeholder.svg' %>" alt="" loading="lazy">
                    <div class="min-w-0">
                      <a href="/companies/<%= company.slug %>"><strong><%= company.company_name %></strong></a>
                      <% if (company.open_jobs > 0) { %>
                        <span class="badge-hub ok"><%= company.open_jobs %> open</span>
                      <% } %>
                      <% if (company.tagline) { %>
                        <div class="small text-muted-2"><%= company.tagline %></div>
                      <% } %>
                    </div>
                  </li>
                <% }); %>
              </ul>

            <% } else { %>
              <ul class="list-unstyled mb-0">
                <% group.rows.forEach(function (post) { %>
                  <li class="border-top py-2">
                    <a href="/community/<%= post.slug %>"><strong><%= post.title %></strong></a>
                    <span class="badge-hub"><%= post.kind %></span>
                    <div class="small text-muted-2">
                      <%= toPlainText(post.body, 140) %>
                    </div>
                  </li>
                <% }); %>
              </ul>
            <% } %>
          </div>
        </div>
      <% } %>
    <% }); %>

    <%
      /*
       * Sources that matched nothing are listed together at the end rather than each
       * getting an empty card. Four empty panels is noise; one line saying which places
       * were looked in and came back empty is information.
       */
      const emptyGroups = results.groups.filter(function (g) { return !g.failed && g.total === 0; });
    %>
    <% if (emptyGroups.length && results.total > 0) { %>
      <p class="small text-muted-2">
        Nothing in
        <%= emptyGroups.map(function (g) { return g.label.toLowerCase(); }).join(', ') %>.
      </p>
    <% } %>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
