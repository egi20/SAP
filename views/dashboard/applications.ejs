<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { icon: 'bi-send', heading: 'Your applications', sub: 'Every role you have applied for and where it stands.' }) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <% if (applications.length === 0) { %>
    <div class="empty-state glass-card"><i class="bi bi-send"></i>
      <p class="mb-1">You have not applied for anything yet.</p>
      <a href="/jobs">Browse open roles</a>
    </div>
  <% } else { %>
    <div class="table-responsive glass-card">
      <table class="table align-middle mb-0">
        <thead><tr><th>Role</th><th>Company</th><th>Status</th><th>Updated</th><th></th></tr></thead>
        <tbody>
          <% applications.forEach(function (a) { %>
            <tr>
              <td><a href="/jobs/<%= a.job_slug %>"><%= a.job_title %></a></td>
              <td class="text-muted-2"><%= a.company_name || 'Confidential' %></td>
              <td><span class="badge-hub status-<%= a.status %>"><%= a.status %></span></td>
              <td class="small text-muted-2"><%= new Date(a.updated_at).toISOString().slice(0, 10) %></td>
              <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/applications/<%= a.id %>">Open</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
