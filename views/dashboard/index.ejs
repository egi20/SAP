<%- include('../partials/layout-start') %>

<section class="glass-section pb-5 pt-4">
<div class="container">
  <%#
    The welcome banner, as on dynamicshub.net: who you are signed in as, which roles the
    account holds, and the way into the admin panel for those who have one. It replaces the
    "Welcome back" flash the sign-in used to leave, so the greeting is not said twice.
  %>
  <div class="dashboard-welcome mb-4">
    <div>
      <h1 class="h3 mb-1">Welcome back, <%= currentUser.name %></h1>
      <p class="mb-0">Here's what's happening with your account today.</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
      <% badges.forEach(function (b) { %>
        <span class="dashboard-role-badge"><%= b %></span>
      <% }); %>
      <% if (currentUser.isAdmin) { %>
        <a class="btn btn-outline-light btn-sm ms-lg-2" href="/admin"><i class="bi bi-gear"></i> Admin Panel</a>
      <% } %>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <% if (!currentUser.emailVerified) { %>
    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2">
      <span>Confirm your email to apply for roles and contribute rates.</span>
      <form method="post" action="/auth/resend-verification" class="ms-auto">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-sm btn-outline-primary" type="submit">Resend confirmation</button>
      </form>
    </div>
  <% } %>

  <% if (!consultant && !company) { %>
    <%#
      An account with neither marketplace role — an administrator, typically — rendered this
      page as a header over nothing. A page with nothing under its heading reads as one that
      failed to load, so it says what the dashboard is for and offers the switch that fills it.
    %>
    <div class="glass-card mb-4"><div class="card-body">
      <h2 class="h5">Nothing on your dashboard yet</h2>
      <p class="text-muted-2">
        The dashboard shows a consultant's profile, matches and applications, and a company's
        adverts. This account has neither role yet. Add one under
        <a href="/profile/settings#roles">What you use the Hub for</a> and it fills in here.
      </p>
      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary btn-sm" href="/profile/settings#roles">Add a role</a>
        <% if (currentUser.isAdmin) { %>
          <a class="btn btn-outline-primary btn-sm" href="/admin">Open the admin panel</a>
        <% } %>
      </div>
    </div></div>
  <% } %>

  <% if (tabs.length > 1) { %>
    <nav class="dashboard-tabs mb-4" aria-label="Dashboard sections">
      <% tabs.forEach(function (t) { %>
        <a class="dashboard-tab<%= t.key === activeTab.key ? ' active' : '' %>" href="/dashboard?tab=<%= t.key %>"<% if (t.key === activeTab.key) { %> aria-current="page"<% } %>>
          <i class="bi <%= t.icon %>"></i> <%= t.label %>
        </a>
      <% }); %>
    </nav>
  <% } %>

  <div class="row g-4 mb-5">
    <% activeTab.tiles.forEach(function (tile) { %>
      <div class="col-sm-6 col-lg-4">
        <div class="dashboard-tile h-100">
          <span class="icon-tile <%= tile.tone %> mb-3"><i class="bi <%= tile.icon %>"></i></span>
          <h2 class="h5 mb-1"><%= tile.title %></h2>
          <p class="text-muted-2 small mb-3"><%= tile.text %></p>
          <a class="btn btn-sm <%= tile.primary ? 'btn-primary' : 'btn-outline-primary' %> mt-auto" href="<%= tile.href %>"><%= tile.cta %></a>
        </div>
      </div>
    <% }); %>
  </div>

  <% if (consultant && activeTab.key === 'consultant') { %>
    <section class="mb-5">
      <h2 class="h5 mb-3">Your consultant activity</h2>

      <p class="small mb-3"><a href="/consultants/<%= currentUser.id %>"><i class="bi bi-eye"></i> See your public profile as others see it</a></p>

      <% if (consultant.profile.completeness < 60) { %>
        <div class="glass-card mb-3"><div class="card-body">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
              <strong>Your profile is <%= consultant.profile.completeness %>% complete.</strong>
              <p class="small text-muted-2 mb-0">It needs 60% before it appears in the talent directory.</p>
            </div>
            <a class="btn btn-primary" href="/profile/consultant">Finish your profile</a>
          </div>
          <div class="meter mt-3"><i style="width:<%= consultant.profile.completeness %>%"></i></div>
        </div></div>
      <% } %>

      <div class="row g-4">
        <div class="col-lg-6">
          <h3 class="h6 text-muted-2 text-uppercase mb-2">Recommended for you</h3>
          <% if (consultant.recommended.length === 0) { %>
            <div class="empty-state glass-card"><i class="bi bi-stars"></i>
              Add your role, skills and rate to get matches.</div>
          <% } else { %>
            <% consultant.recommended.forEach(function (r) { %>
              <a class="glass-card d-block mb-2 text-reset" href="/jobs/<%= r.job.slug %>">
                <div class="card-body d-flex align-items-center gap-3 py-2">
                  <div class="match-ring" style="--pct: <%= r.score %>"><span><%= r.score %></span></div>
                  <div class="min-w-0">
                    <strong class="d-block text-truncate"><%= r.job.title %></strong>
                    <span class="small text-muted-2"><%= r.job.company_name || 'Confidential' %></span>
                  </div>
                </div>
              </a>
            <% }); %>
          <% } %>
        </div>

        <div class="col-lg-6">
          <h3 class="h6 text-muted-2 text-uppercase mb-2">Your applications</h3>
          <% if (consultant.applications.length === 0) { %>
            <div class="empty-state glass-card"><i class="bi bi-send"></i>No applications yet.
              <div><a href="/jobs">Browse roles</a></div></div>
          <% } else { %>
            <% consultant.applications.forEach(function (a) { %>
              <a class="glass-card d-block mb-2 text-reset" href="/applications/<%= a.id %>">
                <div class="card-body d-flex justify-content-between align-items-center py-2">
                  <div class="min-w-0">
                    <strong class="d-block text-truncate"><%= a.job_title %></strong>
                    <span class="small text-muted-2"><%= a.company_name || 'Confidential' %></span>
                  </div>
                  <span class="badge-hub status-<%= a.status %>"><%= a.status %></span>
                </div>
              </a>
            <% }); %>
            <a class="small" href="/dashboard/applications">See all applications</a>
          <% } %>
        </div>
      </div>
    </section>
  <% } %>

  <% if (company && activeTab.key === 'company') { %>
    <section class="mb-5">
      <h2 class="h5 mb-3">Hiring</h2>

      <%#
        The stages come from `Application.BOARD_COLUMNS`, not from a list typed here, and
        each tile is a LINK to the rows it counts. A number somebody cannot open is a
        number they have to go and look for by hand, which on this dashboard meant there
        was no way to reach the candidates at all.
      -%>
      <div class="row g-3 mb-3">
        <% company.stages.forEach(function (s) { %>
          <div class="col-4 col-lg-2">
            <a class="stat-tile d-block text-reset text-decoration-none" href="/applications?status=<%= s %>">
              <div class="value"><%= company.statusCounts[s] || 0 %></div>
              <div class="label"><%= s %></div>
            </a>
          </div>
        <% }); %>
      </div>

      <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-primary btn-sm" href="/applications"><i class="bi bi-funnel"></i> Candidate pipeline</a>
        <a class="btn btn-outline-primary btn-sm" href="/applications?view=board"><i class="bi bi-kanban"></i> Board</a>
        <a class="btn btn-outline-primary btn-sm" href="/consultants"><i class="bi bi-people"></i> Browse talent</a>
        <a class="btn btn-outline-primary btn-sm" href="/quotes/new"><i class="bi bi-calculator"></i> Scope estimate</a>
      </div>

      <div class="d-flex justify-content-between align-items-center mb-2">
        <h3 class="h6 text-muted-2 text-uppercase mb-0">Your open roles (<%= company.totalOpen %>)</h3>
        <a class="btn btn-primary btn-sm" href="/jobs/new">Post a role</a>
      </div>

      <% if (company.jobs.length === 0) { %>
        <div class="empty-state glass-card"><i class="bi bi-briefcase"></i>No open roles.
          <div><a href="/jobs/new">Post your first role</a></div></div>
      <% } else { %>
        <% company.jobs.forEach(function (job) { %><%- include('../partials/job-card', { job: job }) %><% }); %>
        <a class="small" href="/dashboard/jobs">Manage all jobs</a>
      <% } %>
    </section>
  <% } %>

  <% if (currentUser.isConsultant && activeTab.key === 'consultant') { %>
  <section>
    <h2 class="h5 mb-3">Saved jobs</h2>
    <% if (savedJobs.length === 0) { %>
      <div class="empty-state glass-card"><i class="bi bi-bookmark"></i>Nothing saved yet.</div>
    <% } else { %>
      <div class="row g-3">
        <% savedJobs.forEach(function (job) { %>
          <div class="col-lg-6"><%- include('../partials/job-card', { job: job }) %></div>
        <% }); %>
      </div>
    <% } %>
  </section>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
