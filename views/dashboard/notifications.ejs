<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { icon: 'bi-bell', heading: 'Notifications' }) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <% if (notifications.length === 0) { %>
    <div class="empty-state glass-card"><i class="bi bi-bell"></i>Nothing here yet.</div>
  <% } else { %>
    <form method="post" action="/notifications/read-all" class="mb-3 text-end">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-outline-primary btn-sm" type="submit">Mark all as read</button>
    </form>

    <div class="glass-card">
      <ul class="list-group list-group-flush">
        <% notifications.forEach(function (n) { %>
          <li class="list-group-item d-flex justify-content-between align-items-start gap-3 <%= n.read_at ? '' : 'bg-light' %>">
            <div>
              <strong><%= n.title %></strong>
              <% if (n.body) { %><div class="small text-muted-2"><%= n.body %></div><% } %>
              <div class="small text-muted-2"><%= new Date(n.created_at).toISOString().slice(0, 16).replace('T', ' ') %></div>
            </div>
            <div class="text-nowrap">
              <% if (n.link) { %><a class="btn btn-sm btn-outline-primary" href="<%= n.link %>">Open</a><% } %>
              <% if (!n.read_at) { %>
                <form method="post" action="/notifications/<%= n.id %>/read" class="d-inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-sm btn-link" type="submit">Mark read</button>
                </form>
              <% } %>
            </div>
          </li>
        <% }); %>
      </ul>
    </div>
  <% } %>
</div>
</section>

<%- include('../partials/layout-end') %>
