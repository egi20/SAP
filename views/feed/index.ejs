<%- include('../partials/layout-start') %>

<%#
  ONE home page for everybody. The hero and the four numbers render only for a visitor who
  is not signed in: a member has read them, and for them they would push the thing they came
  back for below the fold.
%>
<% if (!currentUser) { %>
  <%- include('../partials/landing-hero', landing) %>
<% } %>

<section class="glass-section <%= currentUser ? 'pt-5' : '' %>">
  <div class="container">
    <%- include('../partials/flash') %>

    <% if (currentUser) { %>
      <div class="mb-4">
        <h1 class="mb-1"><%= greeting %>, <%= currentUser.name.split(' ')[0] %></h1>
        <%# Says what the page IS, never how busy it was: on a quiet day "the community kept
            busy" is a claim the list underneath contradicts. %>
        <p class="text-muted-2 mb-0">The newest roles, questions and articles, newest first.</p>
      </div>
      <%- include('../partials/composer') %>
    <% } else { %>
      <div class="mb-4">
        <h2 class="mb-1">Live from the community</h2>
        <p class="text-muted-2 mb-0">
          Every role posted and every question asked, newest first. Reading needs no account.
        </p>
      </div>
    <% } %>

    <div class="row g-4">
      <div class="col-lg-8">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
          <%- include('../partials/kind-filters', { filterBase: '/', includeJobs: true }) %>
          <a class="btn btn-navy btn-sm mb-3" href="/community">
            <i class="bi bi-people"></i> Community home <i class="bi bi-arrow-right"></i>
          </a>
        </div>

        <% if (postsOnly) { %>
          <%#
            A category belongs to the community tree and `unanswered` to a question; neither
            means anything for a job advert. Rather than inventing a mapping between the two
            vocabularies, the feed narrows — and says that it has.
          %>
          <p class="small text-muted-2">
            Showing community posts only: that filter does not apply to job adverts.
            <a href="/">Clear it</a> to see everything.
          </p>
        <% } %>

        <% if (entries.length === 0) { %>
          <div class="empty-state glass-card">
            <i class="bi bi-chat-square-text"></i>
            <p class="mb-1">Nothing here yet.</p>
            <% if (currentUser) { %>
              <p class="small mb-3">Be the first — a question counts as much as an article.</p>
              <a class="btn btn-primary" href="/community/new">Write the first post</a>
            <% } else { %>
              <p class="small mb-3">Nothing has been posted yet. An account is free, and the first post counts double.</p>
              <a class="btn btn-primary" href="/auth/register">Create an account</a>
            <% } %>
          </div>
        <% } else { %>
          <% entries.forEach(function (entry) { %>
            <% if (entry.type === 'job') { %>
              <%- include('../partials/job-card', { job: entry.job }) %>
            <% } else { %>
              <%- include('../partials/post-card', { post: entry.post }) %>
            <% } %>
          <% }); %>
          <%- include('../partials/pagination') %>
        <% } %>
      </div>

      <aside class="col-lg-4">
        <% if (currentUser) { %>
          <div class="glass-card mb-3">
            <div class="card-body">
              <div class="d-flex align-items-center gap-3">
                <div class="match-ring" style="--pct: <%= standing.progressPercent %>">
                  <span><%= standing.level %></span>
                </div>
                <div class="flex-grow-1">
                  <strong><%= standing.title %></strong>
                  <div class="meter mt-2"><i style="width: <%= standing.progressPercent %>%"></i></div>
                  <p class="small text-muted-2 mb-0 mt-1">
                    <% if (standing.nextLevel) { %>
                      <%= standing.pointsToNext %> pts to level <%= standing.nextLevel %>
                    <% } else { %>
                      <%= standing.points %> pts — top level
                    <% } %>
                  </p>
                </div>
              </div>
            </div>
          </div>
        <% } else { %>
          <%#
            What a member sees here is their own standing. A visitor has none, so the slot
            answers the question they actually have — what an account is for — rather than
            showing them an empty progress ring.
          %>
          <div class="glass-card mb-3">
            <div class="card-body">
              <h2 class="h6 text-uppercase text-muted-2 mb-2" style="letter-spacing:.06em">New here?</h2>
              <p class="small mb-3">
                Reading is open to everybody. An account is free and takes a minute.
              </p>
              <div class="d-flex gap-2">
                <a class="btn btn-primary btn-sm" href="/auth/register">Sign up</a>
                <a class="btn btn-outline-secondary btn-sm" href="/auth/login">Sign in</a>
              </div>
            </div>
          </div>

          <div class="glass-card mb-3">
            <div class="card-body">
              <h2 class="h6 text-uppercase text-muted-2 mb-2" style="letter-spacing:.06em">Why sign in?</h2>
              <ul class="small mb-0 ps-3">
                <li>Apply for roles and message the people advertising them</li>
                <li>Ask a question, answer one, and build a standing that shows</li>
                <li>See consultants' names in the directory</li>
                <li>Contribute a day rate, and read the buckets it helps publish</li>
              </ul>
            </div>
          </div>
        <% } %>

        <div class="glass-card mb-3">
          <div class="card-body">
            <h2 class="h6 text-uppercase text-muted-2 mb-2" style="letter-spacing:.06em">New this week</h2>
            <p class="mb-2">
              <strong><%= newMembers %> <%= newMembers === 1 ? 'person' : 'people' %></strong>
              joined the community — a hello goes a long way on day one.
            </p>
            <a class="small" href="/consultants">Meet them <i class="bi bi-arrow-right"></i></a>
          </div>
        </div>

        <% if (leaderboard.length) { %>
          <div class="glass-card">
            <div class="card-body">
              <h2 class="h6 text-uppercase text-muted-2 mb-2" style="letter-spacing:.06em">Most helpful, 30 days</h2>
              <ul class="list-unstyled mb-0">
                <% leaderboard.forEach(function (m, i) { %>
                  <li class="d-flex align-items-center gap-2 mb-2">
                    <span class="text-muted-2 small" style="width:1.2rem"><%= i + 1 %></span>
                    <img class="avatar" style="width:28px;height:28px"
                         src="<%= m.profile_picture || m.logo || '/images/avatar-placeholder.svg' %>" alt="" loading="lazy">
                    <a class="small text-reset flex-grow-1 text-truncate" href="/consultants/<%= m.user_id %>"><%= m.name %></a>
                    <span class="badge-hub ok"><%= m.points %></span>
                  </li>
                <% }); %>
              </ul>
              <p class="form-text mb-0">A rolling window, so it stays winnable.</p>
            </div>
          </div>
        <% } %>
      </aside>
    </div>
  </div>
</section>

<% if (!currentUser) { %>
  <%- include('../partials/landing-sections', landing) %>
<% } %>

<%- include('../partials/layout-end') %>
