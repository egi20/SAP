<%- include('../partials/layout-start') %>

<%- include('../partials/page-header', { icon: 'bi-plus-square', heading: job ? 'Edit role' : 'Post a role', sub: 'Roles are visible to every consultant on the Hub once published.' }) %>

<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <% if (errors.length) { %>
    <div class="alert alert-danger">
      <ul class="mb-0"><% errors.forEach(function (e) { %><li><%= e.msg %></li><% }); %></ul>
    </div>
  <% } %>

  <form method="post" action="<%= job ? '/jobs/' + job.slug + '/edit' : '/jobs' %>" class="row g-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="col-lg-8">
      <div class="glass-card mb-3">
        <div class="card-body">
          <h2 class="h6 mb-3">The role</h2>

          <div class="mb-3">
            <label class="form-label" for="title">Title <span aria-hidden="true">*</span></label>
            <input class="form-control" id="title" name="title" required maxlength="200"
                   value="<%= values.title || '' %>" placeholder="Senior CPQ Consultant — 6 month contract">
          </div>

          <div class="mb-3">
            <label class="form-label" for="description">Description <span aria-hidden="true">*</span></label>
            <textarea class="form-control" id="description" name="description" rows="12" required><%= values.description || '' %></textarea>
            <p class="form-text">Basic formatting is kept; scripts and unknown tags are removed.</p>
          </div>

          <div class="mb-3">
            <label class="form-label" for="skills">Skills</label>
            <input class="form-control" id="skills" name="skills"
                   value="<%= jobSkills.map(function (s) { return s.name; }).join(', ') %>"
                   placeholder="Apex, SOQL, CPQ, Flow">
            <p class="form-text">Comma separated. Used for matching and filtering.</p>
          </div>

          <fieldset>
            <legend class="form-label">Modules this engagement touches</legend>
            <p class="form-text mt-0">
              Tick every module in scope. They are how consultants find this role, and how the
              match score compares it against what somebody has actually delivered.
            </p>
            <% productLines.forEach(function (f) { %>
              <p class="small text-muted-2 mb-1 mt-2"><%= f.label %></p>
              <div class="d-flex flex-wrap gap-3">
                <% f.modules.forEach(function (m) { %>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="modules" value="<%= m.value %>"
                           id="m-<%= m.value %>" <%= jobModules.includes(m.value) ? 'checked' : '' %>>
                    <label class="form-check-label small" for="m-<%= m.value %>"><%= m.label %></label>
                  </div>
                <% }); %>
              </div>
            <% }); %>
          </fieldset>

          <div class="mt-3">
            <label class="form-label" for="activate_phase">SAP Activate phase</label>
            <select class="form-select" id="activate_phase" name="activate_phase">
              <option value="">Spans phases / not applicable</option>
              <% ['discover','prepare','explore','realize','deploy','run'].forEach(function (phase) { %>
                <option value="<%= phase %>" <%= (values.activate_phase || '') === phase ? 'selected' : '' %>>
                  <%= phase.charAt(0).toUpperCase() + phase.slice(1) %>
                </option>
              <% }); %>
            </select>
            <div class="form-text">
              Leave it unset for a permanent hire. A realize-phase consultant and a run-phase
              consultant are different people, and saying which you need saves everybody a call.
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="glass-card mb-3">
        <div class="card-body">
          <h2 class="h6 mb-3">Classification</h2>

          <div class="mb-3">
            <label class="form-label" for="role">Role <span aria-hidden="true">*</span></label>
            <select class="form-select" id="role" name="role" required>
              <option value="">Choose a role</option>
              <% roleCategories.forEach(function (cat) { %>
                <optgroup label="<%= cat.category %>">
                  <% cat.roles.forEach(function (r) { %>
                    <option value="<%= r.value %>" <%= values.role === r.value ? 'selected' : '' %>><%= r.label %></option>
                  <% }); %>
                </optgroup>
              <% }); %>
            </select>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label" for="seniority">Seniority</label>
              <select class="form-select" id="seniority" name="seniority">
                <% ['junior','mid','senior','lead'].forEach(function (s) { %>
                  <option value="<%= s %>" <%= (values.seniority || 'senior') === s ? 'selected' : '' %>><%= s %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-6">
              <label class="form-label" for="work_mode">Work mode</label>
              <select class="form-select" id="work_mode" name="work_mode">
                <% ['remote','hybrid','onsite'].forEach(function (m) { %>
                  <option value="<%= m %>" <%= (values.work_mode || 'remote') === m ? 'selected' : '' %>><%= m %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="engagement_type">Engagement</label>
            <select class="form-select" id="engagement_type" name="engagement_type">
              <option value="contract" <%= (values.engagement_type || 'contract') === 'contract' ? 'selected' : '' %>>Contract (day rate)</option>
              <option value="permanent" <%= values.engagement_type === 'permanent' ? 'selected' : '' %>>Permanent (annual)</option>
            </select>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label" for="country">Country</label>
              <select class="form-select" id="country" name="country">
                <option value="">Any</option>
                <% countries.forEach(function (c) { %>
                  <option value="<%= c.code %>" <%= values.country === c.code ? 'selected' : '' %>><%= c.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-6">
              <label class="form-label" for="city">City</label>
              <input class="form-control" id="city" name="city" value="<%= values.city || '' %>">
            </div>
          </div>
        </div>
      </div>

      <div class="glass-card mb-3">
        <div class="card-body">
          <h2 class="h6 mb-3">Budget</h2>
          <div class="row g-2 mb-2">
            <div class="col-4">
              <label class="form-label" for="rate_min">From</label>
              <input class="form-control" id="rate_min" name="rate_min" type="number" min="0" step="10" value="<%= values.rate_min || '' %>">
            </div>
            <div class="col-4">
              <label class="form-label" for="rate_max">To</label>
              <input class="form-control" id="rate_max" name="rate_max" type="number" min="0" step="10" value="<%= values.rate_max || '' %>">
            </div>
            <div class="col-4">
              <label class="form-label" for="currency">Currency</label>
              <select class="form-select" id="currency" name="currency">
                <% ['EUR','USD','GBP','CHF'].forEach(function (c) { %>
                  <option value="<%= c %>" <%= (values.currency || 'EUR') === c ? 'selected' : '' %>><%= c %></option>
                <% }); %>
              </select>
            </div>
          </div>
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="rate_visible" name="rate_visible"
                   <%= (!values || values.rate_visible === undefined || values.rate_visible) ? 'checked' : '' %>>
            <label class="form-check-label" for="rate_visible">Show the budget publicly</label>
          </div>

          <div class="row g-2">
            <div class="col-6">
              <label class="form-label" for="duration_months">Duration (months)</label>
              <input class="form-control" id="duration_months" name="duration_months" type="number" min="1" max="60"
                     value="<%= values.duration_months || '' %>">
            </div>
            <div class="col-6">
              <label class="form-label" for="starts_on">Starts</label>
              <input class="form-control" id="starts_on" name="starts_on" type="date"
                     value="<%= values.starts_on ? new Date(values.starts_on).toISOString().slice(0,10) : '' %>">
            </div>
          </div>
        </div>
      </div>

      <div class="glass-card">
        <div class="card-body">
          <% if (!job) { %>
            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" id="publish" name="publish" checked>
              <label class="form-check-label" for="publish">Publish immediately</label>
            </div>
          <% } %>
          <button class="btn btn-primary w-100" type="submit"><%= job ? 'Save changes' : 'Create role' %></button>
          <% if (job) { %>
            <a class="btn btn-outline-primary w-100 mt-2" href="/jobs/<%= job.slug %>">Cancel</a>
          <% } %>
        </div>
      </div>
    </div>
  </form>
</div>
</section>

<%- include('../partials/layout-end') %>
