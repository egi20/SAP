<%- include('../partials/layout-start') %>

<section class="glass-section pb-5">
<div class="container py-4">
  <%- include('../partials/flash') %>

  <%#
    A breadcrumb rather than a "Back" button. The app sends `Referrer-Policy: no-referrer`,
    so the server cannot know where somebody came from, and a button labelled "Back" that
    always goes to the same place is lying about half the time. This says where it goes.
  %>
  <nav aria-label="Breadcrumb" class="mb-3">
    <ol class="breadcrumb small mb-0">
      <li class="breadcrumb-item"><a href="/jobs">All jobs</a></li>
      <li class="breadcrumb-item active" aria-current="page"><%= job.title %></li>
    </ol>
  </nav>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="glass-card mb-3">
        <div class="card-body">
          <div class="d-flex gap-3 mb-3">
            <img class="logo-tile" src="<%= job.company_logo || '/images/logo-placeholder.svg' %>" alt="">
            <div class="flex-grow-1">
              <h1 class="h3 mb-1"><%= job.title %></h1>
              <p class="text-muted-2 mb-0">
                <% if (job.company_slug) { %>
                  <a href="/companies/<%= job.company_slug %>"><%= job.company_name %></a>
                <% } else { %><%= job.company_name || 'Confidential' %><% } %>
                <% if (job.city || job.country) { %> · <%= [job.city, job.country].filter(Boolean).join(', ') %><% } %>
                <% if (job.published_at) { %> · posted <%= new Date(job.published_at).toISOString().slice(0, 10) %><% } %>
              </p>
            </div>
            <% if (match) { %>
              <div class="text-center">
                <div class="match-ring" style="--pct: <%= match.score %>" title="How well your profile matches this role">
                  <span><%= match.score %></span>
                </div>
                <div class="small text-muted-2 mt-1">match</div>
              </div>
            <% } %>
          </div>

          <div class="d-flex flex-wrap gap-1 mb-3">
            <span class="badge-hub accent"><%= roleLabel(job.role) %></span>
            <span class="badge-hub"><%= job.seniority %></span>
            <span class="badge-hub"><%= job.work_mode %></span>
            <span class="badge-hub"><%= job.engagement_type %></span>
            <% if (job.duration_months) { %><span class="badge-hub"><%= job.duration_months %> months</span><% } %>
            <% if (job.rate_visible && job.rate_min && job.rate_max) { %>
              <span class="badge-hub ok"><%= Math.round(job.rate_min) %>–<%= Math.round(job.rate_max) %> <%= job.currency %><%= job.engagement_type === 'contract' ? '/day' : '/yr' %></span>
            <% } %>
            <% if (job.status !== 'open') { %><span class="badge-hub warn"><%= job.status %></span><% } %>
          </div>

          <% if (job.activate_phase) { %>
            <p class="small text-muted-2 mb-1">Delivery phase</p>
            <div class="mb-3">
              <span class="badge-hub accent text-capitalize"><%= job.activate_phase %></span>
              <span class="small text-muted-2">SAP Activate</span>
            </div>
          <% } %>

          <% if (jobModules.length) { %>
            <p class="small text-muted-2 mb-1">Modules in scope</p>
            <div class="d-flex flex-wrap gap-1 mb-3">
              <% jobModules.forEach(function (m) { %><span class="badge-hub"><%= moduleLabel(m) %></span><% }); %>
            </div>
          <% } %>

          <% if (jobSkills.length) { %>
            <p class="small text-muted-2 mb-1">Skills</p>
            <div class="d-flex flex-wrap gap-1 mb-3">
              <% jobSkills.forEach(function (s) { %><span class="badge-hub"><%= s.name %></span><% }); %>
            </div>
          <% } %>

          <%#
            Every section that has something in it, in the order config/jobSections.js
            declares. An empty one renders NOTHING — not an empty heading, which reads as
            an employer who could not be bothered. Same rule as "About the company".
          -%>
          <% sections.forEach(function (section) { %>
            <% if (job[section.key] && String(job[section.key]).trim()) { %>
              <hr>
              <% if (!section.required) { %><h2 class="h6"><%= section.label %></h2><% } %>
              <div class="job-description"><%- sanitizeRichText(job[section.key]) %></div>
            <% } %>
          <% }); %>
        </div>
      </div>
    </div>

    <aside class="col-lg-4">
      <div class="glass-card mb-3">
        <div class="card-body">
          <% if (isOwner) { %>
            <h2 class="h6">Manage this job</h2>
            <a class="btn btn-primary w-100 mb-2" href="/jobs/<%= job.slug %>/edit">Edit</a>
            <a class="btn btn-outline-primary w-100 mb-3" href="/applications/job/<%= job.slug %>">
              Applicants (<%= job.application_count %>)
            </a>
            <form method="post" action="/jobs/<%= job.slug %>/status">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="form-label" for="status">Status</label>
              <div class="d-flex gap-2">
                <select class="form-select" id="status" name="status">
                  <% jobStatuses.forEach(function (s) { %>
                    <option value="<%= s %>" <%= job.status === s ? 'selected' : '' %>><%= s %></option>
                  <% }); %>
                </select>
                <button class="btn btn-outline-primary" type="submit">Set</button>
              </div>
            </form>
            <p class="small text-muted-2 mt-3 mb-0"><%= job.view_count %> views</p>

            <hr>
            <h2 class="h6">Hand this role over</h2>
            <%#
              An offer addressed to an email, and nothing moves until somebody signed in at
              that address accepts. There is no link that transfers anything: an advert
              carries other people's data, and a claim link in an inbox is an access grant
              to whoever that inbox forwards to.
            -%>
            <% if (pendingTransfer) { %>
              <p class="small mb-2">
                Offered to <strong><%= pendingTransfer.to_email %></strong>, waiting until
                <%= new Date(pendingTransfer.expires_at).toLocaleDateString('en-GB') %>.
              </p>
              <a class="btn btn-outline-secondary btn-sm w-100" href="/dashboard/transfers">Manage the offer</a>
            <% } else if (transferable && transferable.ok) { %>
              <form method="post" action="/jobs/<%= job.slug %>/transfer">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label class="form-label" for="to_email">Colleague's email</label>
                <input class="form-control mb-2" id="to_email" name="to_email" type="email" required
                       maxlength="255" autocomplete="off">
                <label class="form-label" for="transfer_message">Note (optional)</label>
                <textarea class="form-control mb-2" id="transfer_message" name="message" rows="2"
                          maxlength="500"></textarea>
                <button class="btn btn-outline-primary btn-sm w-100" type="submit">Offer this role</button>
              </form>
              <p class="form-text mb-0">
                They need a company account at that address. The offer expires after
                <%= transferWindowDays %> days, and a live advert is paused when it moves.
              </p>
            <% } else if (transferable) { %>
              <%#
                NAMES what is in the way. "This role cannot be transferred" with no reason
                is the message people bounce off, and here the reason is the whole point —
                it is about the candidates, not about the advert.
              -%>
              <p class="small text-muted-2 mb-0">
                This role can no longer be handed over.
                <% transferable.reasons.forEach(function (reason) { %>
                  <br><%= reason %>
                <% }); %>
              </p>
            <% } %>

            <hr>
            <h2 class="h6">Featured placement</h2>
            <% if (featuredUntil) { %>
              <p class="small mb-2">
                <span class="badge-hub featured"><i class="bi bi-stars"></i> Featured</span>
                until <%= new Date(featuredUntil).toLocaleDateString('en-GB') %>.
              </p>
              <p class="small text-muted-2">Buying another window extends this one rather than replacing it.</p>
            <% } else { %>
              <p class="small text-muted-2">
                Put this role at the top of the board for <%= jobFeatureDays %> days.
              </p>
            <% } %>
            <% if (job.status === 'open') { %>
              <form method="post" action="/payments/checkout/job_feature">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="subjectId" value="<%= job.id %>">
                <input type="hidden" name="redirectTo" value="/jobs/<%= job.slug %>">
                <button class="btn btn-outline-primary w-100 btn-sm" type="submit">
                  <%= featuredUntil ? 'Extend by' : 'Feature for' %> <%= jobFeatureDays %> days — <%= jobFeaturePrice %>
                </button>
              </form>
            <% } else { %>
              <p class="small text-muted-2 mb-0">Only an open job can be featured.</p>
            <% } %>

          <% } else if (currentUser && currentUser.isConsultant) { %>
            <% if (application && application.status !== 'withdrawn') { %>
              <h2 class="h6">Your application</h2>
              <p class="mb-2">
                <span class="badge-hub status-<%= application.status %>"><%= application.status %></span>
              </p>
              <a class="btn btn-outline-primary w-100" href="/applications/<%= application.id %>">View application</a>
            <% } else if (job.status === 'open') { %>
              <h2 class="h6">Apply</h2>
              <form method="post" action="/jobs/<%= job.slug %>/apply">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-2">
                  <label class="form-label" for="cover_letter">Message to the employer</label>
                  <textarea class="form-control" id="cover_letter" name="cover_letter" rows="5"
                            placeholder="Why you fit this engagement" maxlength="5000"></textarea>
                </div>
                <div class="row g-2 mb-2">
                  <div class="col-7">
                    <label class="form-label" for="day_rate">Your rate</label>
                    <input class="form-control" id="day_rate" name="day_rate" type="number" min="0" step="10">
                  </div>
                  <div class="col-5">
                    <label class="form-label" for="currency">Currency</label>
                    <select class="form-select" id="currency" name="currency">
                      <% ['EUR','USD','GBP','CHF'].forEach(function (c) { %><option value="<%= c %>"><%= c %></option><% }); %>
                    </select>
                  </div>
                </div>
                <div class="mb-3">
                  <label class="form-label" for="available_from">Available from</label>
                  <input class="form-control" id="available_from" name="available_from" type="date">
                </div>
                <button class="btn btn-primary w-100" type="submit">Send application</button>
              </form>
            <% } else { %>
              <p class="mb-0 text-muted-2">This role is no longer accepting applications.</p>
            <% } %>

          <% } else if (!currentUser) { %>
            <h2 class="h6">Interested?</h2>
            <p class="text-muted-2 small">Create a free consultant profile to apply.</p>
            <a class="btn btn-primary w-100 mb-2" href="/auth/register?redirect=<%= encodeURIComponent('/jobs/' + job.slug) %>">Create an account</a>
            <a class="btn btn-outline-primary w-100" href="/auth/login?redirect=<%= encodeURIComponent('/jobs/' + job.slug) %>">Sign in</a>
          <% } %>
        </div>
      </div>

      <% if (currentUser && !isOwner && job.status === 'open') { %>
        <div class="glass-card mb-3">
          <div class="card-body">
            <h2 class="h6 mb-2">Question about this role?</h2>
            <form method="post" action="/messages/start">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="kind" value="enquiry">
              <input type="hidden" name="job_id" value="<%= job.id %>">
              <input type="hidden" name="recipient_user_id" value="<%= job.company_user_id %>">
              <textarea class="form-control mb-2" name="body" rows="3" required maxlength="5000"
                        placeholder="Ask the advertiser directly"></textarea>
              <button class="btn btn-outline-primary w-100 btn-sm" type="submit">Send question</button>
            </form>
            <p class="form-text mb-0">Goes to whoever posted this role, with the role attached.</p>
          </div>
        </div>
      <% } %>

      <% if (currentUser && !isOwner) { %>
        <form method="post" action="/jobs/<%= job.slug %>/save" class="mb-3">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="saved" value="<%= saved ? 'true' : 'false' %>">
          <button class="btn btn-outline-primary w-100" type="submit">
            <i class="bi bi-bookmark<%= saved ? '-fill' : '' %>"></i>
            <%= saved ? 'Saved' : 'Save this job' %>
          </button>
        </form>
      <% } %>

      <% if (match) { %>
        <div class="glass-card">
          <div class="card-body">
            <h2 class="h6">Why this score</h2>
            <ul class="list-unstyled small mb-0">
              <% Object.entries(match.breakdown).forEach(function (e) { %>
                <li class="d-flex justify-content-between">
                  <span class="text-capitalize"><%= e[0] %></span>
                  <strong><%= e[1] %></strong>
                </li>
              <% }); %>
            </ul>
            <p class="form-text mb-0 mt-2">
              <strong>Modules</strong> counts the ones you have entered in your delivery history,
              not the ones you have listed as skills. Adding an engagement moves it.
            </p>
          </div>
        </div>
      <% } %>

      <div class="glass-card mt-3">
        <div class="card-body">
          <h2 class="h6">Job overview</h2>
          <ul class="list-unstyled small mb-0 job-overview">
            <li><span class="text-muted-2">Engagement</span><span><%= job.engagement_type %></span></li>
            <li><span class="text-muted-2">Work mode</span><span><%= job.work_mode %></span></li>
            <li>
              <span class="text-muted-2">Location</span>
              <span><%= [job.city, job.country].filter(Boolean).join(', ') || 'Not stated' %></span>
            </li>
            <li><span class="text-muted-2">Experience</span><span><%= job.seniority %></span></li>
            <li><span class="text-muted-2">Phase</span><span><%= job.activate_phase %></span></li>
            <% if (job.duration_months) { %>
              <li><span class="text-muted-2">Duration</span><span><%= job.duration_months %> months</span></li>
            <% } %>
            <li>
              <span class="text-muted-2">Posted</span>
              <span><%= job.published_at ? new Date(job.published_at).toISOString().slice(0, 10) : 'Not yet' %></span>
            </li>
            <%#
              Shown to everybody, and it excludes withdrawn applications: the number answers
              "how much competition is there", and somebody who pulled out is not
              competition. A candidate deciding where to spend an evening learns something
              true from it, and hiding it advantages nobody but the advertiser.
            %>
            <li>
              <span class="text-muted-2">Applications</span>
              <span><%= applicationCount %></span>
            </li>
          </ul>
        </div>
      </div>

      <%#
        Only for a consultant, and only for somebody who has not already applied: offering
        to build a CV for a role they are already in the pipeline for is the site forgetting
        what it was told a minute ago. The advert's slug rides along, so the engagements
        that touched its modules come first.
      %>
      <% if (currentUser && currentUser.isConsultant && !application) { %>
        <div class="glass-card mt-3">
          <div class="card-body">
            <h2 class="h6">Applying for this role?</h2>
            <p class="small text-muted-2 mb-3">
              Build a CV from your profile, ordered against this advert — the engagements
              that touched these modules come first. Nothing is reworded.
            </p>
            <a class="btn btn-sm btn-outline-primary w-100" href="/profile/cv?job=<%= job.slug %>">
              <i class="bi bi-file-earmark-person"></i> Build my CV for this role
            </a>
          </div>
        </div>
      <% } %>

      <div class="glass-card mt-3">
        <div class="card-body">
          <h2 class="h6">Share this job</h2>
          <%#
            Plain links, built from the canonical URL the server decided — no third-party
            share widget, which would mean a script from somebody else's domain on a page
            that currently loads nothing from one. The copy button is added by main.js,
            because it is the only one of the four that needs scripting.
          %>
          <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-sm btn-outline-secondary" rel="noopener" target="_blank"
               href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(shareUrl) %>">
              <i class="bi bi-linkedin" aria-hidden="true"></i> LinkedIn
            </a>
            <a class="btn btn-sm btn-outline-secondary" rel="noopener" target="_blank"
               href="https://x.com/intent/tweet?url=<%= encodeURIComponent(shareUrl) %>&amp;text=<%= encodeURIComponent(job.title) %>">
              <i class="bi bi-twitter-x" aria-hidden="true"></i> X
            </a>
            <a class="btn btn-sm btn-outline-secondary"
               href="mailto:?subject=<%= encodeURIComponent(job.title) %>&amp;body=<%= encodeURIComponent(shareUrl) %>">
              <i class="bi bi-envelope" aria-hidden="true"></i> Email
            </a>
            <span class="copy-link" data-copy="<%= shareUrl %>"></span>
          </div>
        </div>
      </div>

      <%#
        The test is `about || website`, and NOT company_type. That column has a DEFAULT of
        'end_customer', so every row has one and a condition including it is always true —
        which rendered an "About the company" heading over an empty box for a company that
        had filled nothing in. A heading with nothing under it reads as a company that
        could not be bothered.
      %>
      <% if (company && (company.about || company.website)) { %>
        <div class="glass-card mt-3">
          <div class="card-body">
            <h2 class="h6">About <%= job.company_name %></h2>
            <% if (company.company_type) { %>
              <p class="small text-muted-2 mb-2">
                <%= { end_customer: 'End customer', consulting_partner: 'Consulting partner',
                      isv: 'ISV', staffing: 'Staffing company' }[company.company_type] || company.company_type %>
                <% if (company.company_size) { %> · <%= company.company_size %> people<% } %>
              </p>
            <% } %>
            <%# `about`, which is what the column is called. There is no `description`. %>
            <% if (company.about) { %>
              <p class="small mb-3"><%= toPlainText(company.about, 240) %></p>
            <% } %>
            <div class="d-flex flex-wrap gap-2">
              <% if (job.company_slug) { %>
                <a class="btn btn-sm btn-outline-primary" href="/companies/<%= job.company_slug %>">Their other roles</a>
              <% } %>
              <% if (company.website) { %>
                <a class="btn btn-sm btn-outline-secondary" rel="nofollow noopener" target="_blank"
                   href="<%= company.website %>">Website</a>
              <% } %>
            </div>
          </div>
        </div>
      <% } %>
    </aside>
  </div>
</div>

<% if (jsonLd) { %>
<script type="application/ld+json"><%- jsonForScript(jsonLd) %></script>
<% } %>

<%- include('../partials/layout-end') %>
