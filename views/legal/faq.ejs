<%- include('../partials/layout-start') %>
<%- include('../partials/page-header', {
  icon: 'bi-question-circle',
  label: 'FAQ',
  heading: 'Frequently Asked Questions',
  sub: 'Quick answers to common questions about SAP Hub.'
}) %>
<%
  /*
   * The answers, keyed by the ids in config/faq.js, which owns the questions and their
   * order. Every answer is a statement about how the code behaves and carries the link that
   * demonstrates it, because an FAQ written from intention rather than from the
   * implementation becomes a second, competing description of the system — and it is
   * always the one that goes stale. Figures (the rate floor, the featuring price) are read
   * from config, never typed.
   *
   * The same strings feed the FAQPage structured data below, stripped to text, so what a
   * search engine is told is word for word what the page shows.
   */
  const ANSWERS = {
    faq8: `A marketplace for the SAP ecosystem. Consultants keep a profile built around the SAP
      modules and projects they have actually delivered; companies post SAP roles and search the
      <a href="/consultants">consultant directory</a>; and everybody can use the
      <a href="/rates">day-rate index</a>, the <a href="/quotes/new">scope estimator</a> and the
      <a href="/community">community</a>. SAP Hub is operated by ${legalEntity.name} and is
      independent of SAP SE — more on the <a href="/about">about page</a>.`,
    faq1: `No. Creating an account, keeping a profile, applying for work, browsing consultants
      and using the community are all free. Two optional things are paid — featuring a job
      advert, and a deposit against an accepted quote — and both are priced on the
      <a href="/payments">pricing page</a>, which is the only place on the site that decides
      what anything costs.`,
    faq9: `Consultants edit theirs under <a href="/profile/consultant">Build Profile</a>: role,
      modules, delivery history, certifications, rate, availability, photograph and whether
      the profile is listed. Companies edit theirs under
      <a href="/profile/company">Company profile</a>: the "About the company" text, size,
      website and logo, which appear on every advert they post. Your password, your roles and
      closing the account are in <a href="/profile/settings">Settings</a>.`,
    faq11: `From a company account, open <a href="/jobs/new">Post a Role</a>. An advert can be
      saved as a draft and published when it is ready, and the applications it receives
      arrive in your <a href="/applications">pipeline</a>. If you signed up as a consultant,
      add the company role in <a href="/profile/settings/roles">Settings → Roles</a> first —
      one account can hold both.`,
    faq12: `A featured advert is listed above the others on the <a href="/jobs">job board</a>
      and carries a Featured badge, for ${jobFeatureDays} days, for ${jobFeaturePrice}. The
      button is on your own advert's page while it is open, and featuring it again before the
      window ends extends it rather than starting over. Nothing else about the advert changes
      — who can see it and who can apply stay the same. Prices are on the
      <a href="/payments">pricing page</a>.`,
    faq10: `You build it yourself, straight away, with the <a href="/quotes/new">estimator</a>:
      choose the SAP modules, the approach and the add-ons, and it produces a full estimate
      with a reference starting <code>Q-</code>. Your estimates are kept under
      <a href="/quotes">Estimates</a>, where you can download them and mark them sent or
      accepted. To talk a quote through with a person, <a href="/contact">write to us</a>
      with its reference.`,
    faq3: `A breakdown you can hand to a client: consultant-days per SAP Activate phase, a
      resource plan by role, a calendar duration and a budget. The parts reconcile against the
      headline — phase days and resource days each sum exactly to the total, and every cost is
      days times a rate — and the <a href="/quotes/new">estimator</a> refuses to show a figure
      that does not add up rather than showing one that nearly does. You can export it as a
      document, a workbook or a deck.`,
    faq2: `From figures members contribute about their own work. A bucket — a role, a
      seniority, a country — is published only once at least ${minSample} different
      <em>people</em> have contributed to it; one person submitting five times is still a
      sample of one. Below that, the <a href="/rates">index</a> shows the count and withholds
      the numbers, and a period with too few contributors is shown as a gap rather than filled
      in. You can <a href="/rates/submit">add your own figure</a> once signed in, and it is
      never shown next to your name.`,
    faq4: `Because people who are currently employed are the ones most worth talking to and the
      ones with most to lose from a public listing. The <a href="/consultants">directory</a> is
      fully searchable while signed out — the experience, the modules delivered, the
      availability — and the name appears to an account. Creating one is
      <a href="/auth/register">free</a>.`,
    faq5: `Exactly one thing: that the member signed in to a LinkedIn account, and the name on
      it. It is not a sign-in method here and never creates an account. LinkedIn does not hand
      over a job history, an employer or a profile URL to an ordinary application, so the badge
      does not claim any of those — a LinkedIn address typed on a profile stays a claim, and is
      labelled as one. Link or unlink it from <a href="/profile/settings">your settings</a>.`,
    faq6: `Only about something specific. Every conversation is anchored to a subject — an
      application you made, or an enquiry about a job you advertised — so there is no open
      inbox anybody can write into, and every thread has a subject line that is true. Your
      threads are at <a href="/messages">messages</a>.`,
    faq7: `Write to us — <a href="/contact">the contact page</a> says what to include so the
      first reply is a useful one. Account questions have to come that way: nothing automated
      on this site can look you up, and we cannot identify an account from a name alone.
      Something on a page not working? <a href="/report-issue">Report an issue</a>.`
  };
  const decode = function (t) {
    return t.replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
  };
  const faqLd = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqQuestions.map(function (f) {
      return { '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: decode(toPlainText(ANSWERS[f.id])) } };
    })
  };
%>
<section class="glass-section pb-5">
<div class="container">
  <div class="row justify-content-center"><div class="col-lg-10 col-xl-9">
    <%# One accordion, with the first panel open. /faq#faqN opens that answer (main.js). -%>
    <div class="accordion accordion-flush glass-card" id="faq">
      <% faqQuestions.forEach(function (f, i) { %>
        <div class="accordion-item">
          <h2 class="accordion-header">
            <button class="accordion-button<%= i === 0 ? '' : ' collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#<%= f.id %>"
                    aria-expanded="<%= i === 0 ? 'true' : 'false' %>" aria-controls="<%= f.id %>">
              <%= f.q %>
            </button>
          </h2>
          <div id="<%= f.id %>" class="accordion-collapse collapse<%= i === 0 ? ' show' : '' %>" data-bs-parent="#faq">
            <div class="accordion-body"><%- ANSWERS[f.id] %></div>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="glass-card mt-4"><div class="card-body d-md-flex align-items-center justify-content-between gap-3">
      <div>
        <h2 class="h5 card-heading mb-1">Didn't find your answer?</h2>
        <p class="mb-md-0 text-muted-2">A real person reads every message, and replies to the address you give.</p>
      </div>
      <a class="btn btn-primary flex-shrink-0" href="/contact">Contact us</a>
    </div></div>
  </div></div>
</div>
</section>
<script type="application/ld+json"><%- jsonForScript(faqLd) %></script>
<%- include('../partials/layout-end') %>
