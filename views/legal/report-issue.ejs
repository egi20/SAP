<%- include('../partials/layout-start') %>
<%
  const isIdea = mode === 'idea';
  /*
   * Labels only. The VALUES come from Enquiry.PROBLEM_TYPES / IDEA_TYPES / SEVERITIES /
   * PRIORITIES, which mirror the ENUMs in migrations 018 and 030 — so an option shown here
   * cannot be rejected behind it.
   */
  const typeLabels = {
    bug: 'Something is broken', question: 'I cannot work out how to do something',
    account: 'My account', billing: 'A payment or an invoice',
    abuse: 'Someone\'s behaviour or content', other: 'Something else',
    idea_feature: 'A new feature', idea_improvement: 'An improvement to something that exists',
    idea_integration: 'An integration with another tool', idea_other: 'Something else'
  };
  /*
   * Both modes live on ONE page, as on dynamicshub.net: the buttons switch the form in place
   * (report-issue.js) and keep whatever was already typed. Everything that differs between
   * the two is in this one object, which renders the mode the server was asked for AND is
   * handed to the script as JSON, so the switch cannot show a label the server would not.
   */
  const MODES = {
    problem: {
      typeLabel: 'What kind of problem',
      types: issueTypesByMode.problem.map(function (t) { return [t, typeLabels[t]]; }),
      severityLabel: 'How badly does it affect you',
      severities: [['low', 'Minor — I can work around it'], ['normal', 'Normal — it is getting in the way'],
        ['high', 'High — I cannot do what I came to do'], ['critical', 'Critical — the site is down or data is being lost']]
        .filter(function (x) { return severitiesByMode.problem.includes(x[0]); }),
      defaultSeverity: 'normal',
      guideSummary: 'What do the levels mean?',
      guideHeading: 'Severity guide',
      guide: [
        ['text-bg-secondary', 'Minor', 'A cosmetic problem, or one with an easy workaround.'],
        ['text-bg-info', 'Normal', 'Something does not work as it should, but you can carry on.'],
        ['text-bg-warning', 'High', 'You cannot finish what you came to do.'],
        ['text-bg-danger', 'Critical', 'The site is down for you, or data is being lost or exposed.']
      ],
      pageHelp: 'Filled in for you when you came here from a page on this site.',
      submit: 'Send report',
      noun: 'report'
    },
    idea: {
      typeLabel: 'Idea type',
      types: issueTypesByMode.idea.map(function (t) { return [t, typeLabels[t]]; }),
      severityLabel: 'Priority',
      severities: [['low', 'Nice to have'], ['normal', 'Important'], ['high', 'Essential — I need it to use the site']]
        .filter(function (x) { return severitiesByMode.idea.includes(x[0]); }),
      defaultSeverity: 'low',
      guideSummary: 'What do the priorities mean?',
      guideHeading: 'Priority guide',
      guide: [
        ['text-bg-secondary', 'Nice to have', 'It would make the site better; nothing is blocked without it.'],
        ['text-bg-info', 'Important', 'You would use it regularly, or it would save real time.'],
        ['text-bg-warning', 'Essential', 'Without it the site does not do what you need it for.']
      ],
      pageHelp: 'If the idea is about one page, its address.',
      submit: 'Send idea',
      noun: 'idea'
    }
  };
  const m = MODES[mode];
%>
<%- include('../partials/page-header', {
  icon: 'bi-chat-square-text',
  heading: 'Report an Issue or Share an Idea',
  sub: 'Something broken, or something the site should do better. Every report and idea is read by a person.'
}) %>
<section class="glass-section pb-5">
<div class="container">
  <div class="row g-4">
    <div class="col-lg-8">
      <%#
        Two modes on one page, as on dynamicshub.net. report-issue.js switches the form in
        place and keeps what was typed; without scripting the buttons are still links the
        server renders for, and ?mode=idea can still be sent to somebody.
      -%>
      <nav class="report-modes mb-3" aria-label="What would you like to send?">
        <a class="btn <%= isIdea ? 'btn-outline-primary' : 'btn-primary' %>" data-report-mode="problem" href="/report-issue<%= values.page_url ? '?page=' + encodeURIComponent(values.page_url) : '' %>"
           <%- isIdea ? '' : 'aria-current="page"' %>><i class="bi bi-bug me-1" aria-hidden="true"></i>Report a problem</a>
        <a class="btn <%= isIdea ? 'btn-primary' : 'btn-outline-primary' %>" data-report-mode="idea" href="/report-issue?mode=idea<%= values.page_url ? '&page=' + encodeURIComponent(values.page_url) : '' %>"
           <%- isIdea ? 'aria-current="page"' : '' %>><i class="bi bi-lightbulb me-1" aria-hidden="true"></i>Share an idea</a>
      </nav>

      <div class="glass-card"><div class="card-body">
        <%- include('../partials/flash') %>
        <% if (sent) { %>
          <%# data-report-sent tells report-issue.js to drop the saved draft: it has arrived. -%>
          <div class="alert alert-success" role="status" data-report-sent>
            <strong>Thank you — your <%= isIdea ? 'idea' : 'report' %> reached us.</strong>
            Your reference is <strong><%= sent %></strong>; a confirmation is on its way to your email.
            <% if (currentUser) { %><a href="/report-issue/mine">See it in My reports</a>.<% } %>
          </div>
        <% } %>
        <% if (errors.length) { %>
          <div class="alert alert-danger" role="alert">
            <ul class="mb-0">
              <% errors.forEach(function (e) { %><li><%= e.msg %></li><% }) %>
            </ul>
          </div>
        <% } %>

        <form method="post" action="/report-issue" enctype="multipart/form-data" data-report-form data-draft-key="report-draft-<%= mode %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="mode" value="<%= mode %>" data-mode-input>
          <script type="application/json" id="report-modes"><%- JSON.stringify(MODES).replace(/</g, '\\u003c') %></script>

          <div class="mb-3"><%- include('../partials/enquiry-identity', { values }) %></div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label" for="f-type"><span data-mode-text="typeLabel"><%= m.typeLabel %></span> <span aria-hidden="true">*</span></label>
              <select class="form-select<%= fieldErrors.issue_type ? ' is-invalid' : '' %>" id="f-type" name="issue_type" required
                      <% if (fieldErrors.issue_type) { %>aria-invalid="true" aria-describedby="f-type-error"<% } %>
                      data-reveal="f-content-wrap" data-reveal-when="abuse">
                <option value="">Choose…</option>
                <% m.types.forEach(function (t) { %>
                  <option value="<%= t[0] %>" <%= values.issue_type === t[0] ? 'selected' : '' %>><%= t[1] %></option>
                <% }) %>
              </select>
              <% if (fieldErrors.issue_type) { %><div class="invalid-feedback" id="f-type-error"><%= fieldErrors.issue_type %></div><% } %>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-severity"><span data-mode-text="severityLabel"><%= m.severityLabel %></span> <span aria-hidden="true">*</span></label>
              <select class="form-select<%= fieldErrors.severity ? ' is-invalid' : '' %>" id="f-severity" name="severity" required aria-describedby="severity-guide<%= fieldErrors.severity ? ' f-severity-error' : '' %>">
                <% m.severities.forEach(function (sv) { %>
                  <option value="<%= sv[0] %>" <%= (values.severity || m.defaultSeverity) === sv[0] ? 'selected' : '' %>><%= sv[1] %></option>
                <% }) %>
              </select>
              <% if (fieldErrors.severity) { %><div class="invalid-feedback" id="f-severity-error"><%= fieldErrors.severity %></div><% } %>
              <%#
                On a phone the sidebar guide is at the bottom of the page, after the button —
                so the same guide opens here, beside the field it explains. <details> needs no
                script and the keyboard reaches it.
              -%>
              <details class="d-lg-none mt-2 small">
                <summary data-mode-text="guideSummary"><%= m.guideSummary %></summary>
                <dl class="mt-2 mb-0" data-mode-guide>
                  <% m.guide.forEach(function (g) { %>
                    <dt><span class="badge <%= g[0] %>"><%= g[1] %></span></dt>
                    <dd class="mb-1"><%= g[2] %></dd>
                  <% }) %>
                </dl>
              </details>
            </div>

            <%#
                The content being reported, separate from "Which page": the second is where
                the reporter was, the first is what a moderator has to open to act.
                Revealed by main.js when "Someone's behaviour or content" is chosen, and
                rendered open after a refused submit that chose it.
              -%>
              <div class="col-12" id="f-content-wrap" <%= values.issue_type === 'abuse' ? '' : 'hidden' %>>
                <label class="form-label" for="f-content">Link to the content you are reporting <span aria-hidden="true">*</span></label>
                <input class="form-control<%= fieldErrors.content_url ? ' is-invalid' : '' %>" id="f-content" name="content_url" type="url" maxlength="500"
                       inputmode="url" aria-describedby="f-content-help<%= fieldErrors.content_url ? ' f-content-error' : '' %>" value="<%= values.content_url || '' %>"
                       <% if (fieldErrors.content_url) { %>aria-invalid="true"<% } %> placeholder="https://…">
                <% if (fieldErrors.content_url) { %><div class="invalid-feedback" id="f-content-error"><%= fieldErrors.content_url %></div><% } %>
                <p class="form-text" id="f-content-help">The post, reply, profile or job advert. A person reviews every report.</p>
              </div>

            <div class="col-12">
              <label class="form-label" for="f-page">Which page</label>
              <input class="form-control<%= fieldErrors.page_url ? ' is-invalid' : '' %>" id="f-page" name="page_url" type="url" maxlength="500"
                     inputmode="url" autocomplete="url" aria-describedby="f-page-help<%= fieldErrors.page_url ? ' f-page-error' : '' %>"
                     <% if (fieldErrors.page_url) { %>aria-invalid="true"<% } %>
                     value="<%= values.page_url || '' %>" placeholder="https://…">
              <% if (fieldErrors.page_url) { %><div class="invalid-feedback" id="f-page-error"><%= fieldErrors.page_url %></div><% } %>
              <p class="form-text" id="f-page-help">
                <span data-mode-text="pageHelp"><%= m.pageHelp %></span>
                It is the difference between a report we can act on and one that begins "it was the page with the table".
              </p>
            </div>
          </div>

          <%- include('../partials/enquiry-fields', { values, identityAbove: true }) %>

          <%#
            FAQ suggestions while the subject is typed. The questions come from config/faq.js,
            the same list the FAQ page renders its headings from; report-issue.js matches
            words and shows up to three. Nothing is sent anywhere to do it.
          -%>
          <div class="faq-suggest small mt-2" data-faq-suggest hidden aria-live="polite">
            <p class="mb-1 text-muted-2">This might already be answered:</p>
            <ul class="mb-0 ps-3" data-faq-suggest-list></ul>
          </div>
          <script type="application/json" id="faq-questions"><%- JSON.stringify(faqQuestions.map(function (f) { return { id: f.id, q: f.q, words: f.words }; })).replace(/</g, '\\u003c') %></script>

          <div class="mt-3">
            <label class="form-label" for="f-shots">Screenshots</label>
            <input class="form-control" id="f-shots" name="screenshots" type="file" multiple
                   accept="image/png,image/jpeg,image/webp,image/gif" aria-describedby="f-shots-help" data-screenshots
                   data-max-files="<%= maxFiles %>" data-max-mb="<%= maxFileMb %>">
            <p class="form-text" id="f-shots-help">
              Up to <%= maxFiles %> images, <%= maxFileMb %> MB each. You can also paste a screenshot straight into the
              message with <kbd>Ctrl</kbd>+<kbd>V</kbd> (<kbd>⌘</kbd>+<kbd>V</kbd> on a Mac).
            </p>
            <ul class="list-unstyled small mb-0 d-flex flex-wrap gap-2" data-screenshot-list aria-live="polite"></ul>
            <% if (fieldErrors.screenshots) { %><div class="text-danger small mt-1" id="f-shots-error"><%= fieldErrors.screenshots %></div><% } %>
          </div>

          <%#
            Optional, unticked by default, and stated in the Privacy policy. The line is read
            from the browser by report-issue.js only when the box is ticked, and shown before
            it is sent, so nobody sends something they have not seen.
          -%>
          <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="f-env" name="include_env" data-env-toggle
                   <%= values.include_env === 'on' ? 'checked' : '' %>>
            <label class="form-check-label" for="f-env">Include my browser and device details (helps us reproduce it)</label>
            <input type="hidden" name="env_info" value="<%= values.env_info || '' %>" data-env-info>
            <p class="form-text mb-0" data-env-preview></p>
          </div>

          <%# Only ever read for an idea (routes/index.js), so the box can stay in the form. -%>
            <div class="form-check mt-2" data-mode-only="idea" <%= isIdea ? '' : 'hidden' %>>
              <input class="form-check-input" type="checkbox" id="f-publish" name="publish_consent"
                     <%= values.publish_consent === 'on' ? 'checked' : '' %>>
              <label class="form-check-label" for="f-publish">
                You may publish this idea on the <a href="/ideas">ideas page</a> for others to vote on — without my name.
              </label>
            </div>

          <button class="btn btn-primary mt-3" type="submit" data-mode-text="submit"><%= m.submit %></button>
          <p class="small text-muted-2 mt-2 mb-0">
            We use your name and email only to reply to this <span data-mode-text="noun"><%= m.noun %></span>. What we keep and for how
            long is in the <a href="/legal/privacy#reports">Privacy policy</a>.
          </p>
        </form>
      </div></div>
    </div>

    <aside class="col-lg-4">
      <div class="glass-card mb-4"><div class="card-body">
        <div data-mode-only="idea" <%= isIdea ? '' : 'hidden' %>>
          <h2 class="h6"><i class="bi bi-lightbulb me-1" aria-hidden="true"></i>Tips for sharing an idea</h2>
          <ul class="small mb-0 ps-3">
            <li><strong>The benefit.</strong> What would be easier, faster or possible that is not today?</li>
            <li><strong>The use case.</strong> Who would use it, and when — "when I post a role I want to…"</li>
            <li><strong>An example.</strong> Another site that does it well, or a screenshot of where it would go.</li>
            <li><strong>The priority.</strong> Honest is more useful than high: it is how we decide what comes first.</li>
          </ul>
          <p class="small mt-3 mb-0"><a href="/ideas">See the ideas others shared, and vote</a></p>
        </div>
        <div data-mode-only="problem" <%= isIdea ? 'hidden' : '' %>>
          <h2 class="h6"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>Tips for reporting</h2>
          <ul class="small mb-0 ps-3">
            <li><strong>Be specific.</strong> Which button, which field, which message.</li>
            <li><strong>Give the steps.</strong> What you did, in order, so we can do it too.</li>
            <li><strong>Add a screenshot.</strong> Paste it into the message or attach it below.</li>
            <li><strong>Say which browser</strong> and device you were using.</li>
            <li><strong>Expected and actual.</strong> What you expected to happen, and what happened instead.</li>
          </ul>
        </div>
      </div></div>

      <div class="glass-card mb-4 d-none d-lg-block"><div class="card-body" id="severity-guide">
        <h2 class="h6" data-mode-text="guideHeading"><%= m.guideHeading %></h2>
        <dl class="small mb-0" data-mode-guide>
          <% m.guide.forEach(function (g) { %>
            <dt><span class="badge <%= g[0] %>"><%= g[1] %></span></dt>
            <dd class="mb-2"><%= g[2] %></dd>
          <% }) %>
        </dl>
      </div></div>

      <div class="glass-card"><div class="card-body">
        <h2 class="h6">What happens to it</h2>
        <% if (currentUser) { %>
          <p class="small mb-2"><i class="bi bi-person-check me-1" aria-hidden="true"></i>You are signed in, so this is linked to your account and appears in <a href="/report-issue/mine">My reports</a> with its status.</p>
        <% } %>
        <p class="small mb-0 text-muted-2">
          It goes into a queue a person works through, and the reply comes to the address you
          gave. If it is about your account we may need you to confirm something from the
          address the account uses — nothing here can look you up from a name. A security
          problem is welcome and is read first; please describe it rather than demonstrating
          it against somebody else's data.
        </p>
      </div></div>
    </aside>
  </div>
</div>
</section>
<script src="/js/report-issue.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" defer></script>
<%- include('../partials/layout-end') %>
