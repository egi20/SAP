<%- include('../partials/layout-start') %>
<%- include('../partials/page-header', {
  icon: 'bi-file-earmark-person',
  label: 'CV GENERATOR',
  heading: 'Your SAP CV, straight from your profile',
  sub: 'A Word document built from what you already filled in — your engagements, the modules each one touched, your certifications. Free.'
}) %>
<%
  /*
   * A tool first and an argument second. What the visitor can DO comes first and differs by
   * who they are: a consultant downloads, a signed-in account without the consultant role
   * adds it with one button, a visitor creates an account. The format, the example and the
   * steps follow; what the builder refuses to do is a short paragraph at the end.
   */
  const isConsultant = currentUser && currentUser.isConsultant;
%>
<section class="glass-section pb-5">
<div class="container">
  <%- include('../partials/flash') %>

  <div class="row g-4 mb-4">
    <div class="col-lg-7">
      <div class="glass-card h-100"><div class="card-body">
        <% if (isConsultant && mine && mine.gaps) { %>
          <h2 class="h5 card-heading mb-3">Download your CV</h2>

          <% if (mine.gaps.length) { %>
            <%# Before the button: a CV is only as good as the profile behind it, and each gap is one field. -%>
            <div class="alert alert-warning small mb-3">
              <strong>Your profile is missing:</strong>
              <ul class="mb-1 mt-1">
                <% mine.gaps.forEach(function (g) { %><li><%= g %></li><% }); %>
              </ul>
              <a href="/profile/consultant">Fill them in on your profile</a> — the CV changes the moment you do.
            </div>
          <% } else { %>
            <p class="small text-success mb-3"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>Your profile has everything a CV needs.</p>
          <% } %>

          <%#
            One GET form, two destinations: the download and the preview read the same
            fields, so the file is exactly what the preview showed.
          -%>
          <form method="get" action="/profile/cv.docx">
            <%- include('../partials/cv-options', { options: mine.options, adverts: mine.adverts, jobSlug: '' }) %>
            <div class="d-flex flex-wrap gap-2">
              <button class="btn btn-primary" type="submit">
                <i class="bi bi-download me-1" aria-hidden="true"></i>Download my CV (.docx)
              </button>
              <button class="btn btn-outline-primary" type="submit" formaction="/profile/cv">Preview it first</button>
            </div>
          </form>

        <% } else if (isConsultant) { %>
          <h2 class="h5 card-heading mb-2">Start with your profile</h2>
          <p class="text-muted-2">Your CV is built from your consultant profile, and there is nothing in it yet.</p>
          <a class="btn btn-primary" href="/profile/consultant">Build my profile</a>

          <h3 class="h6 mt-4 mb-2">What you'll need</h3>
          <%# The same things cvGaps names, so this list and the "missing" list never disagree. -%>
          <ul class="small text-muted-2 mb-0 cv-need">
            <li>A headline and a short About section — they become the top of the CV</li>
            <li>At least one engagement, with the SAP modules it touched</li>
            <li>Your years of experience and your skills</li>
            <li>Your SAP certifications, if you hold any</li>
          </ul>

        <% } else if (currentUser) { %>
          <h2 class="h5 card-heading mb-2">Add the consultant role to get your CV</h2>
          <p class="text-muted-2">
            The CV is built from a consultant profile, and this account does not have one yet.
            Adding the role keeps everything you already have; your profile is then one page
            to fill in.
          </p>
          <form method="post" action="/profile/settings/roles">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="roles" value="consultant">
            <input type="hidden" name="redirectTo" value="/cv-generator">
            <button class="btn btn-primary" type="submit">
              <i class="bi bi-person-plus me-1" aria-hidden="true"></i>Add the consultant role
            </button>
          </form>

          <h3 class="h6 mt-4 mb-2">What you'll need</h3>
          <%# The same things cvGaps names, so this list and the "missing" list never disagree. -%>
          <ul class="small text-muted-2 mb-0 cv-need">
            <li>A headline and a short About section — they become the top of the CV</li>
            <li>At least one engagement, with the SAP modules it touched</li>
            <li>Your years of experience and your skills</li>
            <li>Your SAP certifications, if you hold any</li>
          </ul>

        <% } else { %>
          <h2 class="h5 card-heading mb-2">Get your SAP CV</h2>
          <p class="text-muted-2">
            Create a free account, fill in your consultant profile once, and download your CV
            whenever you need it — always up to date with the profile companies search.
          </p>
          <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" href="/auth/register">Create a free account</a>
            <a class="btn btn-outline-primary" href="/auth/login?redirect=%2Fcv-generator">Sign in</a>
          </div>

          <h3 class="h6 mt-4 mb-2">What you'll need</h3>
          <%# The same things cvGaps names, so this list and the "missing" list never disagree. -%>
          <ul class="small text-muted-2 mb-0 cv-need">
            <li>A headline and a short About section — they become the top of the CV</li>
            <li>At least one engagement, with the SAP modules it touched</li>
            <li>Your years of experience and your skills</li>
            <li>Your SAP certifications, if you hold any</li>
          </ul>
        <% } %>
      </div></div>
    </div>

    <div class="col-lg-5">
      <div class="glass-card h-100"><div class="card-body">
        <h2 class="h5 card-heading mb-3">What you get</h2>
        <ul class="list-unstyled mb-3 cv-facts">
          <li><i class="bi bi-file-earmark-word" aria-hidden="true"></i><span><strong>A Word document (.docx)</strong> — opens in Word, Google Docs and LibreOffice; save it as PDF from any of them.</span></li>
          <li><i class="bi bi-layout-text-sidebar-reverse" aria-hidden="true"></i><span><strong>One column</strong> of headings, paragraphs and bullets — readable by the software that screens CVs.</span></li>
          <li><i class="bi bi-arrows-collapse" aria-hidden="true"></i><span><strong>Full or short.</strong> Full carries everything on your profile; short keeps the last 10 years and says so on the page.</span></li>
          <li><i class="bi bi-eye-slash" aria-hidden="true"></i><span><strong>Your day rate and contact details are off</strong> unless you tick them.</span></li>
        </ul>
        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-outline-primary btn-sm" href="#example"><i class="bi bi-eye me-1" aria-hidden="true"></i>See an example</a>
          <a class="btn btn-outline-secondary btn-sm" href="/cv-generator/example.docx?<%= exampleView.query({}) %>"><i class="bi bi-download me-1" aria-hidden="true"></i>Download the example (.docx)</a>
        </div>
      </div></div>
    </div>
  </div>

  <h2 class="h4 mb-3">How it works</h2>
  <div class="row g-3 mb-5">
    <div class="col-md-4">
      <div class="glass-card h-100"><div class="card-body">
        <span class="step-number">1</span>
        <h3 class="h6 mt-2 mb-1">Complete your profile</h3>
        <p class="small text-muted-2 mb-0">Headline, About, your engagements with the modules each one touched, certifications and skills. You fill it in once — it is also what companies search.</p>
      </div></div>
    </div>
    <div class="col-md-4">
      <div class="glass-card h-100"><div class="card-body">
        <span class="step-number">2</span>
        <h3 class="h6 mt-2 mb-1">Choose an advert <span class="text-muted-2 fw-normal">(optional)</span></h3>
        <p class="small text-muted-2 mb-0">Pick a role you saved or applied to, or use "Build my CV for this role" on any open advert. The engagements that touched its modules move to the top.</p>
      </div></div>
    </div>
    <div class="col-md-4">
      <div class="glass-card h-100"><div class="card-body">
        <span class="step-number">3</span>
        <h3 class="h6 mt-2 mb-1">Download</h3>
        <p class="small text-muted-2 mb-0">Full or short, with or without your rate and contact details. It is built when you click, so it is always what your profile says right now.</p>
      </div></div>
    </div>
  </div>

  <h2 class="h4 mb-3">Built for SAP work</h2>
  <div class="row g-3 mb-5">
    <div class="col-md-4">
      <div class="glass-card h-100"><div class="card-body">
        <span class="icon-tile icon-tile-sm icon-blue mb-2"><i class="bi bi-diagram-3"></i></span>
        <h3 class="h6 mb-1">Modules and phases on every engagement</h3>
        <p class="small text-muted-2 mb-0">
          Each engagement shows the SAP modules it touched and the SAP Activate phase it ran
          in — the detail a general CV builder cannot ask for.
        </p>
      </div></div>
    </div>
    <div class="col-md-4">
      <div class="glass-card h-100"><div class="card-body">
        <span class="icon-tile icon-tile-sm icon-success mb-2"><i class="bi bi-sort-down"></i></span>
        <h3 class="h6 mb-1">Ordered for the role you want</h3>
        <p class="small text-muted-2 mb-0">
          Against an advert, the relevant engagements come first and are marked, and the
          document names the advert it was ordered for.
        </p>
      </div></div>
    </div>
    <div class="col-md-4">
      <div class="glass-card h-100"><div class="card-body">
        <span class="icon-tile icon-tile-sm icon-navyblue mb-2"><i class="bi bi-arrow-repeat"></i></span>
        <h3 class="h6 mb-1">Never out of date</h3>
        <p class="small text-muted-2 mb-0">
          There is no second copy to keep in step: edit your profile and the next CV you
          download already says so.
        </p>
      </div></div>
    </div>
  </div>

  <%#
    The example is the real renderer on a fictional consultant (config/cvExample.js), so it
    cannot show a layout the builder does not make.
  -%>
  <div id="example" class="mb-5">
    <h2 class="h4 mb-2">Example</h2>
    <%#
      The explanation sits OUTSIDE the document: inside, the example reads like a real CV,
      because that is what the visitor is deciding whether they want.
    -%>
    <p class="small text-muted-2 mb-3">
      A fictional consultant, rendered by the same builder your CV comes from. Every line is a
      field on their profile; the modules and the certification are labels from the SAP
      catalogue. Ordered against an advert, the engagements that touched its modules come
      first and are marked <span class="badge-hub ok">Relevant here</span>.
    </p>

    <%# Links, not a script: each toggle is a URL, and the download carries the same choice. -%>
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
      <div class="btn-group btn-group-sm" role="group" aria-label="Ordering">
        <a class="btn <%= exampleView.ordered ? 'btn-primary' : 'btn-outline-primary' %>" href="/cv-generator?<%= exampleView.query({ ordered: true }) %>#example" <%= exampleView.ordered ? 'aria-current="true"' : '' %>>Ordered for an advert</a>
        <a class="btn <%= !exampleView.ordered ? 'btn-primary' : 'btn-outline-primary' %>" href="/cv-generator?<%= exampleView.query({ ordered: false }) %>#example" <%= !exampleView.ordered ? 'aria-current="true"' : '' %>>No advert</a>
      </div>
      <div class="btn-group btn-group-sm" role="group" aria-label="Length">
        <a class="btn <%= exampleView.length === 'full' ? 'btn-primary' : 'btn-outline-primary' %>" href="/cv-generator?<%= exampleView.query({ length: 'full' }) %>#example" <%= exampleView.length === 'full' ? 'aria-current="true"' : '' %>>Full</a>
        <a class="btn <%= exampleView.length === 'short' ? 'btn-primary' : 'btn-outline-primary' %>" href="/cv-generator?<%= exampleView.query({ length: 'short' }) %>#example" <%= exampleView.length === 'short' ? 'aria-current="true"' : '' %>>Short (last 10 years)</a>
      </div>
      <a class="small ms-auto" href="/cv-generator/example.docx?<%= exampleView.query({}) %>"><i class="bi bi-download me-1" aria-hidden="true"></i>Download this version (.docx)</a>
    </div>

    <%- include('../partials/cv-preview', { cv: example, paper: true }) %>
  </div>

  <div class="glass-card"><div class="card-body">
    <h2 class="h6 mb-2">What it does not do</h2>
    <p class="small text-muted-2 mb-0">
      It writes nothing for you — no generated summary, no reworded bullets, and no cover
      letter. Every line is something you typed or a label from the SAP catalogue, because a
      CV is sent under your own name and you should be able to stand behind every sentence
      in the interview.
    </p>
  </div></div>
</div>
</section>
<%- include('../partials/layout-end') %>
