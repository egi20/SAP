<%- include('../partials/layout-start') %>
<%- include('../partials/page-header', { icon: 'bi-list-check', heading: 'My reports', sub: 'The problems and ideas you sent while signed in, and where each one stands.' }) %>
<section class="glass-section pb-5">
<div class="container">
  <div class="row justify-content-center"><div class="col-lg-9">
    <div class="glass-card"><div class="card-body">
      <% if (!reports.length) { %>
        <p class="mb-3">Nothing yet. Reports you send while signed in appear here with their status.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead><tr><th scope="col">Reference</th><th scope="col">Subject</th><th scope="col">Sent</th><th scope="col">Status</th></tr></thead>
            <tbody>
              <% reports.forEach(function (r) { %>
                <tr>
                  <td class="text-nowrap"><%= r.reference %></td>
                  <td>
                    <%= r.subject %>
                    <% if (String(r.issue_type).indexOf('idea_') === 0) { %><span class="badge text-bg-light border ms-1">idea</span><% } %>
                    <% if (r.published_at) { %><a class="small ms-1" href="/ideas#idea-<%= r.id %>">on the ideas page</a><% } %>
                  </td>
                  <td class="text-nowrap small"><%= new Date(r.created_at).toLocaleDateString('en-GB') %></td>
                  <td>
                    <span class="badge <%= r.status === 'closed' ? 'text-bg-secondary' : (r.status === 'open' ? 'text-bg-info' : 'text-bg-primary') %>"><%= r.statusLabel %></span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <p class="small text-muted-2 mt-3 mb-0">
        A report sent while signed out is not tied to any account, so it is not listed here — its
        reference is in the confirmation email. The reply to every report comes by email.
      </p>
      <a class="btn btn-primary mt-3" href="/report-issue">Report a problem</a>
      <a class="btn btn-outline-primary mt-3" href="/report-issue?mode=idea">Share an idea</a>
    </div></div>
  </div></div>
</div>
</section>
<%- include('../partials/layout-end') %>
