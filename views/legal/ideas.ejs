<%- include('../partials/layout-start') %>
<%- include('../partials/page-header', { icon: 'bi-lightbulb', heading: 'Ideas', sub: 'What members would like the site to do next. Vote for the ones you want too.' }) %>
<section class="glass-section pb-5">
<div class="container">
  <div class="row justify-content-center"><div class="col-lg-9">
    <%- include('../partials/flash') %>
    <%#
      Only ideas whose sender agreed to it AND an administrator published, through
      Enquiry.publicIdeaFilter. No names: an idea is shown for what it says, and the person
      who sent it did not sign up to be named in public by doing so.
    -%>
    <p class="mb-3"><a class="btn btn-primary" href="/report-issue?mode=idea"><i class="bi bi-lightbulb me-1" aria-hidden="true"></i>Share an idea</a></p>
    <% if (!ideas.length) { %>
      <div class="glass-card"><div class="card-body"><p class="mb-0">No ideas published yet. Be the first to share one.</p></div></div>
    <% } %>
    <% ideas.forEach(function (idea) { %>
      <article class="glass-card mb-3" id="idea-<%= idea.id %>"><div class="card-body d-flex gap-3">
        <div class="text-center flex-shrink-0">
          <% if (currentUser) { %>
            <form method="post" action="/ideas/<%= idea.id %>/vote">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm <%= idea.my_vote ? 'btn-primary' : 'btn-outline-primary' %>" type="submit"
                      aria-pressed="<%= idea.my_vote ? 'true' : 'false' %>"
                      aria-label="<%= idea.my_vote ? 'Take back your vote for' : 'Vote for' %>: <%= idea.subject %>">
                <i class="bi bi-hand-thumbs-up" aria-hidden="true"></i>
              </button>
            </form>
          <% } else { %>
            <a class="btn btn-sm btn-outline-primary" href="/auth/login?redirect=/ideas" aria-label="Sign in to vote"><i class="bi bi-hand-thumbs-up" aria-hidden="true"></i></a>
          <% } %>
          <div class="fw-semibold mt-1"><%= idea.votes %></div>
          <div class="small text-muted-2"><%= idea.votes === 1 ? 'vote' : 'votes' %></div>
        </div>
        <div class="flex-grow-1">
          <h2 class="h6 mb-1"><%= idea.subject %></h2>
          <p class="message-body small mb-2"><%= idea.body %></p>
          <span class="badge <%= idea.status === 'closed' ? 'text-bg-secondary' : 'text-bg-info' %>"><%= idea.status === 'closed' ? 'Closed' : 'Under consideration' %></span>
        </div>
      </div></article>
    <% }) %>
  </div></div>
</div>
</section>
<%- include('../partials/layout-end') %>
