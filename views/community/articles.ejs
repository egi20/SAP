<%- include('../partials/layout-start') %>
<%- include('../partials/page-header', {
  icon: 'bi-file-earmark-text',
  heading: 'Articles',
  sub: 'Things members worked out and wrote up properly.'
}) %>
<section class="glass-section pb-5">
<div class="container">

  <nav aria-label="Breadcrumb" class="mb-3">
    <ol class="breadcrumb small mb-0">
      <li class="breadcrumb-item"><a href="/community">Community</a></li>
      <li class="breadcrumb-item active" aria-current="page">Articles</li>
    </ol>
  </nav>

  <%#
    A GET form, like every other filter on the site, so a filtered list is a URL somebody
    can send. `kind` is not among the controls: it is what this page IS, and a control that
    could clear it would move the reader off the page they opened.
  %>
  <form class="glass-card mb-4" method="get" action="/community/articles">
    <div class="card-body">
      <div class="row g-3 align-items-end">
        <div class="col-md-4">
          <label class="form-label" for="f-q">Search articles</label>
          <input class="form-control" id="f-q" name="q" value="<%= filters.q %>"
                 maxlength="120" placeholder="Clean core, cutover, migration…">
        </div>
        <div class="col-md-3">
          <label class="form-label" for="f-cat">Category</label>
          <select class="form-select" id="f-cat" name="category">
            <option value="">All categories</option>
            <% categories.forEach(function (c) { %>
              <option value="<%= c.slug %>" <%= filters.category_slug === c.slug ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label" for="f-author">Author</label>
          <select class="form-select" id="f-author" name="author">
            <option value="">All authors</option>
            <% authors.forEach(function (a) { %>
              <option value="<%= a.id %>" <%= authorId === a.id ? 'selected' : '' %>><%= a.name %> (<%= a.count %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="f-sort">Sort</label>
          <select class="form-select" id="f-sort" name="sort">
            <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest</option>
            <option value="top" <%= sort === 'top' ? 'selected' : '' %>>Top voted</option>
            <option value="busiest" <%= sort === 'busiest' ? 'selected' : '' %>>Most discussed</option>
            <option value="recent" <%= sort === 'recent' ? 'selected' : '' %>>Recently active</option>
          </select>
        </div>
        <div class="col-12 d-flex gap-2">
          <button class="btn btn-primary" type="submit">Apply</button>
          <a class="btn btn-outline-secondary" href="/community/articles">Clear all</a>
        </div>
      </div>
    </div>
  </form>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <p class="text-muted-2 mb-0">
      <strong><%= total %></strong> article<%= total === 1 ? '' : 's' %>
    </p>
    <% if (currentUser) { %>
      <a class="btn btn-sm btn-navy" href="/community/new?kind=article">
        <i class="bi bi-pencil"></i> Write an article
      </a>
    <% } else { %>
      <a class="btn btn-sm btn-navy" href="/auth/register">Write one yourself</a>
    <% } %>
  </div>

  <% if (posts.length === 0) { %>
    <div class="empty-state glass-card">
      <i class="bi bi-file-earmark-text"></i>
      <p class="mb-1">No articles match that.</p>
      <p class="small mb-0">Try clearing a filter, or <a href="/community">browse everything</a>.</p>
    </div>
  <% } else { %>
    <% posts.forEach(function (post) { %>
      <%- include('../partials/post-card', { post: post }) %>
    <% }) %>
    <%- include('../partials/pagination') %>
  <% } %>

</div>
</section>
<%- include('../partials/layout-end') %>
