# Copy to .env and fill in. Nothing here is read at build time; everything is read at boot.

# --- Application -------------------------------------------------------------
NODE_ENV=development
APP_NAME=SAP Hub
PORT=3000
APP_BASE_URL=http://localhost:3000
SUPPORT_EMAIL=support@example.com

# --- Database ----------------------------------------------------------------
# SAP Hub owns its schema and cannot share a database with another application:
# scripts/migrate.js refuses to run into a database that has tables but no migration
# history, because that means DB_NAME is pointing somewhere else.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sap_hub
DB_CONNECTION_LIMIT=10

# --- Session -----------------------------------------------------------------
# REQUIRED in production, and the process refuses to start without a non-default value.
# A default-signed session cookie in production is a full account-takeover primitive.
SESSION_SECRET=change-me-in-production

# Cost of a bcrypt hash. Defaults to 12 in production, 10 elsewhere.
# BCRYPT_ROUNDS=12

# --- Email -------------------------------------------------------------------
# Unset: messages are logged instead of sent, and every caller treats email as
# fire-and-forget, so local development and CI work without credentials.
RESEND_API_KEY=
EMAIL_FROM=SAP Hub <noreply@example.com>

# --- Payments ----------------------------------------------------------------
# All three unset disables payments entirely: no checkout can be created and the routes
# answer "not available". That is deliberate — a half-configured payment path fails after
# somebody has entered a card number.
#
# The webhook secret is what makes the webhook trustworthy: it verifies Stripe's signature
# over the RAW body, which is why server.js mounts a raw parser on that one path before
# any JSON parser sees it.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Rate index --------------------------------------------------------------
# The privacy floor: no aggregate derived from fewer than this many DISTINCT PEOPLE is
# ever published. An environment variable rather than an editable setting, precisely so
# that lowering it is a deployment decision with a diff behind it. Below 3 defeats the
# point of having it.
RATE_MIN_SAMPLE=3

# --- Uploads -----------------------------------------------------------------
# Scratch only. Durable bytes live in MySQL, because the host filesystem is wiped on
# every deploy.
UPLOAD_TMP_DIR=uploads

# --- The in-site assistant ----------------------------------------------------
#
# Unset ANTHROPIC_API_KEY disables the feature entirely: the widget is not rendered
# and the endpoint answers 503. That is what keeps local development, CI and
# `npm run validate-boot` working without credentials.
ANTHROPIC_API_KEY=

# The model, and the prices the spend cap is computed from. THESE MOVE TOGETHER: a
# model changed here without changing the two prices makes the circuit-breaker cut
# off early or late, and nothing else in the system knows what a call costs. Both
# are per MILLION tokens, in USD. /admin/ai prints all three side by side.
ASSISTANT_MODEL=claude-opus-5
ASSISTANT_PRICE_INPUT_USD=5
ASSISTANT_PRICE_OUTPUT_USD=25

# How hard the model works on one answer: low, medium, high, xhigh or max. This is
# site navigation help, so low. Lowering effort is the way to spend less; turning
# thinking off is not, and is not offered.
ASSISTANT_EFFORT=low

# Spend caps, month to date, in USD. 0 disables a cap. The global one is the only
# thing standing between a distributed flood and an unbounded invoice.
AI_MONTHLY_BUDGET_USD=25
AI_USER_MONTHLY_BUDGET_USD=2

# --- LinkedIn confirmation ----------------------------------------------------
#
# LINKING ONLY, never a sign-in method. Both unset disables the feature: the button
# is not rendered and the routes say so plainly. Setting one without the other is
# refused at boot — a half-configured OAuth flow fails after the member has already
# granted access, which is the worst moment for it.
#
# The registered redirect URI must be exactly ${APP_BASE_URL}/linkedin/callback.
# Scopes requested: openid profile email. Not w_member_social — asking for the
# ability to post as somebody, in order to check who they are, is a much larger
# permission than the task needs.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
