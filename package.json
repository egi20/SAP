{
  "name": "sap-hub",
  "version": "0.1.0",
  "description": "SAP Hub \u2014 marketplace, job board and rate index for the SAP consulting ecosystem",
  "main": "server.js",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "npm run migrate && npm run sync:catalogues && node server.js",
    "dev": "nodemon server.js",
    "db:create": "node scripts/create-database.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:status": "node scripts/migrate.js status",
    "sync:catalogues": "node scripts/sync-catalogues.js",
    "create-admin": "node scripts/create-admin.js",
    "wait-for-db": "node scripts/wait-for-db.js",
    "validate-boot": "node scripts/validate-boot.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "setup": "npm run db:create && npm run migrate && npm run sync:catalogues"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "geoip-lite": "^2.0.3",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "mysql2": "^3.24.4",
    "resend": "^6.9.2",
    "sanitize-html": "^2.17.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "routes/**/*.js",
      "models/**/*.js",
      "utils/**/*.js",
      "middleware/**/*.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "globalSetup": "<rootDir>/tests/globalSetup.js"
  },
  "overrides": {
    "htmlparser2": "^9.1.0",
    "mysql2": "^3.24.4"
  }
}
